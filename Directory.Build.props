<Project>
  <PropertyGroup>
    <ConfigurationKey Condition="'$(Configuration)'=='Debug'">Development</ConfigurationKey>
    <ConfigurationKey Condition="$(Configuration.Contains('Release'))">Production</ConfigurationKey>

    <NodeFolderName>$(Configuration)</NodeFolderName>

  </PropertyGroup>

  <!--
    Node builds: one program folder per node GROUP, a node home per node inside it.

      bin\<platform>\Tracker\ProcessorApplication\       program files, shared by Tracker1 and Tracker2
      bin\<platform>\Tracker\nodes\Tracker1\             Tracker1's own databases, Module_Data and settings files
      bin\<platform>\Tracker\nodes\Tracker2\
      bin\<platform>\Client\ProcessorApplication\        same for Client1 / Client2
      bin\<platform>\Client\nodes\Client1\ ...
      bin\<platform>\TrackerSwarm\ProcessorApplication\  swarm program files
      bin\<platform>\TrackerSwarm\nodes\_template\       the swarm template node (set it up once, e.g. create the admin user)
      bin\<platform>\TrackerSwarm\nodes\swarm-001\ ...   copies of the template, made by Build\setup-swarm-homes.ps1

    NodeTracker1Debug and NodeTracker2Debug build the same Tracker program folder; each one seeds its own
    node home (NodeHome, see SeedNodeHome below):
      - project configFiles\(node)\**  copied to nodes\(node)\  (only files the node does not have yet)
      - project appsettings.(module).Node(node)Debug.json copied to nodes\(node)\ or nodes\(node)\Modules\(Module)\  (kept up to date)
    A node is started with the program arguments  node-home ..\nodes\Tracker1  and  environment NodeTracker1Debug
    (both with two leading dashes; Build\run-test-nodes.ps1 and the Visual Studio launch profiles pass them).
    Note: an XML comment may not contain two dashes in a row, so they are not written out here.
  -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Node'))">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ConfigurationKey>$(Configuration)</ConfigurationKey>
    <!-- appsettings.(module).(configuration).json of the node go into its home, not the shared program folder -->
    <NodeSettingsInHome>true</NodeSettingsInHome>

    <!--platform specification, comment out if needed-->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'NodeTracker1Debug'">
    <NodeFolderName>Tracker</NodeFolderName>
    <NodeHome>Tracker1</NodeHome>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'NodeTracker2Debug'">
    <NodeFolderName>Tracker</NodeFolderName>
    <NodeHome>Tracker2</NodeHome>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'NodeClient1Debug'">
    <NodeFolderName>Client</NodeFolderName>
    <NodeHome>Client1</NodeHome>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)' == 'NodeClient2Debug'">
    <NodeFolderName>Client</NodeFolderName>
    <NodeHome>Client2</NodeHome>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'NodeTrackerSwarm'">
    <NodeFolderName>TrackerSwarm</NodeFolderName>
    <!-- the build seeds only the template home (presets from configFiles\TrackerSwarm); Build\setup-swarm-homes.ps1 copies it -->
    <NodeHome>_template</NodeHome>
    <NodePresetName>TrackerSwarm</NodePresetName>
    <!-- appsettings.(module).NodeTrackerSwarm.json are shared by every swarm node: they stay in the program folder -->
    <NodeSettingsInHome>false</NodeSettingsInHome>
  </PropertyGroup>

  <!-- after the per-configuration groups: needs NodeFolderName and RuntimeIdentifier -->
  <PropertyGroup Condition="$(Configuration.StartsWith('Node'))">
    <!--
      Configurations of one group (NodeClient1Debug / NodeClient2Debug, the two trackers) build the same program
      folder. They share one intermediate folder and leave the configuration name out of the assembly, so building
      the second configuration compiles nothing and copies nothing (files unchanged): a node of the group can keep
      running while Visual Studio builds the other one before starting it. Each build still seeds its own node home.
      Visual Studio's own up-to-date shortcut is off so that seeding always runs.
    -->
    <IntermediateOutputPath>obj\$(NodeFolderName)\$(RuntimeIdentifier)\</IntermediateOutputPath>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <PropertyGroup>
    <BaseOutputFolder>$(SolutionDir)bin\$(RuntimeIdentifier)\$(NodeFolderName)</BaseOutputFolder>
    <OutputPath>$(BaseOutputFolder)\$(MSBuildProjectName)\</OutputPath>
    
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    
    <!--razor view-->
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
    <MvcRazorCompileOnPublish>false</MvcRazorCompileOnPublish>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <!--translations-->
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    Self-contained: when a platform (RuntimeIdentifier) is set, the host carries the .NET runtime and every
    shared library; modules are plain libraries that ship only their own files and use the host's copies.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'ProcessorApplication' And '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\Modules\')) or $(MSBuildProjectDirectory.Contains('/Modules/'))">
    <SelfContained>false</SelfContained>
    <!-- modules reference the host (an executable) only to compile against it -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  
  <!--Apply to all projects-->
  <ItemGroup>
    <Content Include="Views\**\*.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Areas\**\*.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Pages\**\*.cshtml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />

    <Content Include="$(ProjectDir)appsettings.json"  CopyToOutputDirectory="PreserveNewest"
             Condition="Exists('$(ProjectDir)appsettings.json')" />
    <!-- node-specific files (configurations with node homes) are copied into each node home by SeedNodeHome instead -->
    <Content Include="$(ProjectDir)appsettings.$(ConfigurationKey).json" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(NodeSettingsInHome)' != 'true' AND '$(ConfigurationKey)' != '' AND Exists('$(ProjectDir)appsettings.$(ConfigurationKey).json')" />


    <Content Include="$(ProjectDir)appsettings.$(ModuleKey).json" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(ModuleKey)' != '' AND Exists('$(ProjectDir)appsettings.$(ModuleKey).json')" />
    <Content Include="$(ProjectDir)appsettings.$(ModuleKey).$(ConfigurationKey).json" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(NodeSettingsInHome)' != 'true' AND '$(ModuleKey)'  != '' AND '$(ConfigurationKey)' != '' AND Exists('$(ProjectDir)appsettings.$(ModuleKey).$(ConfigurationKey).json')" />

  </ItemGroup>

  <ItemDefinitionGroup Condition="$(MSBuildProjectDirectory.Contains('\Modules\')) or $(MSBuildProjectDirectory.Contains('/Modules/'))">
    <ProjectReference>
      <Private>False</Private>
      <ExcludeAssets>runtime;native</ExcludeAssets>
      <CopyLocalSatelliteAssemblies>False</CopyLocalSatelliteAssemblies>
    </ProjectReference>
  </ItemDefinitionGroup>
  
  <ItemGroup>
    <None Remove="configFiles\**\*" />
    <Content Remove="configFiles\**\*" />
    
    <None Include="$(MSBuildProjectDirectory)\configFiles\$(NodeFolderName)\**\*">
      <Link>ActiveNodeConfig\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- single-node layout (Debug/Release: the app folder is the node's folder) -->
  <Target Name="ForceDeployNodeConfigFiles" AfterTargets="Build"
          Condition="'$(NodeHome)' == '' AND Exists('$(MSBuildProjectDirectory)\configFiles\$(NodeFolderName)')">

    <!--
      Presets seed a NEW node folder only: a file is copied when the node doesn't have it yet, so a rebuild never
      overwrites the node's live database (settings), P2P identity or other state with the preset again.
      SQLite -wal/-shm presets are copied only together with a missing database (a stale -wal next to a live
      database would corrupt it). To re-apply presets on purpose: delete the files, or run-test-nodes.ps1 -Fresh.
    -->
    <ItemGroup>
      <_ActiveConfigFiles Include="$(MSBuildProjectDirectory)\configFiles\$(NodeFolderName)\**\*">
        <Dest>$(BaseOutputFolder)\ProcessorApplication\%(RecursiveDir)%(Filename)%(Extension)</Dest>
      </_ActiveConfigFiles>
      <_ActiveConfigFiles>
        <DbDest>$([System.Text.RegularExpressions.Regex]::Replace('%(Dest)', '-(wal|shm)$', ''))</DbDest>
      </_ActiveConfigFiles>
      <_NewConfigFiles Include="@(_ActiveConfigFiles)" Condition="!Exists('%(Dest)') And !Exists('%(DbDest)')" />
      <_KeptConfigFiles Include="@(_ActiveConfigFiles)" Exclude="@(_NewConfigFiles)" />
    </ItemGroup>

    <Message Importance="high" Condition="'@(_NewConfigFiles)' != ''"
             Text="[P2P Deployment] Seeding new node folder from configFiles ($(MSBuildProjectName)): @(_NewConfigFiles->'%(RecursiveDir)%(Filename)%(Extension)', ', ')" />
    <Message Importance="normal" Condition="'@(_KeptConfigFiles)' != ''"
             Text="[P2P Deployment] Kept the node's own copies (preset not applied): @(_KeptConfigFiles->'%(RecursiveDir)%(Filename)%(Extension)', ', ')" />

    <Copy SourceFiles="@(_NewConfigFiles)"
          DestinationFiles="@(_NewConfigFiles->'%(Dest)')"
          OverwriteReadOnlyFiles="true" />
  </Target>
  
  <!--
    Seeds this build's node home (NodeHome above):
      1. presets  (project)\configFiles\(NodePresetName, default the home's name)\**  -> (group)\nodes\(NodeHome)\,
         only files the node doesn't have yet, so a rebuild never overwrites a node's live database, P2P identity
         or keys. SQLite -wal/-shm presets go only together with a missing database (a stale -wal next to a live
         database would corrupt it).
      2. if NodeSettingsInHome: (project)\appsettings.(ModuleKey).(Configuration).json -> the same place inside the
         node home as in the program folder (main: the home root; a module: Modules\(Module)\). Updated whenever
         the project's file changes - the project's file is the source; settings re-ingest applies it to the node.
  -->
  <UsingTask TaskName="SeedNodeHome" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ProjectDir ParameterType="System.String" Required="true" />
      <HomeDir ParameterType="System.String" Required="true" />
      <PresetName ParameterType="System.String" Required="true" />
      <SettingsFile ParameterType="System.String" />
      <SettingsSubDir ParameterType="System.String" />
      <ProjectName ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          Directory.CreateDirectory(HomeDir);
          string homeName = Path.GetFileName(HomeDir.TrimEnd('\\', '/'));

          // 1. presets: decide everything before copying anything (a database copied in this run must not
          //    make its own -wal look like "database already there")
          string presetRoot = Path.Combine(ProjectDir, "configFiles", PresetName);
          if (Directory.Exists(presetRoot))
          {
              var copies = new List<KeyValuePair<string, string>>();
              foreach (var src in Directory.GetFiles(presetRoot, "*", SearchOption.AllDirectories))
              {
                  string rel = src.Substring(presetRoot.Length).TrimStart('\\', '/');
                  string dest = Path.Combine(HomeDir, rel);
                  if (File.Exists(dest)) continue;
                  string db = System.Text.RegularExpressions.Regex.Replace(dest, "-(wal|shm)$", "");
                  if (db != dest && File.Exists(db)) continue;
                  copies.Add(new KeyValuePair<string, string>(src, dest));
              }
              foreach (var c in copies)
              {
                  Directory.CreateDirectory(Path.GetDirectoryName(c.Value));
                  File.Copy(c.Key, c.Value, false);
              }
              if (copies.Count > 0)
                  Log.LogMessage(MessageImportance.High, "[Node home] " + homeName + ": seeded " + copies.Count + " preset file(s) from " + ProjectName + "\\configFiles\\" + PresetName);
          }

          // 2. this node's settings file
          if (!string.IsNullOrEmpty(SettingsFile))
          {
              string settingsSrc = Path.Combine(ProjectDir, SettingsFile);
              if (File.Exists(settingsSrc))
              {
                  string destDir = string.IsNullOrEmpty(SettingsSubDir) ? HomeDir : Path.Combine(HomeDir, SettingsSubDir);
                  string settingsDest = Path.Combine(destDir, SettingsFile);
                  bool same = File.Exists(settingsDest) && File.ReadAllBytes(settingsDest).SequenceEqual(File.ReadAllBytes(settingsSrc));
                  if (!same)
                  {
                      Directory.CreateDirectory(destDir);
                      File.Copy(settingsSrc, settingsDest, true);
                      Log.LogMessage(MessageImportance.High, "[Node home] " + homeName + ": settings " + Path.Combine(SettingsSubDir ?? "", SettingsFile));
                  }
              }
          }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="SeedNodeHome" AfterTargets="Build" Condition="'$(NodeHome)' != '' AND '$(ModuleKey)' != ''">
    <PropertyGroup>
      <_IsModuleProject>false</_IsModuleProject>
      <_IsModuleProject Condition="$(MSBuildProjectDirectory.Contains('\Modules\')) or $(MSBuildProjectDirectory.Contains('/Modules/'))">true</_IsModuleProject>
      <_NodeSettingsSubDir></_NodeSettingsSubDir>
      <_NodeSettingsSubDir Condition="'$(_IsModuleProject)' == 'true'">Modules\$(MSBuildProjectName)</_NodeSettingsSubDir>
      <_NodeSettingsFile></_NodeSettingsFile>
      <_NodeSettingsFile Condition="'$(NodeSettingsInHome)' == 'true'">appsettings.$(ModuleKey).$(ConfigurationKey).json</_NodeSettingsFile>
      <_NodePresetName>$(NodePresetName)</_NodePresetName>
      <_NodePresetName Condition="'$(_NodePresetName)' == ''">$(NodeHome)</_NodePresetName>
    </PropertyGroup>
    <SeedNodeHome ProjectDir="$(MSBuildProjectDirectory)"
                  HomeDir="$(BaseOutputFolder)\nodes\$(NodeHome)"
                  PresetName="$(_NodePresetName)"
                  SettingsFile="$(_NodeSettingsFile)"
                  SettingsSubDir="$(_NodeSettingsSubDir)"
                  ProjectName="$(MSBuildProjectName)" />
  </Target>

</Project>