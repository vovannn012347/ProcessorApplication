<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- 
    FILE: /Modules/Directory.Build.targets
    This file is automatically imported by any project located in the /Modules directory.
  -->
  <PropertyGroup>
    <!--samples from global build file-->
    <!--
    <BaseOutputFolder>$(SolutionDir)bin\$(NodeFolderName)</BaseOutputFolder>
    <OutputPath>$(BaseOutputFolder)\$(MSBuildProjectName)\</OutputPath>
    -->

    <MainProjectBinRoot>$(BaseOutputFolder)\ProcessorApplication\</MainProjectBinRoot>
    <TargetModuleFolder>$(MainProjectBinRoot)Modules\$(ProjectName)\</TargetModuleFolder>
  </PropertyGroup>

  <!--
    Libraries the main application ships (HostProvidedPackage in Directory.Packages.props): a module
    compiles against them but never copies them, so it uses the main application's single copy at runtime.
    Applies to the module's own PackageReference items (imported after the .csproj, so Update sees them);
    packages that arrive through a ProjectReference are already excluded in Directory.Build.props.
  -->
  <ItemGroup>
    <PackageReference Update="@(HostProvidedPackage)" ExcludeAssets="runtime;native" />
  </ItemGroup>

  <!--
    Finds literal duplicates of this module's own build output from TWO sources together - neither
    one alone is enough:

    1. {ModuleKey}.manifest.foreign-refs.txt - a "{filename}|{size in bytes}" list pre-computed by
       Build/ModuleManifest.targets's GenerateModuleManifest target (runs first - see this target's
       AfterTargets below) from ReferenceSourceTarget == 'ProjectReference' entries in
       @(ReferencePath). This only ever lists the referenced PROJECTS themselves (P2PModule.dll,
       ProcessorApplication.dll) - MSBuild tags a NuGet package as 'ResolveAssemblyReference' even
       when it only reached this project TRANSITIVELY through one of those project references, so
       e.g. BouncyCastle.Crypto.dll (pulled in through P2PModule's own SIPSorcery dependency) never
       appears here at all, no matter how this list is computed from @(ReferencePath) metadata.

    2. Scanning $(MainProjectBinRoot) and $(MainProjectBinRoot)Modules\ for files that are already
       there. This is what actually catches a transitive package like BouncyCastle.Crypto: the
       module that genuinely owns that NuGet dependency (P2PModule) already deployed its own copy
       of it into Modules\P2PModule\ by the time this runs (project build order via ProjectReference
       guarantees a module this one depends on has already built AND deployed first) - so by
       definition, if a file we're about to deploy already exists somewhere in that tree with the
       same name and size, something else already provides it and copying our own copy too would
       just be the duplicate this whole thing exists to prevent.

    "Literal duplicate" = same file name AND same file size, not name alone - matching by name only
    would (and did - this is why it needed fixing) treat any two same-named-but-different files as
    interchangeable, which is wrong, and would equally mis-skip genuinely different files that just
    happen to share a name. Deliberately NOT content-hash-based: name+size is cheap, needs no extra
    dependency, and is already precise enough in practice for compiled assemblies (two different
    DLLs sharing both name and exact byte size is not a realistic accident).
  -->
  <UsingTask TaskName="FindDuplicateFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CandidateFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ExclusionListFile ParameterType="System.String" Required="true" />
      <SearchRoots ParameterType="System.String[]" Required="true" />
      <TargetDir ParameterType="System.String" Required="true" />
      <OwnDeployFolder ParameterType="System.String" Required="true" />
      <DuplicateFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Linq" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          // Relative path (inside its folder) -> every size seen there. Matching on the relative path, not the
          // bare file name: runtimes\win-x64\native\e_sqlite3.dll and runtimes\linux-x64\native\e_sqlite3.dll
          // are different files with the same name, and a name-only key let one "win" and the rest slip through.
          var known = new Dictionary<string, HashSet<long>>(StringComparer.OrdinalIgnoreCase);
          Action<string, long> add = (rel, size) =>
          {
              rel = rel.Replace('/', '\\');
              if (!known.TryGetValue(rel, out var sizes)) known[rel] = sizes = new HashSet<long>();
              sizes.Add(size);
          };
          // Big or irrelevant folders under the host root: node data (downloads!), static web files, other modules.
          var skipTop = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Module_Data", "wwwroot", "Modules", "logs" };

          // Source 1: the pre-computed project-reference list (files that sit at the output root).
          if (File.Exists(ExclusionListFile))
          {
              foreach (var line in File.ReadAllLines(ExclusionListFile))
              {
                  var parts = line.Split('|');
                  if (parts.Length != 2) continue;
                  if (long.TryParse(parts[1], out var size)) add(parts[0], size);
              }
          }

          // Source 2: what is already deployed. SearchRoots[0] = host output root (paths relative to it),
          // SearchRoots[1] = the Modules folder (paths relative to each module's own folder).
          for (int r = 0; r < SearchRoots.Length; r++)
          {
              var root = SearchRoots[r];
              if (string.IsNullOrEmpty(root) || !Directory.Exists(root)) continue;
              var bases = r == 0 ? new[] { root } : Directory.GetDirectories(root);
              // This module's OWN previous deployment never counts as "provided by someone else": with it
              // included, a rebuilt DLL that happened to keep the same byte size was treated as a duplicate
              // of its old self and never redeployed (stale code kept running).
              var own = string.IsNullOrEmpty(OwnDeployFolder) ? "" : Path.GetFullPath(OwnDeployFolder).TrimEnd('\\', '/');
              foreach (var baseDir in bases)
              {
                  if (r == 1 && string.Equals(Path.GetFullPath(baseDir).TrimEnd('\\', '/'), own, StringComparison.OrdinalIgnoreCase)) continue;
                  var basePath = Path.GetFullPath(baseDir).TrimEnd('\\', '/') + Path.DirectorySeparatorChar;
                  var stack = new Stack<string>();
                  stack.Push(basePath);
                  while (stack.Count > 0)
                  {
                      var dir = stack.Pop();
                      foreach (var file in Directory.GetFiles(dir))
                          add(file.Substring(basePath.Length), new FileInfo(file).Length);
                      foreach (var sub in Directory.GetDirectories(dir))
                      {
                          if (r == 0 && dir == basePath && skipTop.Contains(Path.GetFileName(sub))) continue;
                          stack.Push(sub);
                      }
                  }
              }
          }

          var targetRoot = TargetDir == null ? "" : Path.GetFullPath(TargetDir).TrimEnd('\\', '/') + Path.DirectorySeparatorChar;
          var dupes = new List<ITaskItem>();
          foreach (var item in CandidateFiles)
          {
              var path = item.GetMetadata("FullPath");
              if (!File.Exists(path)) continue;

              var rel = path.StartsWith(targetRoot, StringComparison.OrdinalIgnoreCase) ? path.Substring(targetRoot.Length) : Path.GetFileName(path);
              if (known.TryGetValue(rel.Replace('/', '\\'), out var sizes) && sizes.Contains(new FileInfo(path).Length))
              {
                  dupes.Add(item);
              }
          }

          DuplicateFiles = dupes.ToArray();
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="StripParentDuplicatesAndDeploy" AfterTargets="Build;GenerateModuleManifest" Condition="'$(SolutionDir)' != ''">
    <ItemGroup>
      <RawModuleOutputs Include="$(TargetDir)**\*.*" />
    </ItemGroup>

    <FindDuplicateFiles CandidateFiles="@(RawModuleOutputs)"
                         ExclusionListFile="$(TargetDir)$(ModuleKey).manifest.foreign-refs.txt"
                         SearchRoots="$(MainProjectBinRoot);$(MainProjectBinRoot)Modules\"
                         TargetDir="$(TargetDir)"
                         OwnDeployFolder="$(TargetModuleFolder)">
      <Output TaskParameter="DuplicateFiles" ItemName="ParentDuplicateAssemblies" />
    </FindDuplicateFiles>

    <ItemGroup>
      <IsolatedContextAssets Include="@(RawModuleOutputs)" />
      <IsolatedContextAssets Remove="@(ParentDuplicateAssemblies)" />
      <IsolatedContextAssets Remove="$(TargetDir)refs\**\*.*" />
      <IsolatedContextAssets Remove="$(TargetDir)runtimes\**\*.*" />
      <IsolatedContextAssets Remove="$(TargetDir)*.exe" />
      <IsolatedContextAssets Remove="$(TargetDir)*.exe.config" />
      <IsolatedContextAssets Remove="$(TargetDir)*.runtimeconfig.json" />
      <IsolatedContextAssets Remove="$(TargetDir)*.deps.json" />

      <ModuleUiAssets Include="$(ProjectDir)wwwroot\**\*.*" Condition="Exists('$(ProjectDir)wwwroot')" />
    </ItemGroup>
    <MakeDir Directories="$(TargetModuleFolder)" Condition="!Exists('$(TargetModuleFolder)')" />

    <ItemGroup>
      <ModuleConfigs Include="$(ProjectDir)appsettings.json" Condition="Exists('$(ProjectDir)appsettings.json')" />

      <ModuleConfigs Include="$(ProjectDir)appsettings.$(ModuleKey).json"
                     Condition="'$(ModuleKey)' != '' AND Exists('$(ProjectDir)appsettings.$(ModuleKey).json')" />

      <!-- node-specific settings go into each node home instead (SeedNodeHome, Directory.Build.props) -->
      <ModuleConfigs Include="$(ProjectDir)appsettings.$(ModuleKey).$(ConfigurationKey).json"
                     Condition="'$(NodeSettingsInHome)' != 'true' AND '$(ModuleKey)'  != '' AND '$(ConfigurationKey)' != '' AND Exists('$(ProjectDir)appsettings.$(ModuleKey).$(ConfigurationKey).json')" />
    </ItemGroup>

    <Copy SourceFiles="@(IsolatedContextAssets)"
          DestinationFolder="$(TargetModuleFolder)%(RecursiveDir)"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />

    <Copy SourceFiles="@(ModuleConfigs)"
          DestinationFolder="$(TargetModuleFolder)"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />

    <Copy SourceFiles="@(ModuleUiAssets)"
          DestinationFiles="@(ModuleUiAssets->'$(TargetModuleFolder)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          OverwriteReadOnlyFiles="true" />

    <!--
      Native libraries live with the host, never in a module folder (runtimes\** is excluded above).
      A native file only a module brings (the host doesn't have it yet) is copied into the host's own
      runtimes\ folder; ModuleAssemblyLoadContext.LoadUnmanagedDll looks there. Existing host files are
      never overwritten. Managed files under runtimes\*\lib are not copied: a module's load context can't
      use them from there.
    -->
    <ItemGroup>
      <_ModuleNativeAssets Include="$(TargetDir)runtimes\*\native\**\*.*">
        <Dest>$(MainProjectBinRoot)runtimes\%(RecursiveDir)%(Filename)%(Extension)</Dest>
      </_ModuleNativeAssets>
    </ItemGroup>
    <ItemGroup>
      <_NewNativeAssets Include="@(_ModuleNativeAssets)" Condition="!Exists('%(Dest)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_NewNativeAssets)"
          DestinationFiles="@(_NewNativeAssets->'%(Dest)')"
          OverwriteReadOnlyFiles="true"
          Condition="'@(_NewNativeAssets)' != ''" />
    <Message Importance="high" Condition="'@(_NewNativeAssets)' != ''"
             Text="[P2P Build Shield] Native files moved to the host for '$(ProjectName)': @(_NewNativeAssets->'%(Filename)%(Extension)', ', ')" />

    <Message Importance="high" Text="[P2P Build Shield] Context split complete for module '$(ProjectName)'. Parent duplicate assemblies skipped." />
  </Target>
  
  <Target Name="EvictModuleDeploymentFolder" AfterTargets="Clean">
    <Message Importance="high" Text="[Module Clean] -> Removing '$(TargetModuleFolder)'" />
    <RemoveDir Directories="$(TargetModuleFolder)" Condition="Exists('$(TargetModuleFolder)')" />
  </Target>

</Project>