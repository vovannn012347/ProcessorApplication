@model List<FileTransferModule.Models.FileArchiveItemRecord>
@{
    ViewData["Title"] = "File Archive";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}

<div id="file-archive-wrapper" data-script-id="ftt-archive">
    <div class="actions">
        <button type="button" id="btn-open-ingest-modal" class="btn"><i class="fa-solid fa-cloud-arrow-up"></i> Upload File</button>
        <button type="button" id="btn-open-track-modal" class="btn"><i class="fa-solid fa-folder-plus"></i> Track Existing Path</button>
        <button type="button" id="btn-open-import-modal" class="btn"><i class="fa-solid fa-file-import"></i> Import .ptorrent</button>
        <button type="button" id="btn-refresh-archive" class="btn"><i class="fa-solid fa-rotate"></i> Refresh</button>
        <span class="tip" tabindex="0" data-tip="Files this node hosts: uploaded, tracked in place or imported from a .ptorrent manifest, with their seeding state."></span>
    </div>
    <div id="archive-status-message" class="msg is-hidden"></div>
    <div class="card">
        <div class="body" id="archive-table-container">
            @await Html.PartialAsync("_TrackedFileListPartial", Model)
        </div>
    </div>
</div>

<div id="ingest-file-modal" class="modal is-hidden">
    <div class="card">
        <h2><i class="fa-solid fa-file-circle-plus"></i> Upload &amp; Seed File
            <button type="button" id="btn-close-ingest-modal" class="icon-btn" style="float:right" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </h2>
        <form id="form-ingest-file" method="post" enctype="multipart/form-data" class="body">
            @Html.AntiForgeryToken()
            <div class="f"><label for="input-upload-file">File</label><input type="file" name="uploadFile" id="input-upload-file" required /></div>
            <div class="f row">
                <input type="checkbox" name="isHidden" id="checkbox-is-hidden" value="true" />
                <label for="checkbox-is-hidden">Unlisted / Hidden</label> <span class="tip" tabindex="0" data-tip="Excluded from the catalogue and from tracker announces."></span>
            </div>
            <div class="actions">
                <button type="submit" id="btn-submit-ingest" class="btn"><span id="ingest-spinner" class="is-hidden"><i class="fa-solid fa-circle-notch fa-spin"></i></span> Generate &amp; Seed</button>
                <button type="button" id="btn-cancel-ingest" class="btn">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="track-path-modal" class="modal is-hidden">
    <div class="card">
        <h2><i class="fa-solid fa-folder-plus"></i> Track a File On This Server
            <button type="button" id="btn-close-track-modal" class="icon-btn" style="float:right" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </h2>
        <form id="form-track-path" class="body">
            @Html.AntiForgeryToken()
            <div class="f">
                <div><label for="input-source-path">Server-Side File Path</label> <span class="tip" tabindex="0" data-tip="This admin panel is localhost-only, so a path already on the machine is fine here."></span></div>
                <input type="text" name="sourcePath" id="input-source-path" class="mono" required placeholder="/var/data/myfile.zip" />
            </div>
            <div class="f row">
                <input type="checkbox" name="copyToRepository" id="checkbox-copy-to-repo" value="true" />
                <label for="checkbox-copy-to-repo">Copy into storage repository</label> <span class="tip" tabindex="0" data-tip="Unticked = tracked in place; the original file is never touched."></span>
            </div>
            <div class="f row">
                <input type="checkbox" name="isHidden" id="checkbox-track-hidden" value="true" />
                <label for="checkbox-track-hidden">Unlisted / Hidden</label>
            </div>
            <div class="actions">
                <button type="submit" id="btn-submit-track" class="btn">Track File</button>
                <button type="button" id="btn-cancel-track" class="btn">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="import-ptorrent-modal" class="modal is-hidden">
    <div class="card">
        <h2><i class="fa-solid fa-file-import"></i> Import .ptorrent &amp; Download
            <button type="button" id="btn-close-import-modal" class="icon-btn" style="float:right" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </h2>
        <form id="form-import-ptorrent" method="post" enctype="multipart/form-data" class="body">
            @Html.AntiForgeryToken()
            <div class="f">
                <div><label for="input-ptorrent-file">.ptorrent File</label> <span class="tip" tabindex="0" data-tip="A manifest someone gave you out-of-band. Its block hashes are what make the download possible."></span></div>
                <input type="file" name="ptorrentFile" id="input-ptorrent-file" required accept=".ptorrent,.json" />
            </div>
            <div class="f"><label for="input-import-filename">Custom File Name (optional)</label><input type="text" name="customFileName" id="input-import-filename" /></div>
            <div class="actions">
                <button type="submit" id="btn-submit-import" class="btn">Import &amp; Download</button>
                <button type="button" id="btn-cancel-import" class="btn">Cancel</button>
            </div>
        </form>
    </div>
</div>

<div id="edit-info-modal" class="modal is-hidden">
    <div class="card">
        <h2><i class="fa-solid fa-pen-to-square"></i> Edit File Settings
            <button type="button" id="btn-close-edit-modal" class="icon-btn" style="float:right" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </h2>
        <form id="form-edit-info" class="body">
            @Html.AntiForgeryToken()
            <input type="hidden" name="contentHash" id="edit-content-hash" />
            <div class="f"><b id="edit-file-name" class="wrap"></b></div>
            <div class="actions">
                <label class="f row"><input type="checkbox" name="isHidden" id="edit-is-hidden" /> Hidden</label>
                <label class="f row"><input type="checkbox" name="allowDownload" id="edit-allow-download" /> Allow Download</label>
            </div>
            <div class="f">
                <div><label for="edit-description">Description</label> <span class="tip" tabindex="0" data-tip="Shown to peers who explicitly ask for this file's info."></span></div>
                <textarea name="description" id="edit-description" rows="3"></textarea>
            </div>
            <div class="f">
                <div><label for="edit-custom-fields">Custom Fields</label> <span class="tip" tabindex="0" data-tip="One per line: key: value. Free to set; no restrictions apply to your own files."></span></div>
                <textarea id="edit-custom-fields" rows="3" class="mono" placeholder="key: value"></textarea>
            </div>
            <div class="actions">
                <button type="submit" id="btn-submit-edit" class="btn"><i class="fa-solid fa-floppy-disk"></i> Save</button>
                <button type="button" id="btn-cancel-edit" class="btn">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/FileTransfer/js/pages/file-archive/index.js" asp-append-version="true"></script>
}
