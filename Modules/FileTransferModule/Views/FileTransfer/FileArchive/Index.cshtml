@model List<FileSharingModule.Models.FileArchiveItemRecord>
@{
    ViewData["Title"] = "File Archive & Seeding";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax)
    {
        Layout = null;
    }
}

@section Styles {
    <link rel="stylesheet" href="/filetransfer/css/filetransfer.min.css" asp-append-version="true" />
}

<link rel="stylesheet" href="/filetransfer/css/filetransfer.min.css" asp-append-version="true" />

<div id="file-archive-wrapper" data-script-id="file-archive">
    <div class="container mx-auto py-6 px-4">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 pb-4 border-b border-gray-200">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Hosted File Archive</h1>
                <p class="text-xs text-slate-500 mt-1">Manage locally ingested packages, .ptorrent manifests, and seed states.</p>
            </div>
            <div class="mt-4 md:mt-0 flex gap-2">
                <button type="button" id="btn-open-ingest-modal" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-sm flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Ingest New File
                </button>
                <button type="button" id="btn-refresh-archive" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-rotate"></i> Refresh
                </button>
            </div>
        </div>

        <div id="archive-status-message" class="hidden mb-4 p-3 rounded-lg text-xs font-medium"></div>

        <div id="archive-table-container" class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
            @await Html.PartialAsync("_TrackedFileListPartial", Model)
        </div>
    </div>
</div>

<div id="ingest-file-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden">
    <div class="bg-white rounded-xl shadow-2xl border border-gray-100 max-w-lg w-full mx-4 overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-file-circle-plus text-indigo-600"></i> Ingest File to Mesh
            </h3>
            <button type="button" id="btn-close-ingest-modal" class="text-gray-400 hover:text-gray-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="form-ingest-file" method="post" enctype="multipart/form-data" class="p-6 space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Select File (.zip, raw, etc.)</label>
                <input type="file" name="uploadFile" id="input-upload-file" required class="block w-full text-xs text-slate-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100 cursor-pointer border border-gray-200 rounded-lg" />
            </div>

            <div class="flex items-center gap-2 pt-2">
                <input type="checkbox" name="isHidden" id="checkbox-is-hidden" value="true" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 h-4 w-4" />
                <label for="checkbox-is-hidden" class="text-xs text-slate-700 font-medium">
                    Unlisted / Hidden <span class="text-slate-400 font-normal">(Exclude from public search catalogs)</span>
                </label>
            </div>

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-2">
                <button type="button" id="btn-cancel-ingest" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-slate-600 rounded-lg text-xs font-semibold">Cancel</button>
                <button type="submit" id="btn-submit-ingest" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5">
                    <span id="ingest-spinner" class="hidden"><i class="fa-solid fa-circle-notch fa-spin"></i></span>
                    <span>Generate & Seed</span>
                </button>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <script src="~/filetr/js/pages/file-archive/index.js" asp-append-version="true"></script>
}