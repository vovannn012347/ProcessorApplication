@model List<FileTransferModule.Models.FileArchiveItemRecord>

<table class="t">
    <thead>
        <tr><th>File</th><th>Hash</th><th>Size</th><th>Visibility</th><th>Download</th><th>Added</th><th></th></tr>
    </thead>
    <tbody>
        @if (Model == null || Model.Count == 0)
        {
            <tr><td colspan="7" class="aux"><i class="fa-solid fa-box-open"></i> No files tracked or seeded on this node.</td></tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr data-hash="@item.Manifest.ContentHash"
                    data-filename="@item.Manifest.FileName"
                    data-hidden="@item.IsHidden.ToString().ToLowerInvariant()"
                    data-allow-download="@item.AllowDownload.ToString().ToLowerInvariant()"
                    data-description="@item.Description"
                    data-custom-fields="@(item.CustomFields != null ? System.Text.Json.JsonSerializer.Serialize(item.CustomFields) : "{}")">
                    <td><b class="wrap">@item.Manifest.FileName</b></td>
                    <td class="mono aux" title="@item.Manifest.ContentHash">@item.Manifest.ContentHash.Substring(0, Math.Min(12, item.Manifest.ContentHash.Length))…</td>
                    <td class="nowrap">@((item.Manifest.TotalSizeBytes / 1024.0 / 1024.0).ToString("F2")) <span class="aux">MB</span></td>
                    <td>
                        @if (item.IsHidden)
                        {
                            <span class="badge warn"><i class="fa-solid fa-eye-slash"></i> Hidden</span>
                        }
                        else
                        {
                            <span class="badge ok"><i class="fa-solid fa-globe"></i> Public</span>
                        }
                    </td>
                    <td>
                        @if (item.AllowDownload)
                        {
                            <span class="badge ok"><i class="fa-solid fa-play"></i> Seeding</span>
                        }
                        else
                        {
                            <span class="badge"><i class="fa-solid fa-pause"></i> Paused</span>
                        }
                    </td>
                    <td class="mono nowrap aux">@item.RegisteredUtc.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="nowrap">
                        <a href="@Url.Action("DownloadManifest", "FileArchive", new { contentHash = item.Manifest.ContentHash })" class="icon-btn" title="Download .ptorrent"><i class="fa-solid fa-download"></i></a>
                        <button type="button" data-action="edit-info" class="icon-btn" title="Edit settings"><i class="fa-solid fa-pen-to-square"></i></button>
                        <button type="button" data-action="delete-file" class="icon-btn bad" title="Stop &amp; delete"><i class="fa-solid fa-trash-can"></i></button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
