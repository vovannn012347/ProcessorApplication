@model FileTransferModule.Models.CatalogPageResponse
@{
    ViewData["Title"] = "File Catalog";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}

<div id="file-catalog-wrapper" data-script-id="ftt-catalog">
    <div class="grid">
        <div class="card">
            <h2>Module Status <span class="tip" tabindex="0" data-tip="Neither file_tracker nor file_node is a toggle here: both are gossiped roles set in the P2P settings (Node Roles). This panel only shows their effect."></span>
                <button type="button" id="btn-refresh-status" class="icon-btn" style="float:right" title="Refresh"><i class="fa-solid fa-arrows-rotate"></i></button>
            </h2>
            <div class="body">
                <div class="cols">
                    <div class="f"><label>Node ID</label><span id="status-node-id" class="mono wrap">-</span></div>
                    <div class="f"><label>Roles Advertised</label><span id="status-roles">-</span></div>
                    <div class="f"><label>Catalogue Walk</label><span id="status-walk">-</span></div>
                    <div class="f"><label>Known file_tracker Peers</label><span id="status-trackers">-</span></div>
                </div>
                <div class="actions">
                    <button type="button" id="btn-trigger-announce" class="btn sm"><i class="fa-solid fa-bullhorn"></i> Announce Now</button>
                    <button type="button" id="btn-ensure-walk" class="btn sm"><i class="fa-solid fa-diagram-project"></i> Start Catalogue Sync</button>
                </div>
                <div id="status-action-message" class="info is-hidden"></div>
            </div>
        </div>
        <div class="card">
            <h2>Probe a Node <span class="tip" tabindex="0" data-tip="Bypasses epidemic convergence: asks that one node right now and saves what it reports into local storage (subject to the per-host cap)."></span></h2>
            <div class="body">
                <form id="form-query-node" class="actions">
                    <input type="text" id="input-target-node-id" class="mono" placeholder="Target node ID..." required style="flex:1" />
                    <button type="submit" class="btn"><i class="fa-solid fa-magnifying-glass"></i> Probe</button>
                </form>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Files <span class="tip" tabindex="0" data-tip="Local knowledge only: own hosted files plus everything learned via consensus relay or a direct probe. Nothing is fetched live just by viewing this page."></span>
            <span style="float:right">
                <button type="button" id="btn-sync-now" class="btn sm"><i class="fa-solid fa-diagram-project"></i> Sync Now</button>
                <button type="button" id="btn-refresh-catalog" class="btn sm"><i class="fa-solid fa-rotate"></i> Refresh</button>
            </span>
        </h2>
        <div class="body">
            <div class="actions">
                <input type="text" id="filter-search" placeholder="Filter by file name..." style="flex:1" />
                <input type="text" id="filter-host" class="mono" placeholder="Filter by host node ID..." style="flex:1" />
                <button type="button" id="btn-apply-filters" class="btn sm">Apply</button>
                <button type="button" id="btn-clear-filters" class="btn sm">Clear</button>
            </div>
            <div id="catalog-status-message" class="msg is-hidden"></div>
            <div id="batch-download-bar" class="actions is-hidden">
                <span class="info"><b id="batch-selected-count">0</b> file(s) selected</span>
                <button type="button" id="btn-batch-download" class="btn sm"><i class="fa-solid fa-download"></i> Download Selected</button>
            </div>
            <div id="catalog-grid-container">
                @await Html.PartialAsync("_CatalogGridPartial", Model)
            </div>
        </div>
    </div>
</div>

<div id="download-prompt-modal" class="modal is-hidden">
    <div class="card">
        <h2><i class="fa-solid fa-download"></i> Download From Swarm
            <button type="button" id="btn-close-download-modal" class="icon-btn" style="float:right" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </h2>
        <form id="form-start-download" class="body">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modal-host-node-id" name="hostNodeId" />
            <input type="hidden" id="modal-content-hash" name="contentHash" />
            <div class="f"><label>File</label><b id="modal-display-filename"></b></div>
            <div class="f">
                <label for="modal-input-filename">Custom File Name (optional)</label>
                <input type="text" name="customFileName" id="modal-input-filename" placeholder="Keep default if empty..." />
            </div>
            @if (User.IsInRole("Admin"))
            {
                <div class="f">
                    <div><label for="modal-input-directory">Target Folder (admin)</label> <span class="tip" tabindex="0" data-tip="If blank, the file goes to the sandboxed ./Module_Data/FileSharing/Storage/{taskId}/files/"></span></div>
                    <input type="text" name="customDirectory" id="modal-input-directory" class="mono" placeholder="Empty = sandboxed storage root" />
                </div>
            }
            <div class="actions">
                <button type="submit" id="btn-confirm-download" class="btn"><span id="download-spinner" class="is-hidden"><i class="fa-solid fa-circle-notch fa-spin"></i></span> Start Download</button>
                <button type="button" id="btn-cancel-download" class="btn">Cancel</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/FileTransfer/js/pages/file-catalog/index.js" asp-append-version="true"></script>
}
