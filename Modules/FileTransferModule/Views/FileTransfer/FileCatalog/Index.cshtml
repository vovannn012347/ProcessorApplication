@model List<FileSharingModule.Models.FileCatalogEntry>
@{
    ViewData["Title"] = "Network File Catalog";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax)
    {
        Layout = null;
    }
}

@section Styles {
    <link rel="stylesheet" href="/filetransfer/css/filetransfer.min.css" asp-append-version="true" />
}

<link rel="stylesheet" href="/filetransfer/css/filetransfer.min.css" asp-append-version="true" />

<div id="file-catalog-wrapper" data-script-id="file-catalog">
    <div class="container mx-auto py-6 px-4">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 pb-4 border-b border-gray-200">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Swarm File Catalog</h1>
                <p class="text-xs text-slate-500 mt-1">Browse files discovered across mesh nodes and trackers without automatic ingestion.</p>
            </div>
            <div class="mt-4 md:mt-0 flex gap-2">
                <button type="button" id="btn-refresh-catalog" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-rotate"></i> Refresh Network
                </button>
            </div>
        </div>

        <div class="bg-slate-50 border border-gray-200 rounded-xl p-4 mb-6 shadow-sm">
            <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-2">Query Specific Node Directly</h3>
            <form id="form-query-node" class="flex gap-2">
                <input type="text" id="input-target-node-id" placeholder="Enter target Node ID (or candidate peer)..." class="flex-1 text-xs border border-gray-300 rounded-lg px-3 py-2 focus:ring-1 focus:ring-indigo-500" required />
                <button type="submit" class="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5">
                    <i class="fa-solid fa-magnifying-glass"></i> Probe Node
                </button>
            </form>
        </div>

        <div id="catalog-status-message" class="hidden mb-4 p-3 rounded-lg text-xs font-medium"></div>

        <div id="catalog-grid-container">
            @await Html.PartialAsync("_CatalogGridPartial", Model)
        </div>
    </div>
</div>

<div id="download-prompt-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden">
    <div class="bg-white rounded-xl shadow-2xl border border-gray-100 max-w-md w-full mx-4 overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-download text-indigo-600"></i> Download File From Swarm
            </h3>
            <button type="button" id="btn-close-download-modal" class="text-gray-400 hover:text-gray-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <form id="form-start-download" class="p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" id="modal-host-node-id" name="hostNodeId" />
            <input type="hidden" id="modal-content-hash" name="contentHash" />

            <div>
                <label class="block text-xs font-semibold text-slate-500">File Selected</label>
                <div id="modal-display-filename" class="text-sm font-bold text-slate-800 mt-0.5"></div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Custom File Name (Optional)</label>
                <input type="text" name="customFileName" id="modal-input-filename" placeholder="Keep default if empty..." class="w-full text-xs border border-gray-200 rounded-lg px-3 py-2" />
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">
                        Directed Directory <span class="text-indigo-600 font-bold">(Admin Mode)</span>
                    </label>
                    <input type="text" name="customDirectory" id="modal-input-directory" placeholder="Leave empty for sandboxed StorageRootPath..." class="w-full text-xs border border-gray-200 rounded-lg px-3 py-2" />
                    <p class="text-[10px] text-slate-400 mt-1">If blank, defaults to sandboxed <code>./Module_Data/FileSharing/Storage/{taskId}/files/</code></p>
                </div>
            }

            <div class="pt-4 border-t border-gray-100 flex justify-end gap-2">
                <button type="button" id="btn-cancel-download" class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-slate-600 rounded-lg text-xs font-semibold">Cancel</button>
                <button type="submit" id="btn-confirm-download" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold flex items-center gap-1.5">
                    <span id="download-spinner" class="hidden"><i class="fa-solid fa-circle-notch fa-spin"></i></span>
                    <span>Start Swarm Download</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/filetr/js/pages/file-catalog/index.js" asp-append-version="true"></script>
}