@model FileTransferModule.Models.CatalogPageResponse

<div id="catalog-page-state" data-page="@Model.Page" data-page-size="@Model.PageSize" data-total="@Model.TotalCount"></div>

@if (Model.Entries == null || Model.Entries.Count == 0)
{
    <div class="aux"><i class="fa-solid fa-folder-open"></i> No files match. Try a different search or page, or probe a node directly.</div>
}
else
{
    <table class="t">
        <thead>
            <tr><th></th><th>File</th><th>Size</th><th>Hash / Host</th><th>Info</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var entry in Model.Entries)
        {
            bool hasInfo = entry.FullInfoFetchedUtc.HasValue;
            <tr class="catalog-entry-card" data-host="@entry.HostNodeId" data-hash="@entry.Manifest.ContentHash" data-filename="@entry.Manifest.FileName">
                <td>
                    @if (!entry.IsLocalSeeding)
                    {
                        <input type="checkbox" class="catalog-batch-select" title="Select for batch download" />
                    }
                </td>
                <td><b class="wrap">@entry.Manifest.FileName</b></td>
                <td class="nowrap">
                    @if (entry.IsLocalSeeding || hasInfo)
                    {
                        <span>@((entry.Manifest.TotalSizeBytes / 1024.0 / 1024.0).ToString("F2")) <span class="aux">MB</span></span>
                    }
                    else
                    {
                        <span class="aux" title="Catalogue entries are lightweight by design; size and block data come with Get Info or when a download starts.">?</span>
                    }
                </td>
                <td class="mono aux">
                    <div title="Content hash">@entry.Manifest.ContentHash</div>
                    <div title="Host node">@entry.HostNodeId</div>
                </td>
                <td>
                    @if (hasInfo)
                    {
                        if (!string.IsNullOrEmpty(entry.Description))
                        {
                            <div class="wrap">@entry.Description</div>
                        }
                        if (entry.CustomFields != null && entry.CustomFields.Count > 0)
                        {
                            foreach (var kv in entry.CustomFields)
                            {
                                <span class="badge mono" title="@kv.Value">@kv.Key</span>
                            }
                        }
                        if (string.IsNullOrEmpty(entry.Description) && (entry.CustomFields == null || entry.CustomFields.Count == 0))
                        {
                            <span class="aux">No description or fields.</span>
                        }
                    }
                </td>
                <td class="nowrap">
                    @if (entry.IsLocalSeeding)
                    {
                        <span class="badge ok">Local seed</span>
                    }
                    else
                    {
                        if (!hasInfo)
                        {
                            <button type="button" data-action="download-info" class="btn sm" title="Get description and size from the host"><i class="fa-solid fa-circle-info"></i> Info</button>
                        }
                        <button type="button" data-action="prompt-download" class="btn sm"><i class="fa-solid fa-download"></i> Download</button>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@{
    int totalPages = Model.PageSize > 0 ? (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize) : 1;
}
@if (totalPages > 1)
{
    <div class="actions">
        <button type="button" id="btn-catalog-prev-page" data-target-page="@(Model.Page - 1)" class="btn sm" @(Model.Page <= 0 ? "disabled" : "")><i class="fa-solid fa-chevron-left"></i> Prev</button>
        <span class="aux">Page @(Model.Page + 1) of @totalPages &middot; @Model.TotalCount total</span>
        <button type="button" id="btn-catalog-next-page" data-target-page="@(Model.Page + 1)" class="btn sm" @(!Model.HasMore ? "disabled" : "")>Next <i class="fa-solid fa-chevron-right"></i></button>
    </div>
}

@if (Model.SavedCount > 0)
{
    <div class="aux">Saved @Model.SavedCount new record(s) from this probe to local storage.</div>
}
