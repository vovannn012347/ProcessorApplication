@model List<FileSharingModule.Models.SwarmTransferTaskState>
@{
    ViewData["Title"] = "Active File Swarm & Transfers";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax)
    {
        Layout = null;
    }
}

@section Styles {
    <link rel="stylesheet" href="/filetransfer/css/filetransfer.min.css" asp-append-version="true" />
}

<link rel="stylesheet" href="/filetransfer/css/filetransfer.min.css" asp-append-version="true" />

<div id="file-exchange-wrapper" data-script-id="file-exchange">
    <div class="container mx-auto py-6 px-4">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 pb-4 border-b border-gray-200">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Active File Transfers & Swarm</h1>
                <p class="text-xs text-slate-500 mt-1">Real-time WebRTC slice exchange monitoring, bitfield piece state, and transfer throttles.</p>
            </div>
            <div class="mt-4 md:mt-0 flex gap-2">
                <button type="button" id="btn-refresh-exchange" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition">
                    <i class="fa-solid fa-rotate"></i> Refresh State
                </button>
            </div>
        </div>

        <div id="exchange-telemetry-container">
            @await Html.PartialAsync("_ActiveTransfersPartial", Model)
        </div>
    </div>
</div>

<div id="bitfield-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden">
    <div class="bg-white rounded-xl shadow-2xl border border-gray-100 max-w-2xl w-full mx-4 overflow-hidden">
        <div class="px-6 py-4 bg-slate-50 border-b border-gray-100 flex justify-between items-center">
            <h3 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-cubes-stacked text-indigo-600"></i> Block Bitfield Visualizer
            </h3>
            <button type="button" id="btn-close-bitfield-modal" class="text-gray-400 hover:text-gray-600">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div id="bitfield-modal-content" class="p-6">
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/filetr/js/pages/file-exchange/index.js" asp-append-version="true"></script>
}
