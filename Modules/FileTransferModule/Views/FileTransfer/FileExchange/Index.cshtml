@model FileTransferModule.Models.ExchangeTelemetryViewModel
@{
    ViewData["Title"] = "File Transfers";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}

<div id="file-exchange-wrapper" data-script-id="ftt-exchange">
    @Html.AntiForgeryToken()
    <div class="actions">
        <button type="button" id="btn-refresh-exchange" class="btn"><i class="fa-solid fa-rotate"></i> Refresh</button>
        <span class="tip" tabindex="0" data-tip="Live slice exchange: node traffic, files served to peers, download tasks with their block map and controls."></span>
    </div>
    <div id="exchange-telemetry-container">
        @await Html.PartialAsync("_ActiveTransfersPartial", Model)
    </div>
</div>

<div id="bitfield-modal" class="modal is-hidden">
    <div class="card" style="width:min(680px,95vw)">
        <h2><i class="fa-solid fa-cubes-stacked"></i> Block Map
            <button type="button" id="btn-close-bitfield-modal" class="icon-btn" style="float:right" title="Close"><i class="fa-solid fa-xmark"></i></button>
        </h2>
        <div id="bitfield-modal-content" class="body"></div>
    </div>
</div>

@section Scripts {
    <script src="~/FileTransfer/js/pages/file-exchange/index.js" asp-append-version="true"></script>
}
