@model List<FileTransferModule.Models.FilePeerReputation>
@{
    ViewData["Title"] = "Peer File Reputation";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
    var now = DateTime.UtcNow;
    int bannedCount = Model.Count(r => r.IsBanned(now));
}

@if (TempData["ReputationMessage"] is string message)
{
    <div class="msg ok">@message</div>
}

<div class="card">
    <h2>Peers <span class="aux">@Model.Count known &middot; @bannedCount banned</span>
        <span class="tip" tabindex="0" data-tip="How each peer behaved as a source of file data for this node, across all files. Separate from the P2P node rating. A peer is banned as a file source after repeatedly sending blocks that fail verification (see Settings)."></span>
    </h2>
    <div class="body">
        @if (Model.Count == 0)
        {
            <span class="aux"><i class="fa-solid fa-users"></i> No peer has supplied file data to this node yet.</span>
        }
        else
        {
            <table class="t">
                <thead>
                    <tr>
                        <th>Peer</th>
                        <th title="Ranking used to pick seeders: verified blocks minus penalties.">Score</th>
                        <th>Verified Blocks</th>
                        <th>Verified Data</th>
                        <th title="Blocks that failed verification where this peer sent every slice: provably bad data.">Bad (sole)</th>
                        <th title="Blocks that failed verification where this peer was one of several sources: suspect only.">Bad (shared)</th>
                        <th>Timeouts</th>
                        <th>Status</th>
                        <th>Updated (UTC)</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        bool banned = r.IsBanned(now);
                        string confirmText = banned ? "Forget everything about this peer and lift the ban?" : "Forget everything about this peer?";
                        <tr>
                            <td class="mono" title="@r.NodeId">@(r.NodeId.Length > 20 ? r.NodeId.Substring(0, 20) + "…" : r.NodeId)</td>
                            <td class="@(r.Score < 0 ? "bad-t" : "")"><b>@r.Score.ToString("F1")</b></td>
                            <td>@r.BlocksVerified</td>
                            <td class="nowrap">@FormatBytes(r.BytesVerified)</td>
                            <td class="@(r.BadBlocksSoleSource > 0 ? "bad-t" : "")">@r.BadBlocksSoleSource</td>
                            <td>@r.BadBlocksSharedSource</td>
                            <td>@r.SliceTimeouts</td>
                            <td>
                                @if (banned)
                                {
                                    <span class="badge bad" title="Banned until @r.BannedUntilUtc?.ToString("u")">Banned</span>
                                }
                                else
                                {
                                    <span class="badge ok">OK</span>
                                }
                            </td>
                            <td class="mono nowrap aux">@r.LastUpdatedUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <form method="post" action="/@FileTransferModule.FileTransferModuleEntryPoint.MODULE_ID/FileExchange/ResetPeerReputationAndReturn" onsubmit="return confirm('@confirmText');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="nodeId" value="@r.NodeId" />
                                    <button type="submit" class="btn sm">@(banned ? "Unban & reset" : "Reset")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@functions {
    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1L << 30) return (bytes / (double)(1L << 30)).ToString("F2") + " GB";
        if (bytes >= 1L << 20) return (bytes / (double)(1L << 20)).ToString("F1") + " MB";
        if (bytes >= 1L << 10) return (bytes / (double)(1L << 10)).ToString("F0") + " KB";
        return bytes + " B";
    }
}
