@model FileTransferModule.Models.ExchangeTelemetryViewModel
@using FileTransferModule.Models

<div data-telemetry data-generated-ms="@Model.GeneratedUnixMs">

    @* Node-wide traffic. "since refresh" is the difference to the previous snapshot this page received
       (filled in by file-exchange/index.js). Totals count since the node started. *@
    <div class="grid" data-traffic-key="node" data-dl-total="@Model.NodeDownload.TotalBytes" data-ul-total="@Model.NodeUpload.TotalBytes">
        <div class="stat">
            <label><i class="fa-solid fa-arrow-down"></i> Downloaded (node)</label>
            <b>@FormatRate(Model.NodeDownload.RateBps)</b>
            <div class="aux">last min @FormatBytes(Model.NodeDownload.LastMinuteBytes) &middot; total @FormatBytes(Model.NodeDownload.TotalBytes)</div>
            <div class="aux" data-since="dl">since refresh: &mdash;</div>
        </div>
        <div class="stat">
            <label><i class="fa-solid fa-arrow-up"></i> Uploaded to peers (node)</label>
            <b>@FormatRate(Model.NodeUpload.RateBps)</b>
            <div class="aux">last min @FormatBytes(Model.NodeUpload.LastMinuteBytes) &middot; total @FormatBytes(Model.NodeUpload.TotalBytes)</div>
            <div class="aux" data-since="ul">since refresh: &mdash;</div>
        </div>
        <div class="stat">
            <label><i class="fa-solid fa-gauge"></i> Capacity</label>
            <div>Downloads running: <b>@Model.ActiveDownloads / @Model.MaxActiveDownloads</b></div>
            <div>Upload slots in use: <b>@Model.UploadSlotsInUse / @Model.UploadSlotsMax</b></div>
        </div>
    </div>

    @if (Model.Uploads.Count > 0)
    {
        <div class="card">
            <h2><i class="fa-solid fa-arrow-up"></i> Serving to Peers <span class="tip" tabindex="0" data-tip="Files peers are downloading from this node now (or did within the last minute): hosted files and finished downloads alike."></span></h2>
            <div class="body">
                <table class="t">
                    <thead><tr><th>File</th><th>Peers</th><th>Rate</th><th>Last min</th><th>Total</th><th>Since refresh</th></tr></thead>
                    <tbody>
                        @foreach (var up in Model.Uploads)
                        {
                            <tr data-traffic-key="up:@up.ContentHash" data-ul-total="@up.Upload.TotalBytes">
                                <td title="@up.ContentHash">@up.FileName</td>
                                <td>@up.ActiveChannels</td>
                                <td class="nowrap">@FormatRate(up.Upload.RateBps)</td>
                                <td class="nowrap">@FormatBytes(up.Upload.LastMinuteBytes)</td>
                                <td class="nowrap">@FormatBytes(up.Upload.TotalBytes)</td>
                                <td class="nowrap aux" data-since="ul">&mdash;</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (Model.Tasks.Count == 0)
    {
        <div class="card"><div class="body aux"><i class="fa-solid fa-network-wired"></i> No download tasks. Files peers download from this node appear under "Serving to Peers".</div></div>
    }
    else
    {
        foreach (var task in Model.Tasks)
        {
            var badge = task.Status switch
            {
                SwarmTaskStatus.Staging => ("badge ok", "Downloading"),
                SwarmTaskStatus.Assembling => ("badge warn", "Assembling"),
                SwarmTaskStatus.Complete => ("badge ok", "Complete"),
                SwarmTaskStatus.Queued => ("badge", "Queued"),
                SwarmTaskStatus.Paused => ("badge", "Paused"),
                SwarmTaskStatus.Failed => ("badge bad", "Failed"),
                _ => ("badge", task.Status.ToString())
            };
            var badgeTitle = task.Status == SwarmTaskStatus.Failed ? task.ErrorMessage
                : task.Status == SwarmTaskStatus.Queued ? "Waiting for a free download slot (Max Active Downloads)." : null;
            <div class="card" data-traffic-key="task:@task.TaskId" data-dl-total="@task.TotalDownloadedBytes" data-ul-total="@task.TotalUploadedBytes">
                <h2><i class="fa-solid fa-file-arrow-down"></i> @task.FileName <span class="@badge.Item1" title="@badgeTitle">@badge.Item2</span></h2>
                <div class="body">
                    <div class="mono aux wrap">@task.ContentHash.Substring(0, Math.Min(16, task.ContentHash.Length))… &middot; @(string.IsNullOrEmpty(task.TargetSavePath) ? "staging" : task.TargetSavePath)</div>
                    <div class="actions">
                        <span>@task.ProgressPercentage.ToString("F1")% (@task.Bitfield.GetCompletedBlocksCount() / @task.Bitfield.TotalBlocks blocks)</span>
                        <span class="aux">&middot; @task.ActiveSeedersCount peers</span>
                    </div>
                    <div class="bar"><i style="width:@task.ProgressPercentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)%"></i></div>
                    <div class="actions">
                        <b><i class="fa-solid fa-arrow-down"></i></b> <span>@FormatRate(task.DownloadSpeedBps)</span>
                        <span class="aux">last min @FormatBytes(task.DownloadedLastMinuteBytes) &middot; total @FormatBytes(task.TotalDownloadedBytes)</span>
                        <span class="aux" data-since="dl">since refresh: &mdash;</span>
                    </div>
                    <div class="actions">
                        <b><i class="fa-solid fa-arrow-up"></i></b> <span>@FormatRate(task.UploadSpeedBps)</span>
                        <span class="aux">last min @FormatBytes(task.UploadedLastMinuteBytes) &middot; total @FormatBytes(task.TotalUploadedBytes)</span>
                        <span class="aux" data-since="ul">since refresh: &mdash;</span>
                    </div>
                    <div class="actions">
                        <button type="button" data-action="view-bitfield" data-task="@task.TaskId" class="btn sm"><i class="fa-solid fa-cubes"></i> Block Map</button>
                        @if (task.Status == SwarmTaskStatus.Staging || task.Status == SwarmTaskStatus.Queued)
                        {
                            <button type="button" data-action="pause-task" data-task="@task.TaskId" class="btn sm"><i class="fa-solid fa-pause"></i> Pause</button>
                        }
                        else if (task.Status == SwarmTaskStatus.Paused)
                        {
                            <button type="button" data-action="resume-task" data-task="@task.TaskId" class="btn sm"><i class="fa-solid fa-play"></i> Resume</button>
                        }
                        <button type="button" data-action="cancel-task" data-task="@task.TaskId" class="btn sm"><i class="fa-solid fa-xmark"></i> Cancel</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@functions {
    private static string FormatRate(double bytesPerSecond)
    {
        if (bytesPerSecond >= 1024 * 1024) return (bytesPerSecond / (1024 * 1024)).ToString("F1") + " MB/s";
        if (bytesPerSecond >= 1024) return (bytesPerSecond / 1024).ToString("F0") + " KB/s";
        return bytesPerSecond.ToString("F0") + " B/s";
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1L << 30) return (bytes / (double)(1L << 30)).ToString("F2") + " GB";
        if (bytes >= 1L << 20) return (bytes / (double)(1L << 20)).ToString("F1") + " MB";
        if (bytes >= 1L << 10) return (bytes / (double)(1L << 10)).ToString("F0") + " KB";
        return bytes + " B";
    }
}
