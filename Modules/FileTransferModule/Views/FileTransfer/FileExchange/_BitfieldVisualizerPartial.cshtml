@model FileTransferModule.Models.SwarmTransferTaskState

<h3>Blocks <span class="tip" tabindex="0" data-tip="Highlighted blocks are downloaded and verified."></span></h3>
<div class="blocks">
    @for (int i = 0; i < Model.Bitfield.TotalBlocks; i++)
    {
        bool hasBlock = Model.Bitfield.HasBlock(i);
        <b class="@(hasBlock ? "on" : "")" title="Block #@i: @(hasBlock ? "Verified" : "Pending")">@i</b>
    }
</div>
<h3>Connected Peers</h3>
@await Html.PartialAsync("_PeerLanesPartial", Model)
