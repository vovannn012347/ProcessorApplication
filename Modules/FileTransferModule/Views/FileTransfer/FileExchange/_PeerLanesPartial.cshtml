@model FileTransferModule.Models.SwarmTransferTaskState

@if (Model.ConnectedPeerIds == null || Model.ConnectedPeerIds.Count == 0)
{
    <span class="aux">No peers connected to this download.</span>
}
else
{
    <table class="t">
        @foreach (var peerId in Model.ConnectedPeerIds)
        {
            <tr><td class="mono">@peerId</td><td><span class="badge ok">Connected</span></td></tr>
        }
    </table>
}
