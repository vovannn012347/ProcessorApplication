@model FileSharingModule.Models.SwarmTransferTaskState

<ul class="ftt-divide-y ftt-divide-gray-100 ftt-text-xs ftt-text-slate-600 ftt-bg-slate-50 ftt-border ftt-border-gray-200 ftt-rounded-lg ftt-max-h-36 ftt-overflow-y-auto">
    @if (Model.ConnectedPeerIds == null || Model.ConnectedPeerIds.Count == 0)
    {
        <li class="ftt-p-3 ftt-text-center ftt-text-slate-400">No remote peers actively connected to this swarm lane.</li>
    }
    else
    {
        @foreach (var peerId in Model.ConnectedPeerIds)
        {
            <li class="ftt-p-2.5 ftt-flex ftt-justify-between ftt-items-center ftt-font-mono">
                <span class="ftt-truncate">@peerId</span>
                <span class="ftt-inline-flex ftt-items-center ftt-px-1.5 ftt-py-0.5 ftt-rounded ftt-text-[10px] ftt-font-semibold ftt-bg-emerald-100 ftt-text-emerald-800">
                    Connected
                </span>
            </li>
        }
    }
</ul>
