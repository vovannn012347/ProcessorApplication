@model FileSharingModule.Configuration.FileSharingSettings
@{
    ViewData["Title"] = "File Sharing Configuration";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax)
    {
        Layout = null;
    }
}

@section Styles {
    <link rel="stylesheet" href="/filetransfer/css/filetransfer.min.css" asp-append-version="true" />
}

<link rel="stylesheet" href="/filetransfer/css/filetransfer.min.css" asp-append-version="true" />

<div id="file-sharing-settings-wrapper" data-script-id="file-settings">
    <div class="container mx-auto py-6 px-4">
        <div class="mb-6 pb-4 border-b border-gray-200">
            <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">File Sharing Settings</h1>
            <p class="text-xs text-slate-500 mt-1">Configure storage directories, block slicing thresholds, and swarm limits.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 p-3 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-lg text-xs font-semibold">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-xs font-semibold">
                @TempData["ErrorMessage"]
            </div>
        }

        <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-6 max-w-4xl">
            <form asp-action="SaveSettings" method="post">
                @Html.AntiForgeryToken()
                @await Html.PartialAsync("_GeneralSettingsPartial", Model)
                <div class="pt-6 border-t border-gray-100 flex justify-end">
                    <button type="submit" class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-xs font-semibold shadow-sm transition">
                        Save Configuration
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/filetr/js/pages/settings/index.js" asp-append-version="true"></script>
}