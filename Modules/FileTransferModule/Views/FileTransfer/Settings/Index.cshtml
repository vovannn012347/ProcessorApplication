@model FileTransferModule.Configuration.FileSharingSettings
@{
    ViewData["Title"] = "File Sharing Settings";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}

<div id="file-sharing-settings-wrapper" data-script-id="ftt-settings">
    <div class="card">
        <h2>General <span class="tip" tabindex="0" data-tip="Storage folders, chunk sizes, swarm limits and timeouts."></span></h2>
        <div class="body" id="general-settings-section">
            @await Html.PartialAsync("_GeneralSettingsFormPartial", Model)
        </div>
    </div>

    <div class="card">
        <h2>Catalogue Limits <span class="tip" tabindex="0" data-tip="How many records per host we keep, how much a direct probe asks for by default, and how long an unconfirmed record survives before eviction."></span></h2>
        <div class="body">
            <div id="catalog-settings-message" class="msg is-hidden"></div>
            <form id="catalogSettingsForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="grid">
                    <div class="f"><label for="maxCatalogRecordsPerHost">Max Records Per Host</label><input type="number" min="1" name="maxCatalogRecordsPerHost" id="maxCatalogRecordsPerHost" required /></div>
                    <div class="f"><label for="directQueryDefaultPageSize">Direct Query Page Size</label><input type="number" min="1" name="directQueryDefaultPageSize" id="directQueryDefaultPageSize" required /></div>
                    <div class="f"><label for="catalogRecordStaleAfterHours">Record Stale After (h)</label><input type="number" min="1" name="catalogRecordStaleAfterHours" id="catalogRecordStaleAfterHours" required /></div>
                </div>
                <div class="actions">
                    <button type="submit" id="saveCatalogSettingsButton" class="btn"><i class="fa-solid fa-floppy-disk"></i> Save Limits</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <h2>Custom Field Access List <span class="tip" tabindex="0" data-tip="Only for description/custom fields received from OTHER hosts (CatalogGetFileInfo), never for your own files. Rules are checked top to bottom; the first whose field-name pattern (and value pattern, if set) matches decides Allow/Deny. Use 'description' as the field name to target the free-text description."></span></h2>
        <div class="body">
            <div id="acl-rules-message" class="msg is-hidden"></div>
            @Html.AntiForgeryToken()

            <template id="tmpl-acl-rule-row">
                <tr class="acl-rule-row">
                    <td><input type="text" class="acl-field-pattern mono" placeholder="^description$" /></td>
                    <td><input type="text" class="acl-value-pattern mono" placeholder="^.{0,200}$ (optional)" /></td>
                    <td><select class="acl-action"><option value="Allow">Allow</option><option value="Deny">Deny</option></select></td>
                    <td><button type="button" class="acl-remove-row icon-btn bad" title="Remove rule"><i class="fa-solid fa-xmark"></i></button></td>
                </tr>
            </template>

            <table class="t">
                <thead>
                    <tr><th>Field Name Pattern (regex)</th><th>Value Pattern (regex, optional)</th><th>Action</th><th></th></tr>
                </thead>
                <tbody id="acl-rules-body"></tbody>
            </table>
            <div class="actions">
                <button type="button" id="btn-add-acl-rule" class="btn sm"><i class="fa-solid fa-plus"></i> Add rule</button>
            </div>
            <div class="actions">
                <label for="acl-default-action">Field matching no rule:</label>
                <select id="acl-default-action" style="width:auto">
                    <option value="Deny">Deny (recommended)</option>
                    <option value="Allow">Allow</option>
                </select>
                <button type="button" id="btn-save-acl-rules" class="btn"><i class="fa-solid fa-floppy-disk"></i> Save Access List</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/FileTransfer/js/pages/settings/index.js" asp-append-version="true"></script>
}
