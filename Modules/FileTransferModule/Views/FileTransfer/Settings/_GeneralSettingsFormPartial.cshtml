@model FileTransferModule.Configuration.FileSharingSettings

@if (ViewData["SuccessMessage"] != null)
{
    <div class="msg ok"><i class="fa-solid fa-check-circle"></i> @ViewData["SuccessMessage"]</div>
}
@if (ViewData["ErrorMessage"] != null)
{
    <div class="msg warn"><i class="fa-solid fa-triangle-exclamation"></i> @ViewData["ErrorMessage"]</div>
}

<form id="generalSettingsForm" asp-action="SaveSettings" method="post" autocomplete="off">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("_GeneralSettingsPartial", Model)
    <div class="actions">
        <button type="submit" id="saveGeneralSettingsButton" class="btn"><i class="fa-solid fa-floppy-disk"></i> Save Configuration</button>
    </div>
</form>
