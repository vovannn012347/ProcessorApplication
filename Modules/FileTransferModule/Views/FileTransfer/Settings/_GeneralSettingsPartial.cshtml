@model FileTransferModule.Configuration.FileSharingSettings

<h3>Storage</h3>
<div class="grid">
    <div class="f">
        <div><label for="StorageRootPath">Storage Root Path</label> <span class="tip" tabindex="0" data-tip="Root folder for shared files."></span></div>
        <input type="text" id="StorageRootPath" name="StorageRootPath" value="@Model.StorageRootPath" class="mono" required />
    </div>
    <div class="f">
        <div><label for="PendingDownloadsPath">Pending Downloads Path</label> <span class="tip" tabindex="0" data-tip="Where unfinished downloads are kept."></span></div>
        <input type="text" id="PendingDownloadsPath" name="PendingDownloadsPath" value="@Model.PendingDownloadsPath" class="mono" required />
    </div>
    <div class="f">
        <div><label for="ManifestsPath">Manifests (.ptorrent) Path</label></div>
        <input type="text" id="ManifestsPath" name="ManifestsPath" value="@Model.ManifestsPath" class="mono" required />
    </div>
    <div class="f">
        <div><label for="CatalogPath">Catalogue Path</label> <span class="tip" tabindex="0" data-tip="Per-node records: each host you have seen files from gets its own subfolder here. Changing this does not move records saved under the old path."></span></div>
        <input type="text" id="CatalogPath" name="CatalogPath" value="@Model.CatalogPath" class="mono" required />
    </div>
</div>
<h3>Chunking</h3>
<div class="grid">
    <div class="f">
        <div><label for="BlockSizeBytes">Block Verification Size (bytes)</label> <span class="tip" tabindex="0" data-tip="Hashed block size, e.g. 2097152 (2 MB) or 5242880 (5 MB)."></span></div>
        <input type="number" id="BlockSizeBytes" name="BlockSizeBytes" value="@Model.BlockSizeBytes" required />
    </div>
    <div class="f">
        <div><label for="SliceSizeBytes">Wire Slice Size (bytes)</label> <span class="tip" tabindex="0" data-tip="Size of one transfer message. Standard WebRTC chunk: 65536 (64 KB)."></span></div>
        <input type="number" id="SliceSizeBytes" name="SliceSizeBytes" value="@Model.SliceSizeBytes" required />
    </div>
</div>
<h3>Swarm Concurrency &amp; Timeouts</h3>
<div class="grid">
    <div class="f">
        <div><label for="MaxOutstandingRequestsPerPeer">Requests In Flight / Peer</label> <span class="tip" tabindex="0" data-tip="Max slice requests outstanding to one seeder at a time (download flow control)."></span></div>
        <input type="number" id="MaxOutstandingRequestsPerPeer" name="MaxOutstandingRequestsPerPeer" value="@Model.MaxOutstandingRequestsPerPeer" min="1" required />
    </div>
    <div class="f">
        <div><label for="UploadQueueLimitPerChannel">Upload Queue / Channel</label> <span class="tip" tabindex="0" data-tip="Max queued slice requests per incoming channel; extra requests are dropped and re-requested by the downloader."></span></div>
        <input type="number" id="UploadQueueLimitPerChannel" name="UploadQueueLimitPerChannel" value="@Model.UploadQueueLimitPerChannel" min="1" required />
    </div>
    <div class="f">
        <div><label for="UploadSendBufferHighWaterBytes">Upload Buffer High-Water (bytes)</label> <span class="tip" tabindex="0" data-tip="The seeder pauses sending while a channel's send buffer holds more than this."></span></div>
        <input type="number" id="UploadSendBufferHighWaterBytes" name="UploadSendBufferHighWaterBytes" value="@Model.UploadSendBufferHighWaterBytes" min="1" required />
    </div>
    <div class="f">
        <div><label for="PeerBanAfterBadBlocks">Ban After Bad Blocks</label> <span class="tip" tabindex="0" data-tip="Provably corrupt blocks from one peer before it is banned as a file source."></span></div>
        <input type="number" id="PeerBanAfterBadBlocks" name="PeerBanAfterBadBlocks" value="@Model.PeerBanAfterBadBlocks" min="1" required />
    </div>
    <div class="f">
        <div><label for="PeerBanDurationHours">Ban Duration (h)</label> <span class="tip" tabindex="0" data-tip="How long a file-source ban lasts."></span></div>
        <input type="number" id="PeerBanDurationHours" name="PeerBanDurationHours" value="@Model.PeerBanDurationHours" min="1" required />
    </div>
    <div class="f">
        <div><label for="MaxActiveDownloads">Max Active Downloads</label> <span class="tip" tabindex="0" data-tip="Downloads running at once; the rest wait in the queue and start automatically."></span></div>
        <input type="number" id="MaxActiveDownloads" name="MaxActiveDownloads" value="@Model.MaxActiveDownloads" min="1" required />
    </div>
    <div class="f">
        <div><label for="MaxUploadSlots">Upload Slots (node)</label> <span class="tip" tabindex="0" data-tip="Downloaders served at the same time across all files."></span></div>
        <input type="number" id="MaxUploadSlots" name="MaxUploadSlots" value="@Model.MaxUploadSlots" min="1" required />
    </div>
    <div class="f">
        <div><label for="MaxUploadSlotsPerPeer">Upload Slots / Peer</label> <span class="tip" tabindex="0" data-tip="Slots one peer may hold at once, so a single node can't take them all."></span></div>
        <input type="number" id="MaxUploadSlotsPerPeer" name="MaxUploadSlotsPerPeer" value="@Model.MaxUploadSlotsPerPeer" min="1" required />
    </div>
    <div class="f">
        <div><label for="MaxUploadRateKBps">Upload Cap (KB/s)</label> <span class="tip" tabindex="0" data-tip="Node-wide upload bandwidth limit. 0 = unlimited."></span></div>
        <input type="number" id="MaxUploadRateKBps" name="MaxUploadRateKBps" value="@Model.MaxUploadRateKBps" min="0" required />
    </div>
    <div class="f">
        <div><label for="MaxPeerConnectionsPerFile">Max Peers Per File</label></div>
        <input type="number" id="MaxPeerConnectionsPerFile" name="MaxPeerConnectionsPerFile" value="@Model.MaxPeerConnectionsPerFile" required />
    </div>
    <div class="f">
        <div><label for="SliceRequestTimeoutSeconds">Slice Timeout (s)</label></div>
        <input type="number" id="SliceRequestTimeoutSeconds" name="SliceRequestTimeoutSeconds" value="@Model.SliceRequestTimeoutSeconds" required />
    </div>
    <div class="f">
        <div><label for="SeederDiscoveryTimeoutSeconds">Discovery Timeout (s)</label></div>
        <input type="number" id="SeederDiscoveryTimeoutSeconds" name="SeederDiscoveryTimeoutSeconds" value="@Model.SeederDiscoveryTimeoutSeconds" required />
    </div>
    <div class="f">
        <div><label for="TrackerReannounceIntervalMinutes">Re-announce Interval (min)</label> <span class="tip" tabindex="0" data-tip="How often hosted files are re-announced to trackers. Trackers keep an announce for 1.5x the announcer's interval."></span></div>
        <input type="number" id="TrackerReannounceIntervalMinutes" name="TrackerReannounceIntervalMinutes" value="@Model.TrackerReannounceIntervalMinutes" min="1" required />
    </div>
</div>
<div class="f row">
    @* Checkbox first so its "true" wins when checked; the hidden "false" is what posts when unchecked. *@
    <input type="checkbox" id="SeedCompletedDownloads" name="SeedCompletedDownloads" value="true" @(Model.SeedCompletedDownloads ? "checked" : "") />
    <input type="hidden" name="SeedCompletedDownloads" value="false" />
    <label for="SeedCompletedDownloads">Seed completed downloads</label>
</div>
