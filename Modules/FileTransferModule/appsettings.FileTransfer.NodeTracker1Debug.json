{
  // One-PC test mesh (NodeTracker1Debug). Section name must be the class name (FileSharingSettings); "FileSharing" was never read.
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FileSharingSettings": {
    "TrackerReannounceIntervalMinutes": 1, // test: re-announce every minute (default 10)
    "SeederDiscoveryTimeoutSeconds": 15,
    "CatalogPersistDebounceSeconds": 10, // test (default 30)
    "MaxActiveDownloads": 3,
    "SeedCompletedDownloads": true,
    // Keep the ScriptProvisioning metadata fields (pscript.*) that other hosts attach to their catalogue records.
    "CustomFieldAccessRules": [
      {
        "FieldNamePattern": "^pscript\\.",
        "ValuePattern": "^.{0,200}$",
        "Action": "Allow"
      }
    ]
  }
}
