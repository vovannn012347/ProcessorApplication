<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Configurations>Debug;Release;TrackerDebug;ClientDebug;NodeTracker1Debug;NodeTracker2Debug;NodeClient1Debug;NodeClient2Debug</Configurations>

    <!--for appsettings hook in build.props-->
    <ModuleKey>P2P</ModuleKey>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="6.0.11" />
    <Content Update="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="module.manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <Folder Include="configFiles\Debug\" />
    <Folder Include="configFiles\Debug\Module_Data\P2P\identity\" />
    <Folder Include="wwwroot\css\" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\ProcessorApplication\ProcessorApplication.csproj">
      <CopyLocalSatelliteAssemblies>True</CopyLocalSatelliteAssemblies>
      <Private>False</Private>
      <IncludeAssets>all</IncludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <ModuleManifestDependency Include="Main">
      <MinVersion>1.0.0.0</MinVersion>
    </ModuleManifestDependency>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\Build\ModuleManifest.targets" />

</Project>
