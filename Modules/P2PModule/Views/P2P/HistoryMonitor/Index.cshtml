@model List<string>
@{
    ViewData["Title"] = "History Monitor";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}

<div id="p2p-consensus-wrapper" data-script-id="p2p-consensus-monitor">
    @Html.AntiForgeryToken()

    <div class="actions">
        <button type="button" data-tab="active-session" class="nav-tab-btn btn on"><i class="fa-solid fa-satellite-dish"></i> Active Session</button>
        <button type="button" data-tab="historical-ledger" class="nav-tab-btn btn"><i class="fa-solid fa-boxes-stacked"></i> History Partitions</button>
    </div>

    <div id="tab-active-session" class="tab-content">
        <div class="card">
            <h2>Consensus Engine <span id="sessionStatusBadge" class="badge">IDLE / STANDBY</span>
                <span style="float:right">
                    <button type="button" id="btn-trigger-consensus" class="btn sm"><i class="fa-solid fa-play"></i> Run Consensus Now</button>
                    <button type="button" id="btn-abort-consensus" class="btn sm"><i class="fa-solid fa-stop"></i> Abort</button>
                </span>
            </h2>
            <div class="body">
                <div class="grid">
                    <div class="f"><label>Session ID</label><span id="lblSessionId" class="mono">None</span></div>
                    <div class="f"><label>Target Sync Date</label><span id="lblTargetDate" class="mono">N/A</span></div>
                    <div class="f"><label>Initiator</label><span id="lblInitiator" class="mono">N/A</span></div>
                    <div class="f"><label>Engaged Peer</label><span id="lblTargetNode" class="mono">None (Broadcasting)</span></div>
                    <div class="f"><label>Last Activity</label><span id="lblLastActivity" class="mono">N/A</span></div>
                </div>
            </div>
        </div>
        <div class="grid">
            <div class="card">
                <h2><i class="fa-solid fa-check-double"></i> Visited / Merged Peers <span id="lblVisitedCount" class="badge">0</span></h2>
                <div class="body actions" id="containerVisitedNodes"><span class="aux">No visited nodes yet.</span></div>
            </div>
            <div class="card">
                <h2><i class="fa-solid fa-list-check"></i> Queued To Visit <span id="lblQueuedCount" class="badge">0</span></h2>
                <div class="body actions" id="containerQueuedNodes"><span class="aux">Queue is empty.</span></div>
            </div>
        </div>
    </div>

    <div id="tab-historical-ledger" class="tab-content is-hidden">
        <div class="grid">
            <div class="card">
                <h2>Dates
                    <button type="button" id="btn-force-health-check" class="btn sm" style="float:right" title="Check the stored partitions now"><i class="fa-solid fa-shield-halved"></i> Health Check</button>
                </h2>
                <div class="body" style="max-height:500px;overflow-y:auto">
                    @if (Model == null || !Model.Any())
                    {
                        <span class="aux">No history partitions.</span>
                    }
                    else
                    {
                        <table class="t">
                            @foreach (var day in Model)
                            {
                                <tr class="partition-date-item" data-date-key="@day" style="cursor:pointer">
                                    <td class="mono"><i class="fa-solid fa-calendar-day aux"></i> @day</td>
                                    <td><i class="fa-solid fa-chevron-right aux"></i></td>
                                </tr>
                            }
                        </table>
                    }
                </div>
            </div>
            <div class="card span-2">
                <h2>Partition <span id="lblSelectedDate" class="mono"></span></h2>
                <div class="body">
                    <div id="emptyDetailsState" class="aux">Select a date to see the recorded peers.</div>
                    <div id="detailsContentPanel" class="is-hidden">
                        <div id="partitionDisplayBox"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<template id="tmpl-node-tag"><span class="node-tag-text badge mono"></span></template>
<template id="tmpl-role-badge"><span class="role-badge-text badge"></span></template>
<template id="tmpl-endpoint-item"><li class="endpoint-item-text mono"></li></template>
<template id="tmpl-loading-spinner"><div class="aux"><i class="fa-solid fa-spinner fa-spin"></i> <span class="msg-loading"></span></div></template>
<template id="tmpl-error-message"><div class="bad-t"><i class="fa-solid fa-triangle-exclamation"></i> <span class="msg-error"></span></div></template>
<template id="tmpl-empty-info"><span class="msg-empty aux"></span></template>

@section Scripts {
    <script src="~/p2p/js/pages/consensusmonitor/index.js" asp-append-version="true"></script>
}
