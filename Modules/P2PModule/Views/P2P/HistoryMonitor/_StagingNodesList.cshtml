@model P2PModule.Controllers.HistoricalNodeDetailsViewModel

@if (Model == null || Model.NodeIds == null || !Model.NodeIds.Any())
{
    <span class="aux">No node records in this partition.</span>
}
else
{
    <table class="t">
        @foreach (var nodeId in Model.NodeIds)
        {
            <tbody class="node-accordion-item" data-node-id="@nodeId" data-target-date="@Model.TargetDate">
                <tr class="node-header-row" style="cursor:pointer">
                    <td class="mono"><i class="fa-solid fa-chevron-right node-chevron aux"></i> @nodeId</td>
                </tr>
                <tr class="node-details-drawer is-hidden">
                    <td>
                        <div class="drawer-loading aux"><i class="fa-solid fa-spinner fa-spin"></i> Loading...</div>
                        <div class="drawer-content is-hidden">
                            <div class="grid">
                                <div class="f"><label>Verification</label><span class="badge-verification"></span></div>
                                <div class="f"><label>Trust</label><span class="lbl-trust-score"></span></div>
                                <div class="f"><label>Last Seen</label><span class="lbl-last-seen mono"></span></div>
                                <div class="f"><label>Signature Time</label><span class="lbl-signature-time mono"></span></div>
                            </div>
                            <div class="f"><label>Roles</label><div class="container-roles actions"></div></div>
                            <div class="f"><label>Endpoints</label><ul class="container-endpoints"></ul></div>
                        </div>
                    </td>
                </tr>
            </tbody>
        }
    </table>
}
