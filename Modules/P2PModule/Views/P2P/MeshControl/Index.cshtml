@model List<P2PModule.Controllers.MeshPeerDisplayItem>
@{
    ViewData["Title"] = "Mesh Topology";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}

<div id="p2p-mesh-wrapper" data-script-id="p2p-mesh-overview">
    <div class="card">
        <h2>Local Node
            <form asp-action="ChangeIdentity" method="post" style="display:inline;float:right">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn sm" title="Generates new keys right now"><i class="fa-solid fa-key"></i> Change Identity Now</button>
            </form>
        </h2>
        <div class="body">
            <div class="cols">
                <div class="f"><label>Node ID</label><span class="mono">@ViewData["LocalNodeId"]</span></div>
                <div class="f"><label>Roles</label><span>@ViewData["LocalNodeRoles"]</span></div>
                <div class="f"><label>Encryption Key (base64)</label><span class="mono wrap aux">@ViewData["LocalEncryptionKey"]</span></div>
                <div class="f"><label>Verification Key (base64)</label><span class="mono wrap aux">@ViewData["LocalVerifyKey"]</span></div>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Manual Peer Add <span class="tip" tabindex="0" data-tip="One URL endpoint or node ID per line. URLs are contacted directly; node IDs are looked up in the mesh graph."></span></h2>
        <div class="body">
            <form id="form-unified-discovery" class="p2p-discovery-ajax-form" method="post">
                @Html.AntiForgeryToken()
                <div class="f">
                    <textarea id="p2p-batch-input-source" rows="3" class="mono" placeholder="http://192.168.1.100:5001&#10;node-abcde1234567890a..."></textarea>
                </div>
                <div class="actions">
                    <button type="submit" data-action="ConnectByHttp" data-param="rawUrls" class="btn"><i class="fa-solid fa-link"></i> Connect by URL / IP</button>
                    <button type="submit" data-action="ConnectByNodeId" data-param="rawIds" class="btn"><i class="fa-solid fa-diagram-project"></i> Connect by Node ID</button>
                </div>
            </form>
            <div id="console-expander-panel" class="is-hidden">
                <div class="actions"><label>Connection progress</label> <button type="button" id="btn-close-console" class="icon-btn" title="Collapse"><i class="fa-solid fa-xmark"></i></button></div>
                <div class="f"><textarea id="mesh-processing-output-area" readonly rows="10" class="mono" placeholder="Waiting for a connect request..."></textarea></div>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>Peers <span class="tip" tabindex="0" data-tip="Live status of connections and known neighbour peers. Trust: effective (normal, if overridden) / max."></span>
            <button type="button" id="btn-force-refresh-mesh" class="btn sm" style="float:right"><i class="fa-solid fa-arrows-rotate" id="refresh-icon"></i> Update now</button>
        </h2>
        <div class="body">
            <table class="t">
                <thead>
                    <tr><th>ID</th><th>Roles</th><th>Endpoint(s)</th><th>Trust</th><th>State</th><th>Seen / Activity</th></tr>
                </thead>
                <tbody id="p2p-node-table-body">
                    @Html.Partial("_NodeTableRows", Model)
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/p2p/js/pages/meshcontrol/index.js" asp-append-version="true"></script>
}
