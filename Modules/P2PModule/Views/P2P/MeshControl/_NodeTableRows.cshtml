@model List<P2PModule.Controllers.MeshPeerDisplayItem>

@if (Model == null || !Model.Any())
{
    <tr><td colspan="6" class="aux">Isolated node: no peers known yet.</td></tr>
}
else
{
    foreach (var node in Model)
    {
        bool hasOverride = Math.Abs(node.EffectiveTrustScore - node.NormalTrustScore) > 0.01;
        var trustClass = node.EffectiveTrustScore >= 80 ? "ok-t" : node.EffectiveTrustScore >= 40 ? "warn-t" : "bad-t";
        <tr>
            <td class="mono">@node.NodeId</td>
            <td>
                @if (node.Roles != null && node.Roles.Any())
                {
                    foreach (var role in node.Roles)
                    {
                        <span class="badge">@role</span>
                    }
                }
                else
                {
                    <span class="aux">—</span>
                }
            </td>
            <td class="mono">
                @if (node.Endpoints != null && node.Endpoints.Any())
                {
                    foreach (var endpoint in node.Endpoints)
                    {
                        <div>@endpoint</div>
                    }
                }
                else
                {
                    <span class="aux">—</span>
                }
            </td>
            <td class="nowrap @trustClass">
                @if (hasOverride)
                {
                    <span><b>@node.EffectiveTrustScore.ToString("F0")</b> <span class="aux">(@node.NormalTrustScore.ToString("F0"))</span> / @node.MaxTrustScore.ToString("F0")</span>
                }
                else
                {
                    <span><b>@node.NormalTrustScore.ToString("F0")</b> / @node.MaxTrustScore.ToString("F0")</span>
                }
            </td>
            <td>
                @if (node.IsConnected)
                {
                    <span class="badge ok">Connected</span>
                }
                else
                {
                    <span class="badge">Offline</span>
                }
                @if (node.IsHandshaked)
                {
                    <span class="badge ok">Handshaked</span>
                }
                @if (node.IsVerified)
                {
                    <span class="badge ok">Verified</span>
                }
                @foreach (var connType in node.ConnectionTypes)
                {
                    <span class="badge aux">@connType</span>
                }
            </td>
            <td class="mono nowrap aux">@(node.LastSeenOrActiveUtc == DateTime.MinValue ? "Never" : node.LastSeenOrActiveUtc.ToString("yyyy-MM-dd HH:mm:ss"))</td>
        </tr>
    }
}
