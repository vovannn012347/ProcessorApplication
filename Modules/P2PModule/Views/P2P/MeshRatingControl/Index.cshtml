@model List<P2PModule.Models.PeerOverrideRule>
@{
    ViewData["Title"] = "Mesh Policy Control";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}

<div id="p2p-control-wrapper" data-script-id="p2p-mesh-control">
    <div class="grid">
        <div class="card">
            <h2>Node Rule <span class="tip" tabindex="0" data-tip="Override a node's rating (whitelist / blacklist), cut its connection, or forget it completely."></span></h2>
            <div class="body">
                <form id="applyOverrideForm" asp-area="P2P" asp-controller="MeshRatingControl" asp-action="ApplyOverride" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <div class="f">
                        <label for="targetNodeId">Node ID</label>
                        <input type="text" id="targetNodeId" name="nodeId" class="mono" placeholder="Target node ID" required />
                    </div>
                    <div class="actions">
                        <label class="f row"><input type="radio" name="policyType" value="whitelist" checked /> Whitelist (100)</label>
                        <label class="f row"><input type="radio" name="policyType" value="blacklist" /> Blacklist (-50)</label>
                    </div>
                    <div class="actions">
                        <button type="submit" id="btnApplyOverride" class="btn"><i class="fa-solid fa-bolt"></i> Set Rule</button>
                    </div>
                </form>
                <div class="actions">
                    <label>Act now</label> <span class="tip" tabindex="0" data-tip="Sever: drop the live connection to the node. Wipe: remove it from memory and from the history files."></span>
                </div>
                <div class="actions">
                    <button type="button" id="btnDropLaneAction" class="btn"><i class="fa-solid fa-scissors"></i> Sever Connection</button>
                    <button type="button" id="btnForgetNodeAction" class="btn"><i class="fa-solid fa-trash-can"></i> Wipe From Memory &amp; History</button>
                </div>
            </div>
        </div>

        <div class="card span-2">
            <h2>Active Overrides</h2>
            <div class="body">
                <table class="t">
                    <thead>
                        <tr><th>Node ID</th><th>Rule</th><th>Issued (UTC)</th><th></th></tr>
                    </thead>
                    <tbody id="overrideRulesList">
                        @if (Model == null || !Model.Any())
                        {
                            <tr><td colspan="4" class="aux">No overrides.</td></tr>
                        }
                        else
                        {
                            foreach (var rule in Model)
                            {
                                <tr>
                                    <td class="mono" title="@rule.NodeId">@rule.NodeId</td>
                                    <td>
                                        @if (rule.ForceBlacklist)
                                        {
                                            <span class="badge bad">Blacklist (-50)</span>
                                        }
                                        else if (rule.ForceWhitelist)
                                        {
                                            <span class="badge ok">Whitelist (100)</span>
                                        }
                                    </td>
                                    <td class="mono nowrap aux">@rule.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td><button type="button" data-node-id="@rule.NodeId" class="btn-remove-override icon-btn bad" title="Revoke"><i class="fa-solid fa-xmark"></i> Revoke</button></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/p2p/js/pages/meshratingcontrol/index.js" asp-append-version="true"></script>
}
