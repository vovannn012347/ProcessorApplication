@model List<P2PModule.Models.PeerOverrideRule>
@{
    ViewData["Title"] = "P2P Mesh Network Policy Controls";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}


@section Styles {
    <link rel="stylesheet" href="/p2p/css/p2p.min.css" asp-append-version="true" />
}

@* AJAX-safe link for dynamic content loading *@
<link rel="stylesheet" href="/p2p/css/p2p.min.css" asp-append-version="true" />
<div id="p2p-control-wrapper" data-script-id="p2p-mesh-control" class="p2p-container p2p-mx-auto p2p-py-8 p2p-px-4">
    <div class="p2p-mb-8">
        <h1 class="p2p-text-3xl p2p-font-extrabold p2p-text-slate-900 p2p-tracking-tight">Mesh Policy Control Plane</h1>
        <p class="p2p-text-slate-500">Inject rating override rules, manage custom whitelists/blacklists, and execute forced eviction sweeps.</p>
    </div>

    <div class="p2p-grid p2p-grid-cols-1 lg:p2p-grid-cols-3 p2p-gap-6">
        <div class="lg:p2p-col-span-1 p2p-bg-white p2p-border p2p-border-gray-200 p2p-rounded-xl p2p-p-6 p2p-shadow-sm p2p-self-start">
            <h3 class="p2p-text-sm p2p-font-bold p2p-text-slate-800 p2p-mb-4">Create Policy Intercept Rule</h3>
            <form id="applyOverrideForm" asp-area="P2P" asp-controller="MeshRatingControl" asp-action="ApplyOverride" method="post" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="p2p-space-y-4">
                    <div>
                        <label class="p2p-text-[10px] p2p-font-black p2p-text-gray-400 p2p-uppercase p2p-tracking-widest">Target Node ID String</label>
                        <input type="text" id="targetNodeId" name="nodeId" placeholder="Target node Id" required class="p2p-w-full p2p-mt-1 p2p-p-2.5 p2p-bg-white p2p-border p2p-border-gray-200 p2p-rounded-lg p2p-text-sm focus:p2p-border-blue-500 focus:p2p-outline-none" />
                    </div>
                    <div>
                        <label class="p2p-text-[10px] p2p-font-black p2p-text-gray-400 p2p-uppercase p2p-tracking-widest p2p-block p2p-mb-2">Actions</label>
                        <div class="p2p-grid p2p-grid-cols-2 p2p-gap-4">
                            <label class="p2p-flex p2p-items-center p2p-gap-2.5 p2p-p-2.5 p2p-bg-gray-50 p2p-border p2p-border-gray-200 p2p-rounded-lg p2p-cursor-pointer p2p-text-xs p2p-font-bold">
                                <input type="radio" name="policyType" value="whitelist" checked class="p2p-text-blue-600 focus:p2p-ring-blue-500" />
                                Whitelist (100)
                            </label>
                            <label class="p2p-flex p2p-items-center p2p-gap-2.5 p2p-p-2.5 p2p-bg-gray-50 p2p-border p2p-border-gray-200 p2p-rounded-lg p2p-cursor-pointer p2p-text-xs p2p-font-bold">
                                <input type="radio" name="policyType" value="blacklist" class="p2p-text-blue-600 focus:p2p-ring-blue-500" />
                                Blacklist (-50)
                            </label>
                        </div>
                    </div>
                    <div class="p2p-pt-2">
                        <button type="submit" id="btnApplyOverride" class="p2p-w-full p2p-py-2.5 p2p-bg-blue-600 p2p-hover:p2p-bg-blue-700 p2p-text-white p2p-text-xs p2p-font-bold p2p-uppercase p2p-tracking-widest p2p-rounded-lg p2p-shadow-sm transition">
                            Set Rule
                            <i class="fa-solid fa-bolt p2p-ml-1.5"></i>
                        </button>
                    </div>
                </div>
            </form>

            <div class="p2p-border-t p2p-border-gray-100 p2p-mt-6 p2p-pt-6">
                <h3 class="p2p-text-sm p2p-font-bold p2p-text-slate-800 p2p-mb-2">Out-of-Band Disruption Actions</h3>
                <p class="p2p-text-xs p2p-text-slate-400 p2p-mb-4">Disrupt transport streams or completely wipe endpoints from current live caches and epoch database folder structures.</p>
                <div class="p2p-space-y-2">
                    <button type="button" id="btnDropLaneAction" class="p2p-w-full p2p-p-2.5 p2p-bg-white p2p-border p2p-border-amber-200 p2p-hover:p2p-bg-amber-50 p2p-text-amber-700 p2p-text-xs p2p-font-bold p2p-uppercase p2p-tracking-wider p2p-rounded-lg transition p2p-text-left p2p-flex p2p-items-center p2p-justify-between">
                        <span>Sever Connection (forced)</span>
                        <i class="fa-solid fa-scissors"></i>
                    </button>
                    <button type="button" id="btnForgetNodeAction" class="p2p-w-full p2p-p-2.5 p2p-bg-white p2p-border p2p-border-rose-200 p2p-hover:p2p-bg-rose-50 p2p-text-rose-700 p2p-text-xs p2p-font-bold p2p-uppercase p2p-tracking-wider p2p-rounded-lg transition p2p-text-left p2p-flex p2p-items-center p2p-justify-between">
                        <span>Wipe From Memory (and history)</span>
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="lg:p2p-col-span-2 p2p-bg-white p2p-border p2p-border-gray-200 p2p-rounded-xl p2p-shadow-sm p2p-overflow-hidden">
            <div class="p2p-p-4 p2p-bg-slate-50 p2p-border-b p2p-border-gray-200">
                <h3 class="p2p-text-sm p2p-font-bold p2p-text-slate-800">Active Administrative Intercept Ledger</h3>
            </div>
            <div class="p2p-overflow-x-auto">
                <table class="p2p-w-full p2p-text-left p2p-border-collapse">
                    <thead>
                        <tr class="p2p-bg-slate-50/50 p2p-border-b p2p-border-gray-200">
                            <th class="p2p-p-4 p2p-text-[10px] p2p-font-black p2p-text-gray-400 p2p-uppercase p2p-tracking-widest">Enforced Node ID</th>
                            <th class="p2p-p-4 p2p-text-[10px] p2p-font-black p2p-text-gray-400 p2p-uppercase p2p-tracking-widest">Effective Allocation</th>
                            <th class="p2p-p-4 p2p-text-[10px] p2p-font-black p2p-text-gray-400 p2p-uppercase p2p-tracking-widest">Timestamp Issued</th>
                            <th class="p2p-p-4 p2p-text-[10px] p2p-font-black p2p-text-gray-400 p2p-uppercase p2p-tracking-widest p2p-text-right">Revocation</th>
                        </tr>
                    </thead>
                    <tbody id="overrideRulesList">
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="p2p-p-8 p2p-text-center p2p-text-sm p2p-text-gray-400 p2p-italic">
                                    No administrative overrides currently declared.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var rule in Model)
                            {
                                <tr class="p2p-border-b p2p-border-gray-100 p2p-hover:p2p-bg-slate-50/50 transition">
                                    <td class="p2p-p-4 p2p-font-mono p2p-text-xs p2p-text-slate-900 p2p-truncate p2p-max-w-[180px]" title="@rule.NodeId">
                                        @rule.NodeId
                                    </td>
                                    <td class="p2p-p-4">
                                        @if (rule.ForceBlacklist)
                                        {
                                            <span class="p2p-px-2 p2p-py-0.5 p2p-bg-red-50 p2p-text-red-700 p2p-text-[10px] p2p-font-bold p2p-rounded">FORCED_BLACKLIST (-50)</span>
                                        }
                                        else if (rule.ForceWhitelist)
                                        {
                                            <span class="p2p-px-2 p2p-py-0.5 p2p-bg-green-50 p2p-text-green-700 p2p-text-[10px] p2p-font-bold p2p-rounded">FORCED_WHITELIST (100)</span>
                                        }
                                    </td>
                                    <td class="p2p-p-4 p2p-text-xs p2p-text-slate-500">
                                        @rule.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC
                                    </td>
                                    <td class="p2p-p-4 p2p-text-xs p2p-text-right">
                                        <button type="button" data-node-id="@rule.NodeId" class="btn-remove-override p2p-text-rose-600 p2p-hover:p2p-text-rose-800 p2p-font-bold focus:p2p-outline-none">
                                            Revoke
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/p2p/js/pages/meshratingcontrol/index.js" asp-append-version="true"></script>
}