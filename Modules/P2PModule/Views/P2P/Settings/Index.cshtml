@model P2PModule.Controllers.ViewModels.P2PSettingsViewModel
@{
    ViewData["Title"] = "P2P Settings";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}

<div id="p2p-settings-wrapper" data-script-id="p2p-settings">
    <div id="settings-messages">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="msg ok"><i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]</div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="msg warn"><div asp-validation-summary="All"></div></div>
        }
    </div>

    <form id="p2pSettingsForm" asp-area="P2P" asp-controller="Settings" asp-action="SaveP2P" method="post" autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="card">
            <h2>General <span class="tip" tabindex="0" data-tip="Topology, discovery endpoints and network timeouts."></span></h2>
            <div class="body">@await Html.PartialAsync("_GeneralSettingsPartial", Model)</div>
        </div>
        <div class="card">
            <h2>Storage &amp; History Retention <span class="tip" tabindex="0" data-tip="Disk-write cycles, history pruning and peer record limits."></span></h2>
            <div class="body">@await Html.PartialAsync("_StorageSettingsPartial", Model)</div>
        </div>
        <div class="card">
            <h2>Gossip &amp; Peer Discovery <span class="tip" tabindex="0" data-tip="Fanout, flood limits and gossip caching."></span></h2>
            <div class="body">@await Html.PartialAsync("_GossipSettingsPartial", Model)</div>
        </div>
        <div class="card">
            <h2>Trust Scoring &amp; Consensus <span class="tip" tabindex="0" data-tip="Reputation increments, trust decay, seniority damping and consensus weights."></span></h2>
            <div class="body">@await Html.PartialAsync("_RatingSettingsPartial", Model)</div>
        </div>

        <div class="actions">
            <button type="submit" id="saveP2PSettingsButton" class="btn"><i class="fa-solid fa-floppy-disk"></i> Save Settings</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/p2p/js/pages/settings/index.js" asp-append-version="true"></script>
}
