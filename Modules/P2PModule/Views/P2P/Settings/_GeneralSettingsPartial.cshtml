@model P2PModule.Controllers.ViewModels.P2PSettingsViewModel

<h3>Identity &amp; Topology</h3>
<div class="grid">
    <div class="f">
        <div><label for="General_DataStoragePath">Data Storage Path</label> <span class="tip" tabindex="0" data-tip="Folder where the P2P module keeps its data."></span></div>
        <input type="text" id="General_DataStoragePath" name="General.DataStoragePath" value="@Model.General.DataStoragePath" class="mono" />
    </div>
    <div class="f">
        <div><label for="General_TargetOutboundConnections">Target Outbound Connections</label> <span class="tip" tabindex="0" data-tip="How many outgoing peer connections the node tries to keep."></span></div>
        <input type="number" id="General_TargetOutboundConnections" name="General.TargetOutboundConnections" value="@Model.General.TargetOutboundConnections" min="1" max="50" />
    </div>
</div>
<div class="f row">
    <input type="hidden" name="General.IsTemporarilyPromotedTracker" value="false" />
    <input type="checkbox" id="General_IsTemporarilyPromotedTracker" name="General.IsTemporarilyPromotedTracker" value="true" @(Model.General.IsTemporarilyPromotedTracker ? "checked" : "") />
    <label for="General_IsTemporarilyPromotedTracker">Temporary Tracker Promotion</label>
    <span class="tip" tabindex="0" data-tip="Keeps the promoted tracker state. Untick to allow demotion back to a regular peer after consensus."></span>
</div>
<div class="f">
    <div><label>Node Role Capabilities</label></div>
    <div class="actions">
        @foreach (var role in Model.AvailableRoles)
        {
            <label class="f row"><input type="checkbox" name="General.NodeRoles" value="@role" @(Model.General.NodeRoles.Contains(role) ? "checked" : "") /> @role</label>
        }
    </div>
</div>
<div class="f">
    <div><label>Advertised Consensus Channels</label> <span class="tip" tabindex="0" data-tip="Datasets this node syncs with peers. Only installed channels can be advertised; changes are announced to the network once, shortly after saving."></span></div>
    <div class="actions">
        @if (Model.InstalledConsensusChannels == null || !Model.InstalledConsensusChannels.Any())
        {
            <span class="aux">No consensus channels installed.</span>
        }
        else
        {
            var advertised = Model.General.AdvertisedConsensusChannels ?? new List<string>();
            foreach (var channelId in Model.InstalledConsensusChannels)
            {
                <label class="f row"><input type="checkbox" name="General.AdvertisedConsensusChannels" value="@channelId" @(advertised.Contains(channelId, StringComparer.OrdinalIgnoreCase) ? "checked" : "") /> <span class="mono">@channelId</span></label>
            }
        }
        @if (Model.UnavailableConsensusChannels != null)
        {
            foreach (var channelId in Model.UnavailableConsensusChannels)
            {
                <label class="f row aux" title="Opted in, but the module providing this channel isn't loaded. Kept, and advertised again once the module is back."><input type="checkbox" checked disabled /> <span class="mono">@channelId</span> (module not loaded)</label>
            }
        }
    </div>
</div>

<h3>Discovery &amp; Infrastructure Nodes</h3>
<div class="f">
    <div>
        <label for="p2pNodeAccessTextArea">Advertised Node Access Endpoints</label> <span class="tip" tabindex="0" data-tip="Local endpoints advertised to the mesh, one per line. Pick a source and press Add to fill one in automatically."></span>
        @if (Model.EndpointProvisions != null && Model.EndpointProvisions.Any())
        {
            <select id="p2pEndpointSource" style="width:auto">
                @foreach (var source in Model.EndpointProvisions)
                {
                    <option value="@source">@source</option>
                }
            </select>
            <button type="button" id="p2pAddEndpointBtn" class="btn sm"><i class="fa-solid fa-plus"></i> Add</button>
        }
        else
        {
            <span class="aux">(no endpoint sources)</span>
        }
    </div>
    <textarea id="p2pNodeAccessTextArea" name="General.Endpoints" rows="3" class="mono" placeholder="One per line">@(Model.General.Endpoints != null ? string.Join("\n", Model.General.Endpoints) : "")</textarea>
</div>
<div class="f">
    <div><label for="General_SeedEndpoints">Seed Trackers</label> <span class="tip" tabindex="0" data-tip="Trackers contacted first, one per line, e.g. https://tracker1.domain.xyz"></span></div>
    <textarea id="General_SeedEndpoints" name="General.SeedEndpoints" rows="3" class="mono" placeholder="One per line">@(Model.General.SeedEndpoints != null ? string.Join("\n", Model.General.SeedEndpoints) : "")</textarea>
</div>
<div class="f">
    <div><label for="General_StunServers">STUN Servers</label> <span class="tip" tabindex="0" data-tip="One per line, e.g. stun:stun.l.google.com:19302"></span></div>
    <textarea id="General_StunServers" name="General.StunServers" rows="3" class="mono" placeholder="One per line">@(Model.General.StunServers != null ? string.Join("\n", Model.General.StunServers) : "")</textarea>
</div>

<h3>Liveness &amp; Network Timeouts</h3>
<div class="grid">
    <div class="f">
        <div><label for="General_StartupDelaySeconds">Startup Delay (s)</label> <span class="tip" tabindex="0" data-tip="Wait before the P2P services start."></span></div>
        <input type="number" id="General_StartupDelaySeconds" name="General.StartupDelaySeconds" value="@Model.General.StartupDelaySeconds" />
    </div>
    <div class="f">
        <div><label for="General_ActiveNodeSecondsBackupPeriod">Backup Dump Period (s)</label> <span class="tip" tabindex="0" data-tip="How often active node state is saved."></span></div>
        <input type="number" id="General_ActiveNodeSecondsBackupPeriod" name="General.ActiveNodeSecondsBackupPeriod" value="@Model.General.ActiveNodeSecondsBackupPeriod" />
    </div>
    <div class="f">
        <div><label for="General_KeepAlivePeriodMs">Heartbeat Keepalive (ms)</label> <span class="tip" tabindex="0" data-tip="Interval of keepalive messages on open connections."></span></div>
        <input type="number" id="General_KeepAlivePeriodMs" name="General.KeepAlivePeriodMs" value="@Model.General.KeepAlivePeriodMs" />
    </div>
    <div class="f">
        <div><label for="General_TopologyMaintenannceIntervalMs">Topology Update Period (ms)</label> <span class="tip" tabindex="0" data-tip="How often connections are rebalanced."></span></div>
        <input type="number" id="General_TopologyMaintenannceIntervalMs" name="General.TopologyMaintenannceIntervalMs" value="@Model.General.TopologyMaintenannceIntervalMs" />
    </div>
    <div class="f">
        <div><label for="General_HttpTimeoutSeconds">HTTP Request Timeout (s)</label></div>
        <input type="number" id="General_HttpTimeoutSeconds" name="General.HttpTimeoutSeconds" value="@Model.General.HttpTimeoutSeconds" />
    </div>
    <div class="f">
        <div><label for="General_DefaultHandshakeTimeoutSeconds">Handshake Timeout (s)</label></div>
        <input type="number" id="General_DefaultHandshakeTimeoutSeconds" name="General.DefaultHandshakeTimeoutSeconds" value="@Model.General.DefaultHandshakeTimeoutSeconds" />
    </div>
    <div class="f">
        <div><label for="General_MaxRelayInactivitySeconds">Unhandshaked Connection Timeout (s)</label> <span class="tip" tabindex="0" data-tip="Connections that never complete a handshake are closed after this."></span></div>
        <input type="number" id="General_MaxRelayInactivitySeconds" name="General.MaxRelayInactivitySeconds" value="@Model.General.MaxRelayInactivitySeconds" />
    </div>
    <div class="f">
        <div><label for="General_DefaultRequestTimeoutSeconds">P2P Request Timeout (s)</label></div>
        <input type="number" id="General_DefaultRequestTimeoutSeconds" name="General.DefaultRequestTimeoutSeconds" value="@Model.General.DefaultRequestTimeoutSeconds" />
    </div>
    <div class="f">
        <div><label for="General_TimeSyncIntervalSeconds">Time Sync Interval (s)</label></div>
        <input type="number" id="General_TimeSyncIntervalSeconds" name="General.TimeSyncIntervalSeconds" value="@Model.General.TimeSyncIntervalSeconds" />
    </div>
</div>
