@model P2PModule.Controllers.ViewModels.P2PSettingsViewModel

<div class="grid">
    <div class="f">
        <div><label for="Gossip_MaxNewNodesDrip">Throttle Node Ingress</label> <span class="tip" tabindex="0" data-tip="Up to this many new nodes are saved to disk with each flush (flood prevention)."></span></div>
        <input type="number" id="Gossip_MaxNewNodesDrip" name="Gossip.MaxNewNodesDrip" value="@Model.Gossip.MaxNewNodesDrip" min="1" />
    </div>
    <div class="f">
        <div><label for="Gossip_NodeDripPenalty">Node Drip Penalty</label> <span class="tip" tabindex="0" data-tip="Reputation penalty for nodes sending more new nodes than the quota (flood prevention)."></span></div>
        <input type="number" id="Gossip_NodeDripPenalty" name="Gossip.NodeDripPenalty" value="@Model.Gossip.NodeDripPenalty" min="0" />
    </div>
    <div class="f">
        <div><label for="Gossip_GossipNodesSeconds">Node Gossip Window (s)</label> <span class="tip" tabindex="0" data-tip="Gossip about new nodes every N seconds."></span></div>
        <input type="number" id="Gossip_GossipNodesSeconds" name="Gossip.GossipNodesSeconds" value="@Model.Gossip.GossipNodesSeconds" min="1" />
    </div>
    <div class="f">
        <div><label for="Gossip_FanoutTargetCount">Fanout Target Count</label> <span class="tip" tabindex="0" data-tip="Number of random neighbour peers that receive each new state update."></span></div>
        <input type="number" id="Gossip_FanoutTargetCount" name="Gossip.FanoutTargetCount" value="@Model.Gossip.FanoutTargetCount" min="1" />
    </div>
    <div class="f">
        <div><label for="Gossip_GossipInBatches">Gossip Batch Cap</label> <span class="tip" tabindex="0" data-tip="Maximum updates in a single gossip message."></span></div>
        <input type="number" id="Gossip_GossipInBatches" name="Gossip.GossipInBatches" value="@Model.Gossip.GossipInBatches" min="1" />
    </div>
    <div class="f">
        <div><label for="Gossip_GossipStaleAgeMs">Stale Gossip Expiry (ms)</label> <span class="tip" tabindex="0" data-tip="Gossip older than this (since creation) is dropped."></span></div>
        <input type="number" id="Gossip_GossipStaleAgeMs" name="Gossip.GossipStaleAgeMs" value="@Model.Gossip.GossipStaleAgeMs" min="1" />
    </div>
    <div class="f">
        <div><label for="Gossip_SeenReportCacheTtlMinutes">Gossip Memory (min)</label> <span class="tip" tabindex="0" data-tip="How long seen gossip is remembered (prevents gossip loops)."></span></div>
        <input type="number" id="Gossip_SeenReportCacheTtlMinutes" name="Gossip.SeenReportCacheTtlMinutes" value="@Model.Gossip.SeenReportCacheTtlMinutes" min="1" />
    </div>
</div>
