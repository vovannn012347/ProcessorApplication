@model P2PModule.Controllers.ViewModels.P2PSettingsViewModel

<div class="grid">
    <div class="f">
        <div><label for="Rating_HandshakeRepDelta">Handshake Rep Delta</label> <span class="tip" tabindex="0" data-tip="Reputation reward for a successful connection verification."></span></div>
        <input type="number" id="Rating_HandshakeRepDelta" name="Rating.HandshakeRepDelta" value="@Model.Rating.HandshakeRepDelta" step="0.01" />
    </div>
    <div class="f">
        <div><label for="Rating_SenioritySmoothingCoefficient">Seniority Smoothing Coefficient</label> <span class="tip" tabindex="0" data-tip="Logarithmic damping applied to long-living nodes."></span></div>
        <input type="number" id="Rating_SenioritySmoothingCoefficient" name="Rating.SenioritySmoothingCoefficient" value="@Model.Rating.SenioritySmoothingCoefficient" step="0.01" />
    </div>
    <div class="f">
        <div><label for="Rating_MinimumTrustThreshold">Minimum Trust Threshold</label> <span class="tip" tabindex="0" data-tip="Peers falling below this score are blocked automatically."></span></div>
        <input type="number" id="Rating_MinimumTrustThreshold" name="Rating.MinimumTrustThreshold" value="@Model.Rating.MinimumTrustThreshold" step="0.01" />
    </div>
    <div class="f">
        <div><label for="Rating_PositiveTrustDecayRate">Trust Decay Rate</label> <span class="tip" tabindex="0" data-tip="How fast trust fades while a node is inactive."></span></div>
        <input type="number" id="Rating_PositiveTrustDecayRate" name="Rating.PositiveTrustDecayRate" value="@Model.Rating.PositiveTrustDecayRate" step="0.01" />
    </div>
    <div class="f">
        <div><label for="Rating_NegativeTrustIndulgenceRate">Trust Indulgence Rate</label> <span class="tip" tabindex="0" data-tip="How fast bad behaviour is forgotten."></span></div>
        <input type="number" id="Rating_NegativeTrustIndulgenceRate" name="Rating.NegativeTrustIndulgenceRate" value="@Model.Rating.NegativeTrustIndulgenceRate" step="0.01" />
    </div>
    <div class="f">
        <div><label for="Rating_ConsensusSelfTrust">Consensus Self-Trust Weight</label> <span class="tip" tabindex="0" data-tip="How much our own knowledge of a rating counts. 1.0 ignores other nodes' opinions entirely."></span></div>
        <input type="number" id="Rating_ConsensusSelfTrust" name="Rating.ConsensusSelfTrust" value="@Model.Rating.ConsensusSelfTrust" step="0.01" min="0" max="1" />
    </div>
    <div class="f">
        <div><label for="Rating_ConsensusOutOfTImeStartThreshold">Out-of-Time Trust Threshold</label> <span class="tip" tabindex="0" data-tip="Nodes below this rating are ignored for consensus requests made outside consensus time."></span></div>
        <input type="number" id="Rating_ConsensusOutOfTImeStartThreshold" name="Rating.ConsensusOutOfTImeStartThreshold" value="@Model.Rating.ConsensusOutOfTImeStartThreshold" step="0.01" />
    </div>
    <div class="f">
        <div><label for="Rating_ConsensusOutOfTImePrice">Out-of-Time Trust Penalty</label> <span class="tip" tabindex="0" data-tip="Trust penalty applied for an out-of-time consensus request."></span></div>
        <input type="number" id="Rating_ConsensusOutOfTImePrice" name="Rating.ConsensusOutOfTImePrice" value="@Model.Rating.ConsensusOutOfTImePrice" step="0.01" />
    </div>
</div>
