@model P2PModule.Controllers.ViewModels.P2PSettingsViewModel

<div class="grid">
    <div class="f">
        <div><label for="Storage_PersistTimePeriodSeconds">Flush Disk Interval (s)</label> <span class="tip" tabindex="0" data-tip="How often in-memory consensus data is written to the daily files on disk."></span></div>
        <input type="number" id="Storage_PersistTimePeriodSeconds" name="Storage.PersistTimePeriodSeconds" value="@Model.Storage.PersistTimePeriodSeconds" min="1" />
    </div>
    <div class="f">
        <div><label for="Storage_MaxNewNodesDrip">Max New Nodes Ingress Drip</label> <span class="tip" tabindex="0" data-tip="Cap on unverified incoming peer records processed per flush (protects the database from floods)."></span></div>
        <input type="number" id="Storage_MaxNewNodesDrip" name="Storage.MaxNewNodesDrip" value="@Model.Storage.MaxNewNodesDrip" min="1" />
    </div>
    <div class="f">
        <div><label for="Storage_RetainedHistoryEpochsCount">Retained History Epochs</label> <span class="tip" tabindex="0" data-tip="Maximum number of history shards kept locally before purges."></span></div>
        <input type="number" id="Storage_RetainedHistoryEpochsCount" name="Storage.RetainedHistoryEpochsCount" value="@Model.Storage.RetainedHistoryEpochsCount" min="1" />
    </div>
    <div class="f">
        <div><label for="Storage_RetainedNodeHistoryEpochs">Min Retained Node History Epochs</label> <span class="tip" tabindex="0" data-tip="History kept for inactive nodes, so their reputation is not evicted too early."></span></div>
        <input type="number" id="Storage_RetainedNodeHistoryEpochs" name="Storage.RetainedNodeHistoryEpochs" value="@Model.Storage.RetainedNodeHistoryEpochs" min="1" />
    </div>
</div>
