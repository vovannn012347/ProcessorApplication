{
  // Shared by EVERY swarm node (program folder). Per node, Build\setup-swarm-homes.ps1 adds
  // <home>\Modules\P2PModule\appsettings.P2P.NodeTrackerSwarm.json with EnforcedNodeIdentifier,
  // Endpoints and SeedEndpoints - so those three are deliberately not set here.
  "P2PSettings": {
    "StartupDelaySeconds": 15,
    "TargetOutboundConnections": 3,
    "TopologyMaintenannceIntervalMs": 30000,
    // Same roles and channels as the test-mesh trackers. For a consensus-only run, drop the file_* roles
    // and "filetr.catalog".
    "NodeRoles": [ "tracker", "file_tracker", "file_node" ],
    "AdvertisedConsensusChannels": [ "filetr.catalog", "p2p.peer-trust" ],
    "StunServers": [
      "stun:stun.cloudflare.com:3478",
      "stun:stun.l.google.com:19302"
    ]
  }
}
