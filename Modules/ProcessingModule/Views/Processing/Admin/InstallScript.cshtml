@{
    ViewData["Title"] = "Install Script";
    int maxUploadMb = ViewBag.MaxUploadMb ?? 2048;
    int maxExtractedMb = ViewBag.MaxExtractedMb ?? 4096;
}

<div id="install-script-wrapper" data-script-id="processor-install-script" data-max-upload-mb="@maxUploadMb">
    @Html.AntiForgeryToken()

    <div class="actions">
        <a href="/Processing/Home/ScriptList" class="btn"><i class="fa-solid fa-arrow-left"></i> Back to Library</a>
    </div>

    <div id="pickPanel" class="card">
        <h2>Script Package (.zip) <span class="tip" tabindex="0" data-tip="The package is checked before anything is installed. Each version goes into its own folder. script_manifest.json must be at the top of the archive or in one top-level folder."></span></h2>
        <div class="body">
            <label id="dropZone" for="packageInput" class="drop">
                <i class="fa-solid fa-file-zipper aux" style="font-size:22px"></i>
                <span>Drop a .zip here or click to choose</span>
                <span class="aux">Up to @maxUploadMb MB, extracting to at most @maxExtractedMb MB.</span>
                <span id="selectedFile" class="mono info"></span>
            </label>
            <input type="file" id="packageInput" accept=".zip,application/zip" class="is-hidden" />
            <div class="actions">
                <button id="uploadBtn" type="button" disabled class="btn"><i class="fa-solid fa-upload"></i> Upload &amp; Check</button>
            </div>
        </div>
    </div>

    <div id="progressPanel" class="card is-hidden">
        <div class="body">
            <div class="actions"><b id="progressLabel">Uploading…</b> <span id="progressValue" class="mono aux"></span></div>
            <div class="bar"><i id="progressBar" style="width:0%"></i></div>
            <div class="actions">
                <span id="progressHint" class="aux">You can keep using the app in another tab while this runs.</span>
                <button id="cancelBtn" type="button" class="btn sm">Cancel</button>
            </div>
        </div>
    </div>

    <div id="resultPanel" class="card is-hidden">
        <div class="body">
            <div class="actions">
                <i id="resultIcon" class="fa-solid fa-circle-check"></i>
                <b id="resultMessage"></b>
            </div>
            <div id="resultSubline" class="mono aux wrap"></div>

            <div id="confirmBox" class="msg warn is-hidden">
                <div>Replacing deletes the installed files of this version and indexes the new ones. Jobs that are queued or running with this script block the replacement.</div>
                <div class="actions">
                    <button id="overwriteBtn" type="button" class="btn sm">Replace installed version</button>
                    <button id="discardBtn" type="button" class="btn sm">Keep installed version</button>
                </div>
            </div>

            <div id="resultFacts" class="grid"></div>

            <h3>Validation Report</h3>
            <ul id="reportList" style="list-style:none;margin:0;padding:0"></ul>

            <details id="indexLogBox" class="is-hidden">
                <summary class="lbl" style="cursor:pointer">Indexing log</summary>
                <pre id="indexLog" class="mono wrap note" style="max-height:256px;overflow:auto;margin:0"></pre>
            </details>

            <div class="actions">
                <button id="againBtn" type="button" class="btn">Upload another</button>
                <a id="libraryLink" href="/Processing/Home/ScriptList" class="btn is-hidden">Open library</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/processing/js/pages/admin/install-script.js" asp-append-version="true"></script>
}
