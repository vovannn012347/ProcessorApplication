@{
    ViewData["Title"] = "Library Reindex";
}
<div id="reindex-console-wrapper" data-script-id="processor-reindex-logs">
    <div class="actions">
        <a href="/Processing/Home/ScriptList" class="btn"><i class="fa-solid fa-arrow-left"></i> Back to Library</a>
        <span>Status: <span id="statusText" class="info">Starting...</span></span>
    </div>
    <div class="f">
        <textarea id="consoleOutput" readonly class="mono" style="height:70vh;resize:vertical" placeholder="Connecting to the indexer..."></textarea>
    </div>
</div>

@section Scripts {
    <script src="~/processing/js/pages/admin/reindex-logs.js" asp-append-version="true"></script>
}
