<div class="body" id="widget-process-status">
    <div class="actions">
        <span class="dot status-bling" id="bling-eng" title="Engine"></span><span class="aux">Eng</span>
        <span class="dot status-bling" id="bling-idx" title="Script index"></span><span class="aux">Idx</span>
        <span class="dot status-bling" id="bling-ops" title="Operations"></span><span class="aux">Ops</span>
        <span class="lbl" style="flex:1">Library State</span>
        <span class="aux mono" id="process-sync-time">--:--:--</span>
    </div>
    <div class="cols">
        <div class="stat"><label>Scripts</label><b id="stat-scripts">0</b></div>
        <div class="stat"><label>Processing</label><b id="stat-active">0</b></div>
        <div class="stat"><label>Total Tasks</label><b id="stat-total">0</b></div>
        <div class="stat"><label>Today</label><b id="stat-today">0</b></div>
    </div>
    <div class="actions"><a href="/Processing/Admin/QueueAdmin" class="btn sm"><i class="fa-solid fa-list-check"></i> Task Manager</a></div>
</div>
