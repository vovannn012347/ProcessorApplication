@using ProcessingModule
@using ProcessingModule.Infrastructure
@using ProcessingModule.Models
@using ProcessingModule.Models.Views
@model PrepareJobViewModel
@{
    ViewData["Title"] = "Configure Job";
}
<div id="prepare-job-wrapper" data-script-id="processor-preparejob">
    <div class="info"><i class="fa-solid fa-list-ol"></i> @string.Join(" → ", Model.SelectedScripts.Select(s => $"{s.ScriptLabel} v{s.ScriptVersion}"))</div>

    <form asp-action="FinalizeStart" method="post" enctype="multipart/form-data" id="jobForm">
        <input type="hidden" name="scriptIds" value="@Model.ScriptIds" />

        <div class="grid">
        @foreach (var input in Model.GroupedInputs)
        {
            var help = string.Join("\n", input.Sources.Select(src => $"{src.ScriptLabel}: {src.Help ?? src.LocalizedDescription}"));
            if (input.DisplayName != input.Label) { help = $"Key: {input.Label}\n{help}"; }
            <div class="card">
                <div class="body">
                    <div class="f">
                        <div>
                            <label>@input.DisplayName</label>
                            @if (!string.IsNullOrWhiteSpace(help))
                            {
                                <span class="tip" tabindex="0" data-tip="@help"></span>
                            }
                            <span class="badge mono" style="float:right">@input.Type</span>
                        </div>
                        @if (input.Type == "boolean")
                        {
                            <label class="f row"><input type="checkbox" name="values[@input.UniqueKey]" value="true" checked="@input.DefaultChecked" /> Enabled</label>
                        }
                        else if (input.Type == "file")
                        {
                            <input type="file" name="files_@input.UniqueKey" data-preview-key="@input.UniqueKey" required />
                        }
                        else if (input.Type == InOutType.InOutFileMultiple)
                        {
                            <input type="file" name="folders_@input.UniqueKey" multiple data-preview-key="@input.UniqueKey" required />
                        }
                        else if (input.Choices.Any())
                        {
                            <select name="values[@input.UniqueKey]">
                                @foreach (var choice in input.Choices)
                                {
                                    <option value="@choice.Value" selected="@(string.Equals(choice.Value, input.Default, StringComparison.OrdinalIgnoreCase))">@choice.Text</option>
                                }
                            </select>
                        }
                        else
                        {
                            var isNumber = input.Type == "integer" || input.Type == "decimal";
                            <input type="@(isNumber ? "number" : "text")" name="values[@input.UniqueKey]"
                                   min="@(isNumber && input.Min.HasValue ? GroupedInputViewModel.Fmt(input.Min) : null)"
                                   max="@(isNumber && input.Max.HasValue ? GroupedInputViewModel.Fmt(input.Max) : null)"
                                   step="@(isNumber ? (input.Step.HasValue ? GroupedInputViewModel.Fmt(input.Step) : (input.Type == "integer" ? "1" : "any")) : null)"
                                   value="@input.Default" placeholder="@(input.Default != null ? $"default: {input.DefaultText}" : $"Enter {input.DisplayName}...")" required="@(!input.Optional && input.Default == null)" />
                        }
                        @if (input.DefaultText != null || input.RangeText != null)
                        {
                            <span class="aux">
                                @if (input.DefaultText != null)
                                {
                                    <span>Default: <b>@input.DefaultText</b></span>
                                }
                                @if (input.DefaultText != null && input.RangeText != null)
                                {
                                    <span> · </span>
                                }
                                @if (input.RangeText != null)
                                {
                                    <span>Range: <b>@input.RangeText</b></span>
                                }
                            </span>
                        }
                    </div>
                    <div id="preview_@input.UniqueKey" class="is-hidden note">
                        <ul style="max-height:96px;overflow-y:auto;margin:0;padding-left:14px"></ul>
                    </div>
                </div>
            </div>
        }
        </div>

        <div class="actions">
            <button type="submit" id="submitBtn" class="btn"><i class="fa-solid fa-play"></i> Start Job</button>
        </div>
    </form>
</div>
@section Scripts {
    <script src="~/processing/js/pages/home/prepare-job.js" asp-append-version="true"></script>
}
