@using ProcessingModule
@using ProcessingModule.Database.Models
@using ProcessingModule.Models
@model List<OrchestratedTask>
@{
    ViewData["Title"] = "Processing History";
}

@functions {
    string GetStatusClass(string status) => status switch
    {
        "Complete" => "badge ok",
        "Running" => "badge ok",
        "Error" => "badge bad",
        "ServerError" => "badge bad",
        "Paused" => "badge warn",
        "Warning" => "badge warn",
        _ => "badge"
    };
}

<div id="queue-page-wrapper" data-script-id="processor-queue">
    <div class="card">
        <div class="body">
            <table class="t">
                <thead>
                    <tr><th>Task</th><th>Status</th><th>Started</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.OrderByDescending(j => j.CreatedTime))
                    {
                        <tr>
                            <td>
                                <b>TASK-@job.Id.ToString().ToUpper().Substring(0, 8)</b>
                                <div class="mono aux wrap">@job.PhysicalPathRoot</div>
                            </td>
                            <td>
                                @if (job.Status == "Running")
                                {
                                    <span class="dot busy"></span>
                                }
                                <span class="@GetStatusClass(job.Status)">@job.Status</span>
                            </td>
                            <td class="mono nowrap aux">@job.CreatedTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="nowrap">
                                @if (job.Status == "Running")
                                {
                                    <button onclick="ProcessorQueue.controlTask('@job.Id', 'Pause')" class="icon-btn" title="Pause after the current step"><i class="fa-solid fa-pause"></i></button>
                                    <button onclick="ProcessorQueue.controlTask('@job.Id', 'Stop')" class="icon-btn bad" title="Stop and cancel"><i class="fa-solid fa-stop"></i></button>
                                }
                                else if (new[] { "Paused", "Stopped", "Error" }.Contains(job.Status))
                                {
                                    <button onclick="ProcessorQueue.controlTask('@job.Id', 'Resume')" class="icon-btn" title="Resume"><i class="fa-solid fa-play"></i></button>
                                }
                                <button onclick="ProcessorQueue.toggleRow('steps-@job.Id')" class="btn sm">Steps (@job.SubJobs.Count)</button>
                            </td>
                        </tr>
                        <tr id="steps-@job.Id" class="is-hidden">
                            <td colspan="4">
                                <table class="t">
                                    @foreach (var sub in job.SubJobs.OrderBy(s => s.Sequence))
                                    {
                                        <tr>
                                            <td class="mono aux">#@sub.Sequence.ToString("D2")</td>
                                            <td>
                                                <b>@sub.ScriptId</b>
                                                @if (!string.IsNullOrEmpty(sub.ScriptVersion))
                                                {
                                                    <span class="mono aux" title="Build @sub.ScriptIndexId">v@(sub.ScriptVersion)</span>
                                                }
                                            </td>
                                            <td><span class="@GetStatusClass(sub.Status)">@sub.Status</span></td>
                                            <td>
                                                <button onclick="ProcessorQueue.loadDetails('@job.Id', '@sub.Id', this)" class="icon-btn" title="Details and results"><i class="fa-solid fa-chevron-right" id="icon-@sub.Id"></i></button>
                                            </td>
                                        </tr>
                                        <tr id="details-@sub.Id" class="is-hidden">
                                            <td colspan="4">
                                                <div class="aux loader"><i class="fa-solid fa-spinner fa-spin"></i> Loading results...</div>
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="4" class="aux">No jobs yet.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/processing/js/pages/home/queue.js" asp-append-version="true"></script>
}
