@using System.IO
@using Microsoft.AspNetCore.Authorization
@using ProcessingModule
@using ProcessingModule.Database.Models
@using ProcessingModule.Models
@inject IAuthorizationService AuthorizationService
@model List<ScriptIndex>

@{
    ViewData["Title"] = "Script Library";
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, Context, "AdminLocalPolicy")).Succeeded;
}

<div id="script-page-wrapper" data-script-id="processor-scriptlist">
    <div class="actions">
        <button id="launchBtn" onclick="ProcessorLibrary.submitSelection()" class="btn"><i class="fa-solid fa-play"></i> Run Selected <span id="launchCount"></span></button>
        <span class="tip" tabindex="0" data-tip="Tick one or more scripts (or click their rows) and press Run Selected to prepare a job. The (i) button shows a script's inputs and outputs."></span>
        @if (isAdmin)
        {
            <button id="reindexBtn" onclick="ProcessorLibrary.runReindex(this)" class="btn"><i class="fa-solid fa-arrows-rotate" id="reindexIcon"></i> Reindex Library</button>
            <a href="/Processing/Admin/InstallScript" class="btn"><i class="fa-solid fa-file-zipper"></i> Install Script</a>
        }
    </div>

    <form id="launchForm" asp-action="PrepareJob" method="post" class="is-hidden">
        <input type="hidden" name="selectedScripts" id="selectedScripts" />
    </form>

    <div class="card">
        <div class="body">
            <table class="t">
                <thead>
                    <tr><th></th><th>Script</th><th>Version</th><th>Integrity</th><th></th></tr>
                </thead>
                <tbody id="scriptTableBody">
                    @foreach (var script in Model)
                    {
                        var isAvailable = script.IsAvailable;
                        var hashMatch = script.HashMatch;

                        <tr class="@(!isAvailable ? "aux" : "")" style="cursor:pointer" onclick="ProcessorLibrary.toggleSelectionRow('@script.Id')">
                            <td onclick="event.stopPropagation()">
                                <input type="checkbox" id="chk-@script.Id" data-build-id="@script.Id"
                                       onchange="ProcessorLibrary.toggleScriptId('@script.Id')"
                                       @(isAvailable ? "" : "disabled") />
                            </td>
                            <td>
                                <b>@script.ScriptLabel</b>
                                <div class="mono aux">@script.ScriptIdentifier</div>
                                @if (isAdmin)
                                {
                                    <div class="aux" title="@script.ManifestDirectoryPath"><i class="fa-regular fa-folder-open"></i> @System.IO.Path.GetFileName(script.ManifestDirectoryPath)</div>
                                }
                            </td>
                            <td><span class="badge">v@(string.IsNullOrEmpty(script.ScriptVersion) ? "1.0.0" : script.ScriptVersion)</span></td>
                            <td class="nowrap">
                                @if (!isAvailable)
                                {
                                    <span class="dot bad"></span> <span class="bad-t">Missing / Error</span>
                                }
                                else if (!hashMatch)
                                {
                                    <span class="dot warn"></span> <span class="warn-t" title="Files were modified on disk">Hash Mismatch</span>
                                }
                                else
                                {
                                    <span class="dot ok"></span> <span class="ok-t">Verified</span>
                                }
                            </td>
                            <td onclick="event.stopPropagation()">
                                <button type="button" onclick="ProcessorLibrary.toggleDetails('@script.Id')" class="icon-btn" title="Inputs and outputs"><i class="fa-solid fa-circle-info" id="icon-@script.Id"></i></button>
                            </td>
                        </tr>
                        <tr id="details-@script.Id" class="is-hidden">
                            <td colspan="5">
                                <div id="content-@script.Id" class="aux"><i class="fa-solid fa-spinner fa-spin"></i> Loading inputs...</div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="aux"><i class="fa-solid fa-box-open"></i> No scripts indexed.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/processing/js/pages/home/script-list.js" asp-append-version="true"></script>
}
