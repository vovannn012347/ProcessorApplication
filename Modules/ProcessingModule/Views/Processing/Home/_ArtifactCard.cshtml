@using ProcessingModule
@using ProcessingModule.Models
@using ProcessingModule.Models.Views
@model ArtifactViewModel
@{
    var icon = Model.Extension switch
    {
        ".json" => "fa-file-code",
        ".csv" or ".xlsx" => "fa-file-csv",
        ".pdf" => "fa-file-pdf",
        ".py" or ".sh" => "fa-terminal",
        _ => "fa-file-lines"
    };
}

<div class="card" style="width:170px;margin:0">
    @if (Model.IsImage)
    {
        <a href="/Processing/Files/Get/@Model.Token" target="_blank" title="Open full size">
            <img src="/Processing/Files/Get/@Model.Token" alt="@Model.FileName" loading="lazy" style="display:block;width:100%;height:110px;object-fit:cover" />
        </a>
    }
    else
    {
        <div class="aux" style="height:60px;display:flex;align-items:center;justify-content:center;gap:4px">
            <i class="fa-solid @icon" style="font-size:22px"></i> @Model.Extension.Replace(".", "").ToUpperInvariant()
        </div>
    }
    <div class="body">
        <div class="wrap" title="@Model.FileName"><b>@Model.FileName</b></div>
        <div class="actions">
            <span class="badge" title="@Model.LocalizedType">@Model.LocalizedType</span>
            <a href="/Processing/Files/Get/@Model.Token" download="@Model.FileName" class="icon-btn" title="Download" style="margin-left:auto"><i class="fa-solid fa-download"></i></a>
        </div>
    </div>
</div>
