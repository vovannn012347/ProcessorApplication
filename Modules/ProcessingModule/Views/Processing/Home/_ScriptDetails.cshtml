@using ProcessingModule
@using ProcessingModule.Models
@using ProcessingModule.Models.Views
@model ScriptDetailsViewModel

<div class="cols">
    <div>
        <h3><i class="fa-solid fa-right-to-bracket"></i> Inputs</h3>
        @if (Model.Inputs.Any())
        {
            <table class="t">
                @foreach (var input in Model.Inputs)
                {
                    <tr>
                        <td><b>@input.DisplayName</b>@if (!string.IsNullOrEmpty(input.Description)) { <div class="aux">@input.Description</div> }</td>
                        <td><span class="badge mono">@input.Type</span></td>
                    </tr>
                }
            </table>
        }
        else
        {
            <span class="aux">No user inputs required.</span>
        }
    </div>
    <div>
        <h3><i class="fa-solid fa-right-from-bracket"></i> Outputs</h3>
        <table class="t">
            @foreach (var output in Model.Outputs)
            {
                <tr>
                    <td><b>@output.DisplayName</b>@if (!string.IsNullOrEmpty(output.Description)) { <div class="aux">@output.Description</div> }</td>
                    <td><span class="badge mono">@output.Type</span></td>
                </tr>
            }
        </table>
    </div>
</div>
