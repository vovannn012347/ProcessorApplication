@using ProcessingModule
@using ProcessingModule.Models
@using ProcessingModule.Models.Views
@model SubJobDetailsViewModel

<div>
@if (!string.IsNullOrEmpty(Model.ResultMessage))
{
    <div class="msg warn"><b><i class="fa-solid fa-bug"></i> Step failed</b><div class="mono wrap">@Model.ResultMessage</div></div>
}

<div class="grid">
    <div class="span-2">
        <h3>Execution Trace</h3>
        @if (!string.IsNullOrEmpty(Model.SummaryJson))
        {
            <pre class="mono wrap note" style="max-height:256px;overflow:auto;margin:0">@Model.SummaryJson</pre>
        }
        else
        {
            <span class="aux">No trace.</span>
        }
    </div>
    <div>
        <h3>Parameters</h3>
        @foreach (var input in Model.ScalarInputs)
        {
            <div class="f"><label>@input.LocalizedLabel</label><span class="mono wrap">@input.Value</span></div>
        }
        @if (!Model.ScalarInputs.Any())
        {
            <span class="aux">No scalars provided.</span>
        }
    </div>
</div>

@if (Model.DirectOutputs.Any())
{
    <h3>Results</h3>
    <div class="grid">
        @foreach (var output in Model.DirectOutputs)
        {
            <div class="stat"><label title="@output.LocalizedLabel">@output.LocalizedLabel</label><b class="mono">@output.Value</b></div>
        }
    </div>
}

@if (Model.ExplicitArtifacts.Any())
{
    <h3>Output Files</h3>
    <div class="actions" style="align-items:stretch">
        @foreach (var art in Model.ExplicitArtifacts)
        {
            <partial name="_ArtifactCard" model="art" />
        }
    </div>
}
@if (Model.InputArtifacts.Any())
{
    <h3>Input Files</h3>
    <div class="actions" style="align-items:stretch">
        @foreach (var art in Model.InputArtifacts)
        {
            <partial name="_ArtifactCard" model="art" />
        }
    </div>
}
@if (Model.InternalArtifacts.Any())
{
    <h3>Supporting Files <span class="tip" tabindex="0" data-tip="Internal files produced along the way (logs, manifests, intermediate data)."></span></h3>
    <div class="actions" style="align-items:stretch">
        @foreach (var art in Model.InternalArtifacts)
        {
            <partial name="_ArtifactCard" model="art" />
        }
    </div>
}
</div>
