@using ProcessingModule
@using ProcessingModule.Models
@using ProcessingModule.Models.Views
@model ProcessorSettingsViewModel;
@inject ProcessingModule.Services.Sandboxing.SandboxReadiness SandboxCheck
@{
    ViewData["Title"] = "Processor Configuration";
}

<div id="processor-settings-wrapper" data-script-id="processor-settings">
    <div id="settings-messages">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="msg ok"><i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]</div>
        }
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="msg warn">
                <b><i class="fa-solid fa-triangle-exclamation"></i> Configuration errors</b>
                <ul>
                    @foreach (var state in ViewData.ModelState.Values)
                    {
                        foreach (var error in state.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>
        }
    </div>

    @* asp-action must be SaveProcessor: "Settings" alone may hit the SettingsController of another module *@
    <form id="processorSettingsForm" asp-controller="Settings" asp-action="SaveProcessor" method="post">
        <div class="grid">
            <div class="card">
                <h2>Storage & Limits</h2>
                <div class="body"><partial name="_GeneralTabPartial" for="General" /></div>
            </div>
            <div class="card">
                <h2>Python Executor</h2>
                <div class="body"><partial name="_PythonTabPartial" for="Python" /></div>
            </div>
        </div>

        <div class="card">
            <h2>Isolation <span class="tip" tabindex="0" data-tip="How scripts are run: None = as the app's own account; OS User = as a separate low-privilege worker account (Windows and Linux). Docker is not available."></span></h2>
            <div class="body">
                <div class="f" style="max-width:260px">
                    <label asp-for="General.SandboxingType"></label>
                    <select asp-for="General.SandboxingType">
                        <option value="None">None (in-process account)</option>
                        <option value="OSUser">OS User (Linux/Windows)</option>
                        @* <option value="Docker">Docker Container</option> *@
                    </select>
                </div>
                <div class="actions">
                    <label class="f row"><input asp-for="General.RequireSandboxing" /> Require sandboxing <span class="tip" tabindex="0" data-tip="While the last OS-user check failed (at startup or Check Status), script steps end in Error instead of starting. A passing Check Status lets them run again; never-checked doesn't block."></span></label>
                    <label class="f row"><input asp-for="General.ValidateSandboxOnStartup" /> Check on startup <span class="tip" tabindex="0" data-tip="A few seconds after the app starts, runs the same check as Check Status (OS User mode only) and writes it to the log."></span></label>
                </div>
                @if (SandboxCheck.CheckedUtc != null)
                {
                    <div class="note">
                        Last check (@SandboxCheck.Source, @SandboxCheck.CheckedUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")):
                        @if (SandboxCheck.Ok == true)
                        {
                            <span class="badge ok">passed</span>
                        }
                        else
                        {
                            <span class="badge bad">failed</span>
                            <span class="val">@string.Join(" ", SandboxCheck.Failures.Take(3))</span>
                        }
                        @if (SandboxCheck.WarningCount > 0)
                        {
                            <span class="badge warn">@SandboxCheck.WarningCount warning(s)</span>
                        }
                    </div>
                }
                <partial name="_OsSandboxPartial" for="OsSandbox" />
                @* <partial name="_DockerSandboxPartial" for="DockerSandbox" /> *@
            </div>
        </div>

        <div class="actions">
            <button type="submit" id="saveSettingsButton" class="btn"><i class="fa-solid fa-floppy-disk"></i> Save Configuration</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/processing/js/pages/settings/index.js" asp-append-version="true"></script>
}
