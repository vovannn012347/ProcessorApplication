@using ProcessingModule
@using ProcessingModule.Configuration
@using ProcessingModule.Models
@model ProcessorSettings

<div class="f">
    <div><label asp-for="ScriptSourcePath"></label> <span class="tip" tabindex="0" data-tip="Folder with the installed scripts. Re-run Setup User after moving it (OS User mode)."></span></div>
    <input asp-for="ScriptSourcePath" class="mono" />
    <span asp-validation-for="ScriptSourcePath" class="warn-t"></span>
</div>
<div class="f">
    <div><label asp-for="ResultsOutputPath"></label> <span class="tip" tabindex="0" data-tip="Folder where every job gets its own folder with inputs and results. Re-run Setup User after moving it (OS User mode)."></span></div>
    <input asp-for="ResultsOutputPath" class="mono" />
    <span asp-validation-for="ResultsOutputPath" class="warn-t"></span>
</div>
<div class="cols">
    <div class="f">
        <div><label asp-for="MaxConcurrentJobs"></label> <span class="tip" tabindex="0" data-tip="Scripts running at the same time. With OS User mode all of them run as the same worker, so 1 keeps jobs from reaching each other's folders."></span></div>
        <input asp-for="MaxConcurrentJobs" type="number" />
    </div>
    <div class="f">
        <div><label asp-for="JobTimeoutMinutes"></label> <span class="tip" tabindex="0" data-tip="A step running longer is stopped (OS User mode, Windows and Linux). 0 = no limit."></span></div>
        <input asp-for="JobTimeoutMinutes" type="number" step="0.5" />
    </div>
</div>
