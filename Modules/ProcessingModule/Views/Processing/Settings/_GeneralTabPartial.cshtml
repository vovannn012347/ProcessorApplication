@using ProcessingModule
@using ProcessingModule.Configuration
@using ProcessingModule.Models
@model ProcessorSettings

<div class="f">
    <div><label asp-for="ScriptSourcePath"></label> <span class="tip" tabindex="0" data-tip="Folder with the installed scripts. Re-run Setup User after moving it (OS User mode)."></span></div>
    <input asp-for="ScriptSourcePath" class="mono" />
    <span asp-validation-for="ScriptSourcePath" class="warn-t"></span>
</div>
<div class="f">
    <div><label asp-for="ResultsOutputPath"></label> <span class="tip" tabindex="0" data-tip="Folder where every job gets its own folder with inputs and results. Re-run Setup User after moving it (OS User mode)."></span></div>
    <input asp-for="ResultsOutputPath" class="mono" />
    <span asp-validation-for="ResultsOutputPath" class="warn-t"></span>
</div>
<div class="cols">
    <div class="f">
        <div><label asp-for="MaxConcurrentJobs"></label> <span class="tip" tabindex="0" data-tip="Scripts running at the same time. With OS User mode all of them run as the same worker, so 1 keeps jobs from reaching each other's folders."></span></div>
        <input asp-for="MaxConcurrentJobs" type="number" />
    </div>
    <div class="f">
        <div><label asp-for="JobTimeoutMinutes"></label> <span class="tip" tabindex="0" data-tip="A step running longer is stopped (OS User mode, Windows and Linux). 0 = no limit."></span></div>
        <input asp-for="JobTimeoutMinutes" type="number" step="0.5" />
    </div>
</div>

<h3>Script Package Upload <span class="tip" tabindex="0" data-tip="Limits for packages installed on the Install Script page and through Script Exchange. Bytes actually written while extracting are counted, not the sizes the archive claims."></span></h3>
<div class="cols">
    <div class="f">
        <div><label asp-for="MaxScriptUploadMb"></label> <span class="tip" tabindex="0" data-tip="Largest .zip the upload accepts."></span></div>
        <input asp-for="MaxScriptUploadMb" type="number" />
        <span asp-validation-for="MaxScriptUploadMb" class="warn-t"></span>
    </div>
    <div class="f">
        <div><label asp-for="MaxScriptExtractedMb"></label> <span class="tip" tabindex="0" data-tip="Total size a package may extract to."></span></div>
        <input asp-for="MaxScriptExtractedMb" type="number" />
        <span asp-validation-for="MaxScriptExtractedMb" class="warn-t"></span>
    </div>
    <div class="f">
        <div><label asp-for="MaxScriptEntryMb"></label> <span class="tip" tabindex="0" data-tip="Largest single file inside a package."></span></div>
        <input asp-for="MaxScriptEntryMb" type="number" />
        <span asp-validation-for="MaxScriptEntryMb" class="warn-t"></span>
    </div>
    <div class="f">
        <div><label asp-for="MaxScriptArchiveEntries"></label> <span class="tip" tabindex="0" data-tip="Most files and folders a package may contain."></span></div>
        <input asp-for="MaxScriptArchiveEntries" type="number" />
        <span asp-validation-for="MaxScriptArchiveEntries" class="warn-t"></span>
    </div>
    <div class="f">
        <div><label asp-for="MaxScriptCompressionRatio"></label> <span class="tip" tabindex="0" data-tip="Largest expansion of one file (extracted / compressed), checked after its first MB. Normal code compresses 3-10x."></span></div>
        <input asp-for="MaxScriptCompressionRatio" type="number" />
        <span asp-validation-for="MaxScriptCompressionRatio" class="warn-t"></span>
    </div>
</div>
