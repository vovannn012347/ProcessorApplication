@using ProcessingModule
@using ProcessingModule.Configuration
@using ProcessingModule.Models
@model OsSandboxSettings

<div class="grid">
    <div>
        <div class="cols">
            <div class="f">
                <div><label asp-for="UserName"></label> <span class="tip" tabindex="0" data-tip="The worker account scripts run as. 1-13 characters (Windows adds -rights for a second account)."></span></div>
                <input asp-for="UserName" />
                <span asp-validation-for="UserName" class="warn-t"></span>
            </div>
            <div class="f">
                <div><label asp-for="GroupName"></label> <span class="tip" tabindex="0" data-tip="Linux: the sandbox group shared by the app and the worker. Windows: only checked."></span></div>
                <input asp-for="GroupName" />
            </div>
        </div>
        <div class="f row">
            <input asp-for="AllowNetwork" type="checkbox" />
            <label asp-for="AllowNetwork"></label> <span class="tip" tabindex="0" data-tip="Off: Setup User blocks all network traffic of the worker (Linux: loopback too; Windows doesn't filter loopback). Run Setup User again after changing it."></span>
        </div>
        <div class="f row">
            <input asp-for="ProtectNodeHome" type="checkbox" />
            <label asp-for="ProtectNodeHome"></label> <span class="tip" tabindex="0" data-tip="Windows: Setup User denies the worker reading the node's folder (databases, node.key, settings); the script, results and executor folders stay readable. Check Status tries to read node.key as the worker. Run Setup User again after changing it. Linux: the node home is protected by its own permissions (keep it 750)."></span>
        </div>
        <div class="cols">
            <div class="f">
                <div><label asp-for="MemoryLimitMb"></label> <span class="tip" tabindex="0" data-tip="Memory for one step, all its processes together. 0 = no limit. Windows only for now."></span></div>
                <input asp-for="MemoryLimitMb" type="number" min="0" />
                <span asp-validation-for="MemoryLimitMb" class="warn-t"></span>
            </div>
            <div class="f">
                <div><label asp-for="CpuLimitPercent"></label> <span class="tip" tabindex="0" data-tip="Hard CPU cap for one step, in percent of the whole machine. 0 = no limit. Windows only for now."></span></div>
                <input asp-for="CpuLimitPercent" type="number" min="0" max="100" />
                <span asp-validation-for="CpuLimitPercent" class="warn-t"></span>
            </div>
        </div>
        <div class="actions">
            <button type="button" class="btn sm" onclick="launchStream('/Processing/Settings/StreamOsStatusCheck')"><i class="fa-solid fa-stethoscope"></i> Check Status</button>
            <button type="button" class="btn sm" onclick="launchStream('/Processing/Settings/StreamOsProvisioning')"><i class="fa-solid fa-user-gear"></i> Setup User</button>
            <span class="tip" tabindex="0" data-tip="@(OperatingSystem.IsWindows() ? "Windows: Setup User creates the worker and a NAME-rights account (UAC prompts), sets folder permissions and the firewall rules. Passwords are random and stored encrypted for the account the app runs as." : "Linux: names are used in lower case. Setup User needs root once: it runs the setup directly if the app may use sudo without a password, otherwise it prints the exact sudo bash ... command to run in a terminal. Restart the app afterwards. No passwords are stored.")"></span>
        </div>
    </div>
    <div id="osLogWrapper" class="is-hidden">
        <div class="actions"><span class="lbl" style="flex:1">Setup log</span><span id="osLogStatus" class="aux">Active</span></div>
        <textarea id="osLogOutput" readonly rows="12" class="mono" style="width:100%;font-size:11px" placeholder="Logs will appear here..."></textarea>
    </div>
</div>

<script>
    let currentEventSource = null;

    function launchStream(url) {
        const wrapper = document.getElementById('osLogWrapper');
        const output = document.getElementById('osLogOutput');
        const status = document.getElementById('osLogStatus');

        if (currentEventSource) currentEventSource.close();

        wrapper.classList.remove('is-hidden');
        output.value = `[${new Date().toLocaleTimeString()}] Establishing connection...\n`;
        status.innerText = "Processing...";
        status.className = "info";

        currentEventSource = new EventSource(url);
        currentEventSource.onmessage = function (event) {
            if (event.data === "[DONE]") {
                status.innerText = "Complete";
                status.className = "badge ok";
                output.value += "\n>>> OPERATION FINISHED.";
                currentEventSource.close();
            } else {
                output.value += event.data + "\n";
                output.scrollTop = output.scrollHeight;
            }
        };
        currentEventSource.onerror = function () {
            status.innerText = "Stream Error";
            status.className = "badge bad";
            output.value += "\n[CRITICAL] Connection lost or access denied.";
            currentEventSource.close();
        };
    }
</script>
