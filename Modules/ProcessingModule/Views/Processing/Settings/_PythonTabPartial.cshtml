@using ProcessingModule
@using ProcessingModule.Configuration
@using ProcessingModule.Models
@model PythonProcessingSettings

<div class="pm-grid pm-grid-cols-1 md:pm-grid-cols-3 pm-gap-6 pm-items-end">
    <div class="md:pm-col-span-2 pm-space-y-1">
        <label asp-for="PythonExecutablePath" class="pm-block pm-text-sm pm-font-medium pm-text-slate-700"></label>
        <input asp-for="PythonExecutablePath" placeholder="e.g. /usr/bin/python3" class="pm-w-full pm-rounded-lg pm-border-slate-300 pm-font-mono pm-text-sm" />
    </div>
    <div class="pm-flex pm-items-center pm-gap-2 pm-pb-3 pm-px-2">
        <input asp-for="LogStdout" type="checkbox" class="pm-rounded pm-text-indigo-600 focus:pm-ring-indigo-500" />
        <label asp-for="LogStdout" class="pm-text-sm pm-text-slate-600 pm-font-medium"></label>
    </div>
</div>