<div class="container mx-auto p-6 bg-slate-50 min-h-screen">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-black text-slate-800 uppercase tracking-tighter">Library Reindexing Console</h1>
            <p class="text-xs text-slate-500 font-mono">Status: <span id="statusText" class="text-indigo-600 animate-pulse">Initializing stream...</span></p>
        </div>
        <a href="/Processor/Home/ScriptList" class="text-[10px] font-bold uppercase tracking-widest text-slate-400 hover:text-slate-600 transition-colors">
            <i class="fa-solid fa-arrow-left mr-1"></i> Return to Library
        </a>
    </div>

    <div class="relative">
        <div class="absolute top-3 right-4 flex gap-2">
            <div class="w-2 h-2 rounded-full bg-red-400"></div>
            <div class="w-2 h-2 rounded-full bg-yellow-400"></div>
            <div class="w-2 h-2 rounded-full bg-green-400"></div>
        </div>
        <textarea id="consoleOutput" readonly
                  class="w-full h-[70vh] bg-slate-900 text-indigo-300 font-mono text-[11px] p-6 rounded-xl border border-slate-800 shadow-2xl resize-none focus:outline-none overflow-y-auto"
                  placeholder="Establishing connection to indexing engine..."></textarea>
    </div>
</div>

<script>
    const output = document.getElementById('consoleOutput');
    const statusParagraph = document.getElementById('statusText');

    // Establish Server-Sent Events connection
    const eventSource = new EventSource('/Processor/Admin/ConsecutiveReindex');

    eventSource.onmessage = function(event) {
        if (event.data === "[DONE]") {
            statusParagraph.innerText = "Indexing Complete";
            statusParagraph.classList.remove('animate-pulse', 'text-indigo-600');
            statusParagraph.classList.add('text-green-600');
            output.value += "\n\r>>> REINDEXING PROCESS FINISHED SUCCESSFULLY.";
            eventSource.close();
        } else {
            statusParagraph.innerText = "Processing...";
            output.value += event.data + "\n";
            // Auto-scroll
            output.scrollTop = output.scrollHeight;
        }
    };

    eventSource.onerror = function(err) {
        statusParagraph.innerText = "Connection Lost / Error";
        statusParagraph.classList.add('text-red-600');
        output.value += "\n\r[CRITICAL ERROR] The stream was interrupted. Check server logs.";
        output.value += "\n\r" + err;
        eventSource.close();
    };
</script>