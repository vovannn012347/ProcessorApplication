@using ProcessorModule.Database.Models
@model List<OrchestratedTask>

<link rel="stylesheet" href="/Processor/css/output.css" asp-append-version="true" />

@functions {
    string GetStatusClass(string status) => status switch
    {
        "Complete" => "bg-green-50 text-green-700 border-green-200",
        "Running" => "bg-blue-50 text-blue-700 border-blue-200 animate-pulse",
        "Error" => "bg-red-50 text-red-700 border-red-200",
        "Paused" => "bg-amber-50 text-amber-700 border-amber-200",
        "Stopped" => "bg-slate-50 text-slate-500 border-slate-200",
        _ => "bg-slate-50 text-slate-500 border-slate-200"
    };
}

<div class="container mx-auto mt-8 px-2 max-w-5xl">
    <div class="flex justify-between items-end mb-6">
        <div>
            <h2 class="text-2xl font-black text-slate-800 tracking-tight">Processing History</h2>
            <p class="text-[10px] text-slate-400 uppercase font-bold tracking-widest">Active and Archived Orchestrations</p>
        </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-sm">
        <table class="min-w-full divide-y divide-slate-100">
            <thead class="bg-slate-50/50">
                <tr>
                    <th class="px-6 py-4 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Task Identity</th>
                    <th class="px-6 py-4 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Current Status</th>
                    <th class="px-6 py-4 text-left text-[10px] font-black text-slate-400 uppercase tracking-widest">Initiated</th>
                    <th class="px-6 py-4 text-right text-[10px] font-black text-slate-400 uppercase tracking-widest">Management</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var job in Model.OrderByDescending(j => j.CreatedTime))
                {
                    <tr class="hover:bg-slate-50/30 transition-colors group">
                        <td class="px-6 py-4">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-slate-700">TASK-@job.Id.ToString().ToUpper().Substring(0, 8)</span>
                                <span class="text-[8px] font-mono text-slate-400">@job.PhysicalPathRoot</span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="px-2.5 py-1 border rounded-full text-[9px] font-black uppercase tracking-tighter @GetStatusClass(job.Status)">
                                @job.Status
                            </span>
                        </td>
                        <td class="px-6 py-4 text-[10px] font-bold text-slate-500">
                            @job.CreatedTime.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td class="px-6 py-4 text-right space-x-2">
                            @* Action Buttons *@
                            @if (job.Status == "Running")
                            {
                                <button onclick="controlTask('@job.Id', 'Pause')" class="p-2 text-amber-500 hover:bg-amber-50 rounded-lg transition-colors" title="Pause after current step">
                                    <i class="fa-solid fa-pause text-xs"></i>
                                </button>
                                <button onclick="controlTask('@job.Id', 'Stop')" class="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors" title="Stop and Cancel">
                                    <i class="fa-solid fa-stop text-xs"></i>
                                </button>
                            }
                            //XUY
                            else if (new[] { "Paused", "Stopped", "Error" }.Contains(job.Status))
                            {
                                <button onclick="controlTask('@job.Id', 'Resume')" class="p-2 text-green-600 hover:bg-green-50 rounded-lg transition-colors" title="Resume sequence">
                                    <i class="fa-solid fa-play text-xs"></i>
                                </button>
                            }

                            <button onclick="toggleRow('steps-@job.Id')" class="px-4 py-1.5 bg-slate-100 hover:bg-indigo-600 hover:text-white rounded-lg text-[10px] font-black uppercase transition-all">
                                Steps (@job.SubJobs.Count)
                            </button>
                        </td>
                    </tr>

                    <tr id="steps-@job.Id" class="hidden bg-slate-50/50">
                        <td colspan="4" class="p-0 border-l-4 border-indigo-500">
                            <div class="divide-y divide-slate-100">
                                @foreach (var sub in job.SubJobs.OrderBy(s => s.Sequence))
                                {
                                    <div class="flex items-center justify-between px-8 py-3 hover:bg-white transition-colors">
                                        <div class="flex items-center gap-4">
                                            <span class="text-[10px] font-black text-slate-300 font-mono">#@sub.Sequence.ToString("D2")</span>
                                            <span class="text-xs font-bold text-slate-700">@sub.ScriptId</span>
                                        </div>
                                        <div class="flex items-center gap-6">
                                            <span class="text-[8px] font-black uppercase px-2 py-0.5 border rounded @GetStatusClass(sub.Status)">@sub.Status</span>
                                            <button onclick="loadDetails('@job.Id', '@sub.Id', this)" class="text-indigo-500 hover:text-indigo-700">
                                                <i class="fa-solid fa-chevron-right text-[10px]" id="icon-@sub.Id"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div id="details-@sub.Id" class="hidden bg-white border-y border-slate-100">
                                        @* AJAX Target for _SubJobDetails.cshtml [cite: 22, 23, 24] *@
                                        <div class="p-8 flex items-center justify-center gap-3 loader">
                                            <div class="w-1.5 h-1.5 bg-indigo-500 rounded-full animate-bounce"></div>
                                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Extracting Artifacts...</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    function toggleRow(id) {
        document.getElementById(id).classList.toggle('hidden');
    }

    async function controlTask(id, action) {
        if (!confirm(`Are you sure you want to ${action} this task?`)) return;
        await fetch(`/Processor/Home/${action}Job?id=${id}`, { method: 'POST' });
        location.reload();
    }

    async function loadDetails(parentId, subId, btn) {
        const container = document.getElementById('details-' + subId);
        const icon = document.getElementById('icon-' + subId);

        if (container.classList.contains('hidden')) {
            container.classList.remove('hidden');
            icon.classList.replace('fa-chevron-right', 'fa-chevron-down');

            if (container.querySelector('.loader')) {
                const response = await fetch(`/Processor/Home/GetSubJobDetails?subJobId=${subId}`);
                container.innerHTML = await response.text();
            }
        } else {
            container.classList.add('hidden');
            icon.classList.replace('fa-chevron-down', 'fa-chevron-right');
        }
    }
</script>