@using ProcessorModule.Database.Models
@using Microsoft.AspNetCore.Authorization
@using System.IO
@inject IAuthorizationService AuthorizationService
@model List<ScriptIndex>

@{
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, Context, "AdminLocalPolicy")).Succeeded;
}

<link rel="stylesheet" href="/Processor/css/output.css" asp-append-version="true" />

<div id="script-page-wrapper" class="container mx-auto mt-4 px-1">

    @* --- Header & Action Bar --- *@
    <div class="flex justify-between items-start mb-4 gap-4">
        <div class="flex-1">
            <h2 class="text-xl font-bold text-slate-800 leading-tight">Medical Analysis Library</h2>
            <p class="text-[10px] text-slate-400 mt-0.5 uppercase tracking-widest font-semibold">Algorithm Inventory</p>

            @* Button is now active by default to avoid state-flip bugs *@
            <button id="launchBtn" onclick="submitSelection()"
                    class="mt-4 bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-2.5 rounded-lg text-[10px] font-black shadow-md transition-all flex items-center gap-2 uppercase tracking-widest">
                <i class="fa-solid fa-play text-[8px]"></i>
                Run Selected
            </button>
        </div>

        <div class="flex flex-col items-end pt-1">
            <div class="h-6"></div>
            @if (isAdmin)
            {
                <button id="reindexBtn" onclick="runReindex()"
                        class="bg-white border border-slate-200 hover:border-indigo-300 text-slate-500 px-6 py-2.5 rounded-lg text-[10px] font-black transition-all flex items-center gap-2 uppercase tracking-widest shadow-sm">
                    <i class="fa-solid fa-arrows-rotate" id="reindexIcon"></i>
                    Reindex Library
                </button>
            }
        </div>
    </div>

    <form id="launchForm" asp-action="PrepareJob" method="post" class="hidden">
        <input type="hidden" name="selectedScripts" id="selectedScripts" />
    </form>

    @* --- Compact Script Table --- *@
    <div class="bg-white border border-slate-200 rounded-lg overflow-hidden shadow-sm">
        <table class="min-w-full divide-y divide-slate-100">
            <thead class="bg-slate-50">
                <tr class="divide-x divide-slate-100">
                    <th class="w-12 px-2 py-3"></th>
                    <th class="px-4 py-3 text-left text-[9px] font-bold text-slate-400 uppercase tracking-tighter">Identity & Location</th>
                    <th class="w-24 px-4 py-3 text-left text-[9px] font-bold text-slate-400 uppercase tracking-tighter">Version</th>
                    <th class="w-32 px-4 py-3 text-left text-[9px] font-bold text-slate-400 uppercase tracking-tighter">Integrity Status</th>
                    <th class="w-12 px-2 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100" id="scriptTableBody">
                @foreach (var script in Model)
                {
                    var isAvailable = script.IsAvailable;
                    var hashMatch = script.HashMatch;

                    <tr class="group hover:bg-slate-50/50 transition-colors cursor-pointer @(!isAvailable ? "opacity-60" : "")"
                        onclick="toggleSelectionRow('@script.ScriptIdentifier')">
                        <td class="px-2 py-3 text-center" onclick="event.stopPropagation()">
                            <input type="checkbox" id="chk-@script.ScriptIdentifier"
                                   onchange="toggleScriptId('@script.ScriptIdentifier')"
                                   @(isAvailable ? "" : "disabled")
                                   class="h-4 w-4 text-indigo-600 border-slate-300 rounded focus:ring-indigo-500 cursor-pointer disabled:cursor-not-allowed" />
                        </td>
                        <td class="px-4 py-3">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-slate-800 group-hover:text-indigo-600 transition-colors">@script.ScriptLabel</span>
                                <span class="text-[8px] font-mono text-slate-400 leading-none mt-1">ID: @script.ScriptIdentifier</span>
                                @if (isAdmin)
                                {
                                    <span class="text-[7px] text-slate-300 mt-1 truncate max-w-[200px]" title="@script.ManifestDirectoryPath">
                                        <i class="fa-regular fa-folder-open mr-1"></i>@System.IO.Path.GetFileName(script.ManifestDirectoryPath)
                                    </span>
                                }
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="text-[9px] font-bold text-slate-500 px-2 py-0.5 bg-slate-100/50 border border-slate-200 rounded">
                                v@(string.IsNullOrEmpty(script.ScriptVersion) ? "1.0.0" : script.ScriptVersion)
                            </span>
                        </td>
                        <td class="px-4 py-3">
                            @if (!isAvailable)
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                                    <span class="text-[9px] text-red-600 font-bold uppercase tracking-widest">Missing / Error</span>
                                </div>
                            }
                            else if (!hashMatch)
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                                    <span class="text-[9px] text-amber-600 font-bold uppercase tracking-widest" title="Files modified on disk">Hash Mismatch</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    <span class="text-[9px] text-emerald-600 font-bold uppercase tracking-widest">Verified Active</span>
                                </div>
                            }
                        </td>
                        <td class="px-2 py-3 text-right" onclick="event.stopPropagation()">
                            <button onclick="toggleDetails('@script.Id', '@script.ScriptIdentifier')" class="text-slate-300 hover:text-indigo-500 p-1">
                                <i class="fa-solid fa-circle-info text-[11px]" id="icon-@script.Id"></i>
                            </button>
                        </td>
                    </tr>

                    <tr id="details-@script.Id" class="hidden bg-slate-50/30">
                        <td colspan="5" class="p-0 border-l-2 border-indigo-400">
                            <div id="content-@script.Id" class="px-12 py-3">
                                <div class="flex items-center gap-2 animate-pulse">
                                    <div class="w-1 h-1 bg-indigo-400 rounded-full"></div>
                                    <span class="text-[9px] text-slate-400 uppercase font-bold tracking-widest">Retrieving inputs...</span>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="py-12 text-center">
                            <i class="fa-solid fa-box-open text-slate-200 text-3xl mb-3"></i>
                            <p class="text-[10px] text-slate-400 uppercase font-bold tracking-widest">No scripts indexed in library</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    let selectedScriptIds = [];

    function toggleScriptId(id) {
        const index = selectedScriptIds.indexOf(id);
        if (index === -1) {
            selectedScriptIds.push(id);
        } else {
            selectedScriptIds.splice(index, 1);
        }
    }

    function toggleSelectionRow(id) {
        const chk = document.getElementById('chk-' + id);
        if (chk && !chk.disabled) {
            chk.checked = !chk.checked;
            toggleScriptId(id);
        }
    }

    function submitSelection() {
        if (selectedScriptIds.length === 0) {
            alert("Please select at least one script from the library to proceed.");
            return;
        }

        const form = document.getElementById('launchForm');
        document.getElementById('selectedScripts').value = selectedScriptIds.join(',');
        form.submit();
    }

    async function toggleDetails(id, scriptIdentifier) {
        const row = document.getElementById('details-' + id);
        const content = document.getElementById('content-' + id);
        const icon = document.getElementById('icon-' + id);

        if (row.classList.contains('hidden')) {
            row.classList.remove('hidden');
            icon.classList.add('text-indigo-500');
            try {
                const response = await fetch(`/Processor/Home/GetScriptDetails?scriptIdentifier=${scriptIdentifier}`);
                content.innerHTML = await response.text();
            } catch (err) {
                content.innerHTML = '<span class="text-[9px] text-red-400">Error loading details.</span>';
            }
        } else {
            row.classList.add('hidden');
            icon.classList.remove('text-indigo-500');
        }
    }

    function runReindex() {
        const icon = document.getElementById('reindexIcon');
        icon.classList.add('fa-spin');
        window.location.href = '/Processor/Admin/ReindexLogs';
    }
</script>