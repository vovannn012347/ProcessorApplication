@using ProcessorModule.Models.Views
@model ArtifactViewModel

<div class="w-44 group flex flex-col bg-white border border-slate-200 rounded-2xl overflow-hidden hover:border-indigo-400 transition-all shadow-sm hover:shadow-md">
    @if (Model.IsImage)
    {
        <div class="relative h-32 bg-slate-100 overflow-hidden">
            <img src="/Processor/Files/Get/@Model.Token"
                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                 alt="@Model.FileName"
                 loading="lazy" />
            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <a href="/Processor/Files/Get/@Model.Token" target="_blank" class="p-2 bg-white rounded-full text-slate-800 shadow-lg hover:bg-indigo-500 hover:text-white transition-colors">
                    <i class="fa-solid fa-magnifying-glass-plus text-xs"></i>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="h-32 flex flex-col items-center justify-center bg-slate-50 text-slate-300 group-hover:bg-indigo-50 group-hover:text-indigo-400 transition-colors">
            @{
                var icon = Model.Extension switch
                {
                    ".json" => "fa-file-code",
                    ".csv" or ".xlsx" => "fa-file-csv",
                    ".pdf" => "fa-file-pdf",
                    ".py" or ".sh" => "fa-terminal",
                    _ => "fa-file-lines"
                };
            }
            <i class="fa-solid @icon text-3xl mb-2 transition-transform group-hover:scale-110"></i>
            <span class="text-[9px] font-black uppercase opacity-60">@Model.Extension.Replace(".", "") Asset</span>
        </div>
    }

    <div class="p-3 bg-white">
        <span class="block text-[10px] font-bold text-slate-700 truncate mb-2" title="@Model.FileName">@Model.FileName</span>
        <div class="flex justify-between items-center">
            <span class="text-[8px] font-black text-slate-300 uppercase bg-slate-50 px-1.5 py-0.5 rounded border border-slate-100 truncate max-w-[80px]" title="@Model.LocalizedType">@Model.LocalizedType</span>
            <a href="/Processor/Files/Get/@Model.Token" download="@Model.FileName" class="w-7 h-7 flex items-center justify-center bg-indigo-50 text-indigo-500 rounded-lg hover:bg-indigo-500 hover:text-white transition-all shadow-sm">
                <i class="fa-solid fa-download text-[10px]"></i>
            </a>
        </div>
    </div>
</div>