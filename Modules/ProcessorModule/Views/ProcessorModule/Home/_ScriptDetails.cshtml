@using ProcessorModule.Models.Views
@model ScriptDetailsViewModel

<div class="grid grid-cols-2 gap-8 text-[10px]">
    @* --- Inputs Section --- *@
    <div>
        <h4 class="text-slate-400 font-black uppercase tracking-widest mb-3 flex items-center gap-2">
            <i class="fa-solid fa-right-to-bracket text-indigo-400"></i>
            User Parameters
        </h4>
        @if (Model.Inputs.Any())
        {
            <div class="space-y-2">
                @foreach (var input in Model.Inputs)
                {
                    <div class="flex items-center justify-between border-b border-slate-100 pb-1">
                        <span class="text-slate-600 font-semibold">@input.DisplayName</span>
                        <span class="text-slate-400 font-mono text-[8px] bg-slate-50 px-1 rounded border">@input.Type</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-slate-300 italic">No user inputs required.</p>
        }
    </div>

    @* --- Outputs Section --- *@
    <div>
        <h4 class="text-slate-400 font-black uppercase tracking-widest mb-3 flex items-center gap-2">
            <i class="fa-solid fa-right-from-bracket text-emerald-400"></i>
            Generated Outputs
        </h4>
        <div class="space-y-2">
            @foreach (var output in Model.Outputs)
            {
                <div class="flex items-center justify-between border-b border-slate-100 pb-1">
                    <span class="text-slate-600 font-semibold">@output.DisplayName</span>
                    <span class="text-slate-400 font-mono text-[8px] bg-slate-50 px-1 rounded border">@output.Type</span>
                </div>
            }
        </div>
    </div>


</div>