@using ProcessorModule.Models.Views
@model SubJobDetailsViewModel

<div class="p-8 flex flex-col gap-10 animate-in fade-in slide-in-from-top-4 duration-700 bg-slate-50/30">

    @* --- Header & Script Metadata Summary --- *@
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        <div class="lg:col-span-3 flex flex-col gap-4">
            <div class="flex items-center gap-3">
                <div class="h-6 w-1 bg-indigo-500 rounded-full"></div>
                <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Execution Trace</h3>
            </div>

            @if (!string.IsNullOrEmpty(Model.SummaryJson))
            {
                <div class="relative group">
                    <div class="absolute -inset-1 bg-gradient-to-r from-indigo-500 to-cyan-500 rounded-2xl blur opacity-5 group-hover:opacity-10 transition duration-1000"></div>
                    <pre class="relative bg-slate-900 text-indigo-300 p-6 rounded-2xl text-[10px] font-mono leading-relaxed overflow-x-auto border border-slate-800 shadow-xl max-h-64 scrollbar-thin">@Model.SummaryJson</pre>
                </div>
            }
        </div>

        <div class="bg-white border border-slate-200 rounded-2xl p-6 shadow-sm self-start">
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest block mb-5 border-b border-slate-100 pb-2">Scalar Configuration</span>
            <div class="space-y-4">
                @foreach (var input in Model.ScalarInputs)
                {
                    <div class="flex flex-col">
                        <label class="text-[8px] font-black text-slate-400 uppercase tracking-tighter">@input.LocalizedLabel</label>
                        <span class="text-xs font-bold text-slate-700 font-mono break-all leading-tight">@input.Value</span>
                    </div>
                }
                @if (!Model.ScalarInputs.Any())
                {
                    <span class="text-[10px] text-slate-300 italic">No scalars provided.</span>
                }
            </div>
        </div>
    </div>

    @* --- Input Assets (The Files feeding the script) --- *@
    @if (Model.InputArtifacts.Any())
    {
        <div class="space-y-4">
            <div class="flex items-center gap-3 px-1">
                <span class="text-[10px] font-black text-slate-800 uppercase tracking-widest">Source Input Assets</span>
                <span class="h-px flex-1 bg-slate-100"></span>
            </div>
            <div class="flex flex-wrap gap-5">
                @foreach (var art in Model.InputArtifacts)
                {
                    <partial name="_ArtifactCard" model="art" />
                }
            </div>
        </div>
    }

    @* --- Direct Result KPIs --- *@
    @if (Model.DirectOutputs.Any())
    {
        <div class="space-y-4">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block px-1">Key Performance Indicators</span>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4">
                @foreach (var output in Model.DirectOutputs)
                {
                    <div class="bg-white border border-slate-200 p-5 rounded-2xl shadow-sm hover:ring-2 hover:ring-indigo-500/5 transition-all">
                        <p class="text-[8px] font-black text-slate-400 uppercase tracking-tight mb-2 truncate" title="@output.LocalizedLabel">@output.LocalizedLabel</p>
                        <p class="text-xl font-black text-slate-800 font-mono">@output.Value</p>
                    </div>
                }
            </div>
        </div>
    }

    @* --- Explicit Output Artifacts --- *@
    @if (Model.ExplicitArtifacts.Any())
    {
        <div class="space-y-4">
            <div class="flex items-center gap-3 px-1">
                <span class="text-[10px] font-black text-slate-800 uppercase tracking-widest">Primary Output Artifacts</span>
                <span class="h-px flex-1 bg-indigo-100"></span>
            </div>
            <div class="flex flex-wrap gap-5">
                @foreach (var art in Model.ExplicitArtifacts)
                {
                    <partial name="_ArtifactCard" model="art" />
                }
            </div>
        </div>
    }

    @* --- Internal Assets --- *@
    @if (Model.InternalArtifacts.Any())
    {
        <div class="pt-6 border-t border-slate-100 space-y-4">
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest block px-1">Supporting Infrastructure Files</span>
            <div class="flex flex-wrap gap-4">
                @foreach (var art in Model.InternalArtifacts)
                {
                    <partial name="_ArtifactCard" model="art" />
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ResultMessage))
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-6 rounded-r-2xl shadow-sm mt-4">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center">
                    <i class="fa-solid fa-bug text-red-600 text-xs"></i>
                </div>
                <span class="text-xs font-black text-red-700 uppercase tracking-widest">Step Execution Failure</span>
            </div>
            <div class="bg-white/80 p-4 rounded-xl border border-red-100">
                <code class="text-[11px] text-red-900 leading-relaxed break-all">@Model.ResultMessage</code>
            </div>
        </div>
    }
</div>