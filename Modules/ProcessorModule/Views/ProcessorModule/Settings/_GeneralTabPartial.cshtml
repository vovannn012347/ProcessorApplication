@using ProcessorModule.Configuration;
@model ProcessorSettings

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="space-y-1">
        <label asp-for="ScriptSourcePath" class="block text-sm font-medium text-slate-700"></label>
        <input asp-for="ScriptSourcePath" class="w-full rounded-lg border-slate-300 bg-slate-50 focus:bg-white transition-colors" />
        <span asp-validation-for="ScriptSourcePath" class="text-xs text-red-500"></span>
    </div>
    <div class="space-y-1">
        <label asp-for="ResultsOutputPath" class="block text-sm font-medium text-slate-700"></label>
        <input asp-for="ResultsOutputPath" class="w-full rounded-lg border-slate-300 bg-slate-50 focus:bg-white transition-colors" />
        <span asp-validation-for="ResultsOutputPath" class="text-xs text-red-500"></span>
    </div>
    <div class="space-y-1">
        <label asp-for="MaxConcurrentJobs" class="block text-sm font-medium text-slate-700"></label>
        <input asp-for="MaxConcurrentJobs" type="number" class="w-full rounded-lg border-slate-300" />
    </div>
    <div class="space-y-1">
        <label asp-for="JobTimeoutMinutes" class="block text-sm font-medium text-slate-700"></label>
        <input asp-for="JobTimeoutMinutes" type="number" step="0.5" class="w-full rounded-lg border-slate-300" />
    </div>
</div>