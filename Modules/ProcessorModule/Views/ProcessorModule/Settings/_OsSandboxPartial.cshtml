@using ProcessorModule.Configuration;
@model OsSandboxSettings

<div class="space-y-4">
    <div>
        <label asp-for="UserName" class="block text-[10px] font-bold text-slate-400 uppercase mb-1"></label>
        <input asp-for="UserName" class="w-full rounded-lg border-slate-300 text-sm" />
    </div>
    <div class="flex items-center gap-2">
        <input asp-for="AutoCreateProcessingUser" type="checkbox" />
        <label asp-for="AutoCreateProcessingUser" class="text-xs text-slate-600"></label>
    </div>
    <div>
        <label asp-for="GroupName" class="block text-[10px] font-bold text-slate-400 uppercase mb-1"></label>
        <input asp-for="GroupName" class="w-full rounded-lg border-slate-300 text-sm" />
    </div>
</div>