@using ProcessorModule.Configuration;
@model PythonProcessingSettings

<div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-end">
    <div class="md:col-span-2 space-y-1">
        <label asp-for="PythonExecutablePath" class="block text-sm font-medium text-slate-700"></label>
        <input asp-for="PythonExecutablePath" placeholder="e.g. /usr/bin/python3" class="w-full rounded-lg border-slate-300 font-mono text-sm" />
    </div>
    <div class="flex items-center gap-2 pb-3 px-2">
        <input asp-for="LogStdout" type="checkbox" class="rounded text-indigo-600 focus:ring-indigo-500" />
        <label asp-for="LogStdout" class="text-sm text-slate-600 font-medium"></label>
    </div>
</div>