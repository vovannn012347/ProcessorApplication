{
  "ConnectionStrings": {
    "SQLite": "Data Source=processordata.db;Cache=Shared;Mode=ReadWriteCreate;"
  },
  "ProcessorSettings": {
    "ScriptSourcePath": "./Module_Data/Processor/scripts1",
    "ResultsOutputPath": "./Module_Data/Processor/processing",
    "MaxConcurrentJobs": 4,
    "JobTimeoutMinutes": 5.0,
    // "None", "OSUser", "Docker"
    "SandboxingType": "None",
    // If true → fail startup if sandbox not ready if not NONE
    "RequireSandboxing": true,
    //validate sandbox on startup
    "ValidateSandboxOnStartup": true,
    "UpdateHashOnMismatch":  false
  },
  "PythonProcessingSettings": {
    "PythonExecutablePath": "./Module_Data/Processor/executor",
    "LogStdout": true
  },
  "DllProcessingSettings": {

  },
  "OsConatinedProcessingSettings": {
    "UserName": "Pr-User",
    // If true → attempt to create OS user on startup (admin required)
    "AutoCreateProcessingUser": true,
    "GroupName": "ml-processor", // Optional group for shared access
    "AutoCreateUser": true, // Duplicate flag here for OS-specific override
    "HomeDirectory": null, // null = no home (system user style)
    "Shell": "/usr/sbin/nologin" // Linux: prevent login; Windows ignored
  },
  "DockerProcessingSettings": {
    "Enabled": false, // Override global SandboxingType if needed
    "ImageName": "ml-processor-sandbox:latest", // Your custom lightweight image (python + torch + libs)
    "ContainerTimeoutSeconds": 600,
    "MemoryLimitMb": 4096,
    "CpuShares": 1024,
    "NetworkMode": "none", // Critical for medical security – no outbound/inbound
    "ReadOnlyRootFs": true,
    "Volumes": [ // Explicit bind mounts only
      // Example format: host:container:ro|rw
      // Filled dynamically or via template – keep minimal
    ],
    "User": "1000:1000" // Non-root user inside container
  }
}
