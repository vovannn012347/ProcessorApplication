@using Microsoft.AspNetCore.Authorization
@using System.IO
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "Clinic Gateway";
    var isAdmin = (await AuthorizationService.AuthorizeAsync(User, Context, "AdminLocalPolicy")).Succeeded;
}

<style>
    /* Print only the patient handout */
    @@media print {
        body * { visibility: hidden; }
        #patient-print-template, #patient-print-template * { visibility: visible; }
        #patient-print-template { position: absolute; left: 0; top: 0; width: 100%; }
    }
</style>

<div id="patient-print-template" class="is-hidden">
    <div style="text-align: center; font-family: sans-serif; padding: 40px; border: 2px solid #e2e8f0; border-radius: 1rem; max-width: 500px; margin: auto;">
        <h2 style="color: #0f172a; margin-top: 0;">Medical Portal Access</h2>
        <p style="color: #64748b; margin-bottom: 2rem;">Scan the code below to access processing.</p>
        <div id="print-qr-target" style="margin-bottom: 2rem; display: inline-block; background: white; padding: 10px; border: 1px solid #f1f5f9;"></div>
        <div style="background-color: #f8fafc; padding: 1.5rem; border-radius: 0.5rem; border: 1px solid #e2e8f0;">
            <p style="font-size: 0.75rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; margin: 0 0 0.5rem 0;">Web Address</p>
            <p id="print-url-text" style="font-family: monospace; color: #2563eb; font-size: 1.1rem; word-break: break-all; margin: 0;"></p>
        </div>
        <p style="margin-top: 2.5rem; font-size: 0.75rem; color: #94a3b8;">
            Generated: @DateTime.Now.ToString("f")
        </p>
    </div>
</div>

<div id="providerless-home-wrapper" data-script-id="providerless-home">
    <div class="grid">
        <div class="card">
            <h2>Connection <span id="status-badge" class="badge">Initializing...</span>
                <span class="tip" tabindex="0" data-tip="Tunnel (public address for this node) and registry (where the address is published so patients can find it)."></span>
            </h2>
            <div class="body">
                <div class="cols">
                    <div class="f"><label>Provider</label><span id="stat-provider">--</span></div>
                    <div class="f"><label>Started At</label><span id="stat-start">--</span></div>
                    <div class="f"><label>Tunnel</label><b id="stat-tunnel">--</b></div>
                    <div class="f"><label>Registry</label><b id="stat-registry">--</b></div>
                </div>
            <div class="f"><label>Tunnel URL</label><a id="url-tunnel" target="_blank" rel="noopener" class="mono wrap"></a></div>
            <div class="f"><label>Public URL</label><a id="url-public" target="_blank" rel="noopener" class="mono wrap"></a></div>
            <div class="f"><label>In Registry</label><a id="url-registered" target="_blank" rel="noopener" class="mono wrap"></a></div>
            <div class="f"><label>Registry Entry</label><a id="url-registry-entry" target="_blank" rel="noopener" class="mono wrap"></a></div>
                <div id="error-container" class="msg warn is-hidden"><i class="fa-solid fa-circle-xmark"></i> <span id="error-text" class="mono wrap"></span></div>
            </div>
        </div>

        <div class="card">
            <h2>Patient Access</h2>
            <div class="body">
                <div id="active-section" class="is-hidden" style="text-align:center">
                    <div id="qrcode" style="display:inline-block;padding:4px;background:#fff"></div>
                    <div id="qr-caption" class="lbl"></div>
                    <div class="actions" style="justify-content:center">
                        <button type="button" onclick="Providerless.printPatientHandout()" class="btn" title="Print patient handout"><i class="fa-solid fa-print"></i> Print</button>
                        <button type="button" onclick="Providerless.downloadQRCode()" class="btn" title="Download QR code"><i class="fa-solid fa-download"></i> Download</button>
                        <button type="button" onclick="Providerless.copyImageToClipboard()" class="btn" title="Copy QR image"><i class="fa-solid fa-copy"></i> Copy</button>
                    </div>
                </div>
                <div id="inactive-section" class="aux" style="text-align:center;padding:24px 0">
                    <i class="fa-solid fa-link-slash" style="font-size:22px"></i>
                    <div>Waiting for the tunnel...</div>
                </div>
            </div>
        </div>
    </div>

    @if (isAdmin)
    {
        <div class="card">
            <h2>Administration</h2>
            <div class="body">
                <div class="f row">
                    <input type="checkbox" id="reestablish-now" />
                    <label for="reestablish-now">Confirm immediate re-establishment</label>
                    <span class="tip" tabindex="0" data-tip="Restarts the tunnel and the registry publishing right now."></span>
                </div>
                <div class="actions">
                    <button id="reestablish-btn" type="button" onclick="Providerless.reestablishConnection()" class="btn"><i class="fa-solid fa-rotate"></i> Force Restart</button>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="/Providerless/lib/qrcodejs/qrcode.min.js"></script>
    <script src="~/providerless/js/pages/home/index.js" asp-append-version="true"></script>
}
