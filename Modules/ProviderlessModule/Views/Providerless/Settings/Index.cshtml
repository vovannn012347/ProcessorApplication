@using ProviderlessModule.Infrastructure.Interfaces
@model ProviderlessModule.Models.ProviderlessSettingsViewModel
@{
    ViewData["Title"] = "Portal Configuration";
}

<div id="providerless-settings-wrapper" data-script-id="providerless-settings">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="msg ok"><i class="fa-solid fa-check-circle"></i> @TempData["SuccessMessage"]</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="msg warn">
            <b><i class="fa-solid fa-triangle-exclamation"></i> Configuration errors</b>
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form id="providerlessSettingsForm" asp-area="Providerless" asp-controller="Settings" asp-action="SaveProviderless" method="post">
        @Html.AntiForgeryToken()

        <div class="card">
            <h2>Core Connectivity <span class="tip" tabindex="0" data-tip="Discovery registries and tunnels that make this clinic node reachable from outside."></span></h2>
            <div class="body grid">
                <div>
                    <div class="f row">
                        <label asp-for="General.Enabled">Master Gateway <span class="tip" tabindex="0" data-tip="Start the public tunnel for this node."></span></label>
                        <input asp-for="General.Enabled" type="checkbox" />
                    </div>
                    <div class="f row">
                        <label asp-for="General.RegistryEnabled">Cloud Discovery <span class="tip" tabindex="0" data-tip="Publish the tunnel URL to the selected discovery registry, so others can find this node."></span></label>
                        <input asp-for="General.RegistryEnabled" type="checkbox" />
                    </div>
                </div>
                <div>
                    <div class="f">
                        <label asp-for="General.EnforcedPCIdentifier">Clinic ID <span class="tip" tabindex="0" data-tip="Generated from this machine; also used as the tunnel subdomain."></span></label>
                        <input asp-for="General.EnforcedPCIdentifier" class="mono" readonly />
                    </div>
                    <div class="f">
                        <label asp-for="General.SharedSecret">Security Secret <span class="tip" tabindex="0" data-tip="Encrypts the URL published to the registry. Generated automatically."></span></label>
                        <input asp-for="General.SharedSecret" class="mono" readonly />
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Discovery Methods <span class="tip" tabindex="0" data-tip="Where the node publishes its current tunnel URL. Select one."></span></h2>
            <div class="body grid">
                @foreach (var entry in Model.RegistrySettings)
                {
                    var settings = (IProviderSettings)entry.Value;
                    var isActive = string.Equals(Model.General.ActiveRegistry, settings.ProviderKey, StringComparison.OrdinalIgnoreCase);
                    <div class="opt">
                        <h3><input type="radio" name="General.ActiveRegistry" value="@settings.ProviderKey" @(isActive ? "checked" : "") /> @settings.ProviderName</h3>
                        @await Html.PartialAsync(settings.SettingsViewPath, Model)
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <h2>Tunneling Infrastructure <span class="tip" tabindex="0" data-tip="How the node is exposed to the internet. Select one."></span></h2>
            <div class="body grid">
                @foreach (var entry in Model.TunnelSettings)
                {
                    var settings = (IProviderSettings)entry.Value;
                    var isActive = string.Equals(Model.General.SelectedTunnel, settings.ProviderKey, StringComparison.OrdinalIgnoreCase);
                    <div class="opt">
                        <h3><input type="radio" name="General.SelectedTunnel" value="@settings.ProviderKey" @(isActive ? "checked" : "") /> @settings.ProviderName</h3>
                        @await Html.PartialAsync(settings.SettingsViewPath, Model)
                    </div>
                }
            </div>
        </div>

        <div class="actions">
            <button type="submit" id="saveProviderlessSettingsButton" class="btn"><i class="fa-solid fa-floppy-disk"></i> Save Configuration</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/providerless/js/pages/settings/index.js" asp-append-version="true"></script>
}
