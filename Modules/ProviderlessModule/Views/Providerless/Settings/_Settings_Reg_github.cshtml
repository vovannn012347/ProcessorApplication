@model ProviderlessSettingsViewModel
@using ProviderlessModule.Configuration.Registry
@{
    var key = "github";
    var settings = Model.RegistrySettings.ContainsKey(key)
                   ? (GithubSettings)Model.RegistrySettings[key]
                   : new GithubSettings();
}

<div class="f">
    <label>Repository (owner/name) <span class="tip" tabindex="0" data-tip="Discovery via GitHub Raw needs a public repository, or a token for a private one. The node commits a signed JSON file with its tunnel URL."></span></label>
    <input name="RegistrySettings[@key].RepositoryName" value="@settings.RepositoryName" placeholder="MyClinic/portal-discovery" />
</div>
<div class="cols">
    <div class="f"><label>Branch</label><input name="RegistrySettings[@key].Branch" value="@settings.Branch" /></div>
    <div class="f"><label>Path</label><input name="RegistrySettings[@key].RegistryPath" value="@settings.RegistryPath" /></div>
</div>
<div class="f">
    <label>Access Token</label>
    <input name="RegistrySettings[@key].GitHubToken" value="@settings.GitHubToken" type="password" placeholder="ghp_xxxxxxxxxxxx" class="mono" />
</div>
