@model ProviderlessSettingsViewModel
@using ProviderlessModule.Configuration.Registry
@{
    var key = "googledocs";
    var settings = Model.RegistrySettings.ContainsKey(key)
                   ? (GoogleDocsSettings)Model.RegistrySettings[key]
                   : new GoogleDocsSettings();
}

<div class="f">
    <label>Spreadsheet ID <span class="tip" tabindex="0" data-tip="The identifier in the Google Sheet's URL."></span></label>
    <input name="RegistrySettings[@key].SpreadsheetId" value="@settings.SpreadsheetId" />
</div>
<div class="f">
    <label>Service Account JSON <span class="tip" tabindex="0" data-tip="Paste the full contents of the Google service account .json key file."></span></label>
    <textarea name="RegistrySettings[@key].ServiceAccountJson" rows="3" class="mono">@settings.ServiceAccountJson</textarea>
</div>
