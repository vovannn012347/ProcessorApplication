@using ProviderlessModule.Configuration.Registry
@model ProviderlessSettingsViewModel
@{
    var key = "rest";
    var settings = Model.RegistrySettings.ContainsKey(key)
                   ? (RestSettings)Model.RegistrySettings[key]
                   : new RestSettings();
}

<div class="f">
    <label>Endpoint URL</label>
    <input name="RegistrySettings[@key].Url" value="@settings.Url" placeholder="https://api.yourclinic.org/discovery" />
</div>
<div class="f">
    <label>Security Token</label>
    <input name="RegistrySettings[@key].SecurityToken" value="@settings.SecurityToken" type="password" class="mono" />
</div>
