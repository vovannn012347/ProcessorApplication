@model ProviderlessSettingsViewModel
@using ProviderlessModule.Configuration.Tunnel

@{
    var key = "cloudflare";
    var settings = Model.TunnelSettings.ContainsKey(key) 
                   ? (CloudflareSettings)Model.TunnelSettings[key] 
                   : new CloudflareSettings();
}

<div class="plss-space-y-4">
    <div>
        <label class="plss-text-[10px] plss-font-black plss-text-gray-400 plss-uppercase">Tunnel Token</label>
        <input name="TunnelSettings[@key].TunnelToken" value="@settings.TunnelToken" type="password" 
               placeholder="Enter token for existing tunnel"
               class="plss-w-full plss-mt-1 plss-p-2.5 plss-bg-white plss-border plss-rounded-lg plss-font-mono plss-text-sm" />
    </div>

    <div class="plss-bg-gray-50 plss-p-4 plss-rounded-xl plss-border plss-border-dashed plss-space-y-3">
        <p class="plss-text-[10px] plss-font-bold plss-text-gray-500 plss-uppercase">Provisioning (Only if token is empty)</p>
        <div class="plss-grid plss-grid-cols-2 plss-gap-3">
            <input name="TunnelSettings[@key].AccountId" value="@settings.AccountId" placeholder="Account ID" class="plss-p-2 plss-text-xs plss-border plss-rounded" />
            <input name="TunnelSettings[@key].ZoneId" value="@settings.ZoneId" placeholder="Zone ID" class="plss-p-2 plss-text-xs plss-border plss-rounded" />
        </div>
        <input name="TunnelSettings[@key].ProvisionToken" value="@settings.ProvisionToken" placeholder="Provisioning Token" class="plss-w-full plss-p-2 plss-text-xs plss-border plss-rounded" />
    </div>

    <div class="plss-grid plss-grid-cols-2 plss-gap-4">
        <div>
            <label class="plss-text-[10px] plss-font-black plss-text-gray-400 plss-uppercase">Custom URL</label>
            <input name="TunnelSettings[@key].CustomPublicUrl" value="@settings.CustomPublicUrl" 
                   class="plss-w-full plss-mt-1 plss-p-2.5 plss-bg-white plss-border plss-rounded-lg plss-text-sm" />
        </div>
        <div>
            <label class="plss-text-[10px] plss-font-black plss-text-gray-400 plss-uppercase">Timeout (Sec)</label>
            <input name="TunnelSettings[@key].WaitTimeoutSeconds" value="@settings.WaitTimeoutSeconds" type="number" 
                   class="plss-w-full plss-mt-1 plss-p-2.5 plss-bg-white plss-border plss-rounded-lg plss-text-sm" />
        </div>
    </div>

    <div>
        <label class="plss-text-[10px] plss-font-black plss-text-gray-400 plss-uppercase">Extra Arguments</label>
        <input name="TunnelSettings[@key].ExtraArgs" value="@settings.ExtraArgs" 
               placeholder="--protocol http2"
               class="plss-w-full plss-mt-1 plss-p-2.5 plss-bg-white plss-border plss-rounded-lg plss-text-sm plss-font-mono" />
    </div>
</div>