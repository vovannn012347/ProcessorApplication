@model ProviderlessSettingsViewModel
@using ProviderlessModule.Configuration.Tunnel
@{
    var key = "cloudflare";
    var settings = Model.TunnelSettings.ContainsKey(key)
                   ? (CloudflareSettings)Model.TunnelSettings[key]
                   : new CloudflareSettings();
}

<div class="f">
    <label>Tunnel Token <span class="tip" tabindex="0" data-tip="Token of an existing Cloudflare tunnel. Leave empty to create one with the provisioning fields below."></span></label>
    <input name="TunnelSettings[@key].TunnelToken" value="@settings.TunnelToken" type="password" placeholder="Token of an existing tunnel" class="mono" />
</div>
<div class="cols">
    <div class="f"><label>Account ID <span class="tip" tabindex="0" data-tip="Provisioning: used only when the tunnel token is empty."></span></label><input name="TunnelSettings[@key].AccountId" value="@settings.AccountId" class="mono" /></div>
    <div class="f"><label>Zone ID</label><input name="TunnelSettings[@key].ZoneId" value="@settings.ZoneId" class="mono" /></div>
</div>
<div class="f">
    <label>Provisioning Token <span class="tip" tabindex="0" data-tip="Cloudflare API token allowed to create tunnels and DNS records. Used only when the tunnel token is empty."></span></label>
    <input name="TunnelSettings[@key].ProvisionToken" value="@settings.ProvisionToken" class="mono" />
</div>
<div class="cols">
    <div class="f"><label>Custom URL</label><input name="TunnelSettings[@key].CustomPublicUrl" value="@settings.CustomPublicUrl" /></div>
    <div class="f"><label>Timeout (sec)</label><input name="TunnelSettings[@key].WaitTimeoutSeconds" value="@settings.WaitTimeoutSeconds" type="number" /></div>
</div>
<div class="f">
    <label>Extra Arguments <span class="tip" tabindex="0" data-tip="Passed to cloudflared as they are."></span></label>
    <input name="TunnelSettings[@key].ExtraArgs" value="@settings.ExtraArgs" placeholder="--protocol http2" class="mono" />
</div>
