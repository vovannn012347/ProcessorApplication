@model ProviderlessSettingsViewModel
@using ProviderlessModule.Configuration
@using ProviderlessModule.Configuration.Tunnel
@using ProviderlessModule.Services.Tunnel.Provisioning
@inject INodeProvisioningIdentity ProvisioningIdentity
@inject ProviderlessModule.Services.ILocalDataProvider LocalData
@{
    var key = TunnelProviderType.CloudflareWorker;
    var settings = Model.TunnelSettings.ContainsKey(key)
                   ? (CloudflareWorkerSettings)Model.TunnelSettings[key]
                   : new CloudflareWorkerSettings();

    string keyStatus;
    try { keyStatus = ProvisioningIdentity.Label; }
    catch (Exception ex) { keyStatus = $"(key unavailable: {ex.Message})"; }
    string clinicLabel = (LocalData.GetEncryptedMachineHash() ?? "").Trim().Split('.')[0].ToLowerInvariant();
    var provisioningState = ProvisioningIdentity.LoadState();
}

<div class="f">
    <label>Provisioning Service URL <span class="tip" tabindex="0" data-tip="Address of the Cloudflare Worker that creates tunnels for nodes. The node needs no Cloudflare credentials."></span></label>
    <input name="TunnelSettings[@key].ServiceUrl" value="@settings.ServiceUrl" placeholder="https://processor-provisioner.example.workers.dev" class="mono" />
</div>
<div class="cols">
    <div class="f">
        <label>Join Key <span class="tip" tabindex="0" data-tip="Only if the Worker has JOIN_KEY set."></span></label>
        <input name="TunnelSettings[@key].JoinKey" value="@settings.JoinKey" type="password" />
    </div>
    <div class="f">
        <label>Rotate Tunnel (days) <span class="tip" tabindex="0" data-tip="Replace the tunnel, and its token, after this many days. 0 = never."></span></label>
        <input name="TunnelSettings[@key].TunnelRotationDays" value="@settings.TunnelRotationDays" type="number" min="0" max="3650" />
    </div>
</div>
<div class="note">
    <div>Subdomain (Clinic ID): <span class="val mono">@clinicLabel</span></div>
    <div>Node key: <span class="val mono">@keyStatus</span>
        <span class="tip" tabindex="0" data-tip="The tunnel token is requested from the Worker automatically. The first claim ties the subdomain to this node key (Module_Data/Portal/keys): back that folder up. With a new key the Worker refuses the subdomain until the old one is released or evicted."></span></div>
    @if (provisioningState != null && !string.IsNullOrEmpty(provisioningState.Hostname))
    {
        <div>Assigned: <span class="val mono">@provisioningState.Hostname</span>, tunnel created @provisioningState.TunnelCreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</div>
    }
</div>
<div class="cols">
    <div class="f">
        <label>Extra Arguments <span class="tip" tabindex="0" data-tip="Passed to cloudflared as they are."></span></label>
        <input name="TunnelSettings[@key].ExtraArgs" value="@settings.ExtraArgs" placeholder="--protocol http2" class="mono" />
    </div>
    <div class="f">
        <label>Timeout (sec)</label>
        <input name="TunnelSettings[@key].WaitTimeoutSeconds" value="@settings.WaitTimeoutSeconds" type="number" />
    </div>
</div>
