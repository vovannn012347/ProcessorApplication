@model ProviderlessSettingsViewModel
@using ProviderlessModule.Configuration.Tunnel
@{
    var key = "static";
    var settings = Model.TunnelSettings.ContainsKey(key)
                   ? (StaticUrlSettings)Model.TunnelSettings[key]
                   : new StaticUrlSettings();
}

<div class="f">
    <label>Public Static URL <span class="tip" tabindex="0" data-tip="Manual mode: for a fixed IP or an existing reverse proxy. No tunnel binary is started."></span></label>
    <input name="TunnelSettings[@key].PublicUrl" value="@settings.PublicUrl" placeholder="https://portal.myclinic.com" />
</div>
