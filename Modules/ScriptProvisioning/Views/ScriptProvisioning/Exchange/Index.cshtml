@{
    ViewData["Title"] = "Script Exchange";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) { Layout = null; }
}

<div id="script-exchange-wrapper" data-script-id="spv-exchange">
    @Html.AntiForgeryToken()
    <div id="spv-status" class="msg is-hidden"></div>

    <div class="card">
        <h2><i class="fa-solid fa-satellite-dish"></i> On the Network <span class="tip" tabindex="0" data-tip="Script builds other nodes offer, from the file catalogue. Packages travel through PTorrent; installing uses the same checks as a local upload. Ask a node directly if its packages don't show up yet."></span></h2>
        <div class="body">
            <div class="actions">
                <input id="spv-probe-node" type="text" class="mono" placeholder="Node ID" style="flex:1;max-width:320px" />
                <button type="button" id="spv-btn-probe" class="btn sm"><i class="fa-solid fa-magnifying-glass"></i> Ask Node</button>
                <button type="button" id="spv-btn-refresh-remote" class="btn sm"><i class="fa-solid fa-rotate"></i> Refresh</button>
            </div>
            <table class="t">
                <thead>
                    <tr><th>Script</th><th>Version</th><th>Build Hash</th><th>Size</th><th>Offered By</th><th>Here</th><th></th></tr>
                </thead>
                <tbody id="spv-remote-body"></tbody>
            </table>
            <div id="spv-remote-empty" class="aux is-hidden">No script packages known yet.</div>
        </div>
    </div>

    <div id="spv-tasks-section" class="card is-hidden">
        <h2><i class="fa-solid fa-list-check"></i> Installs</h2>
        <div class="body">
            <ul id="spv-tasks-list" style="list-style:none;margin:0;padding:0"></ul>
        </div>
    </div>

    <div class="card">
        <h2><i class="fa-solid fa-box-open"></i> Installed Builds <span class="tip" tabindex="0" data-tip="Publish a build to offer it to other nodes. The package is checked first, exactly as the receiving node will check it."></span></h2>
        <div class="body">
            <div class="actions">
                <label class="f row"><input type="checkbox" id="spv-publish-hidden" /> Publish unlisted</label>
                <button type="button" id="spv-btn-refresh-builds" class="btn sm"><i class="fa-solid fa-rotate"></i> Refresh</button>
            </div>
            <table class="t">
                <thead>
                    <tr><th>Script</th><th>Version</th><th>Build Hash</th><th>Origin</th><th>Shared</th><th></th></tr>
                </thead>
                <tbody id="spv-builds-body"></tbody>
            </table>
            <div id="spv-builds-empty" class="aux is-hidden">No scripts installed.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/ScriptProvisioning/js/pages/exchange/index.js" asp-append-version="true"></script>
}
