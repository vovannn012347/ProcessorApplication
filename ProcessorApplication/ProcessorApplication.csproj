<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**;package*.json;tailwind.config.js;Styles\**</DefaultItemExcludes>
    <Configurations>Debug;Release;NodeTracker1Debug;NodeTracker2Debug;NodeClient1Debug;NodeClient2Debug;NodeTrackerSwarm</Configurations>

    <!--for appsettings hook in build.props-->
    <ModuleKey>main</ModuleKey>
    <Version>1.0.0.0</Version>

    <!--memory optimization-->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- every library the main application ships for all modules: the list is in Directory.Packages.props -->
    <PackageReference Include="@(HostProvidedPackage)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--<PackageReference Include="MongoDB.Driver" />-->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Services\EventBusService.cs" />
    <Compile Remove="Services\MessageHubService.cs" />
    <Compile Remove="Services\SqliteConfigurationProvider.cs" />
    <Compile Remove="Services\SqliteConfigurationSource.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="D:\Shared\Kursova\ProcessorApplication\ProcessorApplication\appsettings..Development.json" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="medicalsystem.db" />
    <None Remove="medicalsystem.db-shm" />
    <None Remove="medicalsystem.db-wal" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="package-lock.json" />
    <Content Include="package.json" />
  </ItemGroup>
  <ItemGroup>
    <None Include="tailwind.config.js" />
  </ItemGroup>
  
  <Target Name="CopyWwwRootToOutput" AfterTargets="Build">
    <ItemGroup>
      <ModuleAssets Include="$(ProjectDir)wwwroot\**\*.*" />
    </ItemGroup>
    <Message Text="Copying Module wwwroot to $(OutputPath)wwwroot..." Importance="high" />
    <Copy SourceFiles="@(ModuleAssets)" DestinationFiles="@(ModuleAssets->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- The host gets a module.manifest.json the same way every module does - ModuleLoader reads it
       as a root entry in the same dependency graph, instead of hardcoding "Main is always
       satisfied". No ModuleManifestDependency items needed: the host has no dependencies of its
       own in this graph, it's the root. -->
  <Import Project="$(MSBuildThisFileDirectory)..\Build\ModuleManifest.targets" />

</Project>
