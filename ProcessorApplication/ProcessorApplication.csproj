<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**;package*.json;tailwind.config.js;Styles\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.2.0" />
    <PackageReference Include="MailKit" Version="4.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="6.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="6.0.35" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="6.0.35">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="6.0.35" />
    <PackageReference Include="MongoDB.Driver" Version="2.28.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common\Common.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Modules\" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="wwwroot\**\*" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Services\EventBusService.cs" />
    <Compile Remove="Services\MessageHubService.cs" />
    <Compile Remove="Services\SqliteConfigurationProvider.cs" />
    <Compile Remove="Services\SqliteConfigurationSource.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="tailwind.config.js" />
  </ItemGroup>
  
  <Target Name="CopyWwwRootToOutput" AfterTargets="Build">
    <ItemGroup>
      <ModuleAssets Include="$(ProjectDir)wwwroot\**\*.*" />
    </ItemGroup>
    <Message Text="Copying Module wwwroot to $(OutputPath)wwwroot..." Importance="high" />
    <Copy SourceFiles="@(ModuleAssets)" DestinationFiles="@(ModuleAssets->'$(OutputPath)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
