@model ProcessorApplication.ViewModels.Account.AdminRegisterViewModel
@{
    ViewData["Title"] = "System Administrator Initialization";
    Layout = "_LayoutLogin";
}

<div class="max-w-lg mx-auto">

    <div class="text-center mb-8">
        <p class="mt-2 text-sm text-gray-600">
            Initialize the root administrator account.
        </p>
    </div>

    <div asp-validation-summary="All" class="rounded-md bg-red-50 p-4 text-sm text-red-700 mb-6 border border-red-200 [.validation-summary-valid&]:hidden"></div>

    <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10 border border-gray-100">

        <form asp-action="AdminRegister" method="post" class="space-y-6">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" placeholder="First Name" />
                    <span asp-validation-for="Name" class="text-xs text-red-600 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="Surname" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Surname" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" placeholder="Last Name" />
                    <span asp-validation-for="Surname" class="text-xs text-red-600 mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
                <div class="mt-1">
                    <input asp-for="Email" type="email" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" />
                </div>
                <span asp-validation-for="Email" class="text-xs text-red-600 mt-1 block"></span>

                <div class="mt-2 rounded-md bg-amber-50 p-3 border border-amber-200">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-amber-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3 flex-1 md:flex md:justify-between">
                            <p class="text-xs text-amber-700">
                                It is required to set up an email for user notifications. Preferably your work email. Cannot view user data without user notification.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700"></label>
                <div class="mt-1">
                    <input asp-for="Password" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" />
                </div>
                <span asp-validation-for="Password" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700">Confirm Password</label>
                <div class="mt-1">
                    <input asp-for="ConfirmPassword" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm p-2 border" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-xs text-red-600 mt-1 block"></span>
            </div>

            <div class="pt-2">
                <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-colors duration-200">
                    Create Administrator Account
                </button>
            </div>
        </form>
    </div>
</div>