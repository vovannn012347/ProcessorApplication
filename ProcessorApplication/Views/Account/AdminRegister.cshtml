@model ProcessorApplication.ViewModels.Account.AdminRegisterViewModel
@{
    ViewData["Title"] = "System Administrator Initialization";
    Layout = "_LayoutLogin";
}

<div class="mm-max-w-lg mm-mx-auto">

    <div class="mm-text-center mm-mb-8">
        <p class="mm-mt-2 mm-text-sm mm-text-gray-600">
            Initialize the root administrator account.
        </p>
    </div>

    <div asp-validation-summary="All" class="mm-rounded-md mm-bg-red-50 mm-p-4 mm-text-sm mm-text-red-700 mm-mb-6 mm-border mm-border-red-200 [.validation-summary-valid&]:mm-hidden"></div>

    <div class="mm-bg-white mm-py-8 mm-px-4 mm-shadow sm:mm-rounded-lg sm:mm-px-10 mm-border mm-border-gray-100">

        <form asp-action="AdminRegister" method="post" class="mm-space-y-6">

            <div class="mm-grid mm-grid-cols-1 md:mm-grid-cols-2 mm-gap-4">
                <div>
                    <label asp-for="Name" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
                    <input asp-for="Name" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-p-2 mm-border" placeholder="First Name" />
                    <span asp-validation-for="Name" class="mm-text-xs mm-text-red-600 mm-mt-1 mm-block"></span>
                </div>

                <div>
                    <label asp-for="Surname" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
                    <input asp-for="Surname" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-p-2 mm-border" placeholder="Last Name" />
                    <span asp-validation-for="Surname" class="mm-text-xs mm-text-red-600 mm-mt-1 mm-block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
                <div class="mm-mt-1">
                    <input asp-for="Email" type="email" class="mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-p-2 mm-border" />
                </div>
                <span asp-validation-for="Email" class="mm-text-xs mm-text-red-600 mm-mt-1 mm-block"></span>

                <div class="mm-mt-2 mm-rounded-md mm-bg-amber-50 mm-p-3 mm-border mm-border-amber-200">
                    <div class="mm-flex">
                        <div class="mm-flex-shrink-0">
                            <svg class="mm-h-5 mm-w-5 mm-text-amber-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="mm-ml-3 mm-flex-1 md:mm-flex md:mm-justify-between">
                            <p class="mm-text-xs mm-text-amber-700">
                                It is required to set up an email for user notifications. Preferably your work email. Cannot view user data without user notification.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <label asp-for="Password" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
                <div class="mm-mt-1">
                    <input asp-for="Password" class="mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-p-2 mm-border" />
                </div>
                <span asp-validation-for="Password" class="mm-text-xs mm-text-red-600 mm-mt-1 mm-block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700">Confirm Password</label>
                <div class="mm-mt-1">
                    <input asp-for="ConfirmPassword" class="mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-p-2 mm-border" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="mm-text-xs mm-text-red-600 mm-mt-1 mm-block"></span>
            </div>

            <div class="mm-pt-2">
                <button type="submit" class="mm-w-full mm-flex mm-justify-center mm-py-2.5 mm-px-4 mm-border mm-border-transparent mm-rounded-md mm-shadow-sm mm-text-sm mm-font-medium mm-text-white mm-bg-indigo-600 hover:mm-bg-indigo-700 focus:mm-outline-none focus:mm-ring-2 focus:mm-ring-offset-2 focus:mm-ring-indigo-500 mm-transition-colors mm-duration-200">
                    Create Administrator Account
                </button>
            </div>
        </form>
    </div>
</div>