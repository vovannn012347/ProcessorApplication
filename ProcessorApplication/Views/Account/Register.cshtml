@model ProcessorApplication.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "New User Registration";
    Layout = "_LayoutLogin";
}

<!-- Tabs/Mode Selection -->
<div class="tabs-container flex flex-wrap justify-center mb-6">

    <div asp-validation-summary="All" class="w-full order-2 rounded-md bg-red-50 text-sm text-red-700 empty:hidden mb-4"></div>

    <input type="radio" id="tab-manual" name="register-mode" checked class="hidden-radio-tab">

    <label for="tab-manual" class="tab-label style-indigo order-1 px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50 cursor-pointer mr-4 mb-4">
        Manual Register
    </label>

    <div class="tab-content order-3 w-full">
        <div class="border-t pt-4">
            <h3 class="text-xl font-semibold mb-4 border-b pb-2">Manual Entry</h3>
            <form asp-area="Main" asp-controller="Account" asp-action="Register" method="post" class="space-y-4">
                <partial name="_RegisterFormPartial" model="Model" />
                <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700">
                    Register Secure Account
                </button>
            </form>
        </div>
    </div>


    <input type="radio" id="tab-file" name="register-mode" class="hidden-radio-tab">

    <label for="tab-file" class="tab-label style-green order-1 px-4 py-2 rounded-lg text-sm font-medium text-gray-600 hover:bg-gray-50 cursor-pointer mb-4">
        Import from File
    </label>

    <div class="tab-content order-3 w-full">
        <div class="border-t pt-4">
            <h3 class="text-xl font-semibold mb-4 border-b pb-2">Import Secure Identity</h3>
            <form asp-area="Main" asp-controller="Account" asp-action="RegisterFromFile" method="post" enctype="multipart/form-data" class="space-y-4">
                <partial name="_FileRegisterFormPartial" model="Model" />
                <button type="submit" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700">
                    Import and Set Password
                </button>
            </form>
        </div>
    </div>

</div>