@model ProcessorApplication.ViewModels.Account.RegisterViewModel

<div class="mm-space-y-4">

    <!-- Name and Surname -->
    <div>
        <label asp-for="Name" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
        <input asp-for="Name" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border mm-border-gray-300 mm-shadow-sm mm-p-2" />
        <span asp-validation-for="Name" class="mm-text-sm mm-text-red-600 mm-block mm-mt-1"></span>
    </div>
    <div>
        <label asp-for="Surname" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
        <input asp-for="Surname" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border mm-border-gray-300 mm-shadow-sm mm-p-2" />
        <span asp-validation-for="Surname" class="mm-text-sm mm-text-red-600 mm-block mm-mt-1"></span>
    </div>

    <!-- Display Nickname -->
    <div>
        <label asp-for="DisplayNickname" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
        <input asp-for="DisplayNickname" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border mm-border-gray-300 mm-shadow-sm mm-p-2" />
    </div>

    <div>
        <label asp-for="Email" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
        <div class="mm-mt-1">
            <input asp-for="Email" type="email" class="mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-p-2 mm-border" />
        </div>
        <span asp-validation-for="Email" class="mm-text-xs mm-text-red-600 mm-mt-1 mm-block"></span>

        <div class="mm-mt-2 mm-rounded-md mm-bg-amber-50 mm-p-3 mm-border mm-border-amber-200">
            <div class="mm-flex">
                <div class="mm-flex-shrink-0">
                    <svg class="mm-h-5 mm-w-5 mm-text-amber-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="mm-ml-3 mm-flex-1 md:mm-flex md:mm-justify-between">
                    <p class="mm-text-xs mm-text-amber-700">
                        It is required to set up an email for notifications. Preferably not a spambox email. When your data is accessed by someone except you - you will get notified if you set an email. Also can be used for password recovery.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Passwords -->
    <div>
        <label asp-for="Password" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
        <input asp-for="Password" type="password" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border mm-border-gray-300 mm-shadow-sm mm-p-2" />
        <span asp-validation-for="Password" class="mm-text-sm mm-text-red-600 mm-block mm-mt-1"></span>
    </div>
    <div>
        <label asp-for="ConfirmPassword" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
        <input asp-for="ConfirmPassword" type="password" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border mm-border-gray-300 mm-shadow-sm mm-p-2" />
        <span asp-validation-for="ConfirmPassword" class="mm-text-sm mm-text-red-600 mm-block mm-mt-1"></span>
    </div>
</div>