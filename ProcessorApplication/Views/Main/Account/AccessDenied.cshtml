@model string
@{
    ViewData["Title"] = "Access Denied";
    Layout = "_LayoutLogin";
}

<div class="msg warn"><i class="fa-solid fa-shield-halved"></i> You are not logged in, or your account doesn't have the privileges for this address.</div>
@if (!string.IsNullOrEmpty(Model))
{
    <div class="f"><span class="aux">Attempted address</span><span class="mono wrap">@Model</span></div>
}
<div class="actions">
    <a href="/" class="btn sm"><i class="fa-solid fa-house"></i> Return to Dashboard</a>
    <a href="@Url.Action("Login", "Account", new { returnUrl = Model })" class="btn sm"><i class="fa-solid fa-user-shield"></i> Login</a>
</div>
