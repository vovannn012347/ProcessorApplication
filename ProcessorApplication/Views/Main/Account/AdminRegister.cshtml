@model ProcessorApplication.ViewModels.Account.AdminRegisterViewModel
@{
    ViewData["Title"] = "System Administrator Initialization";
    Layout = "_LayoutLogin";
}

<div class="aux">Create the root administrator account.</div>
<div asp-validation-summary="All" class="msg warn"></div>
<form asp-action="AdminRegister" method="post">
    <div class="cols">
        <div class="f"><label asp-for="Name"></label><input asp-for="Name" placeholder="First name" /><span asp-validation-for="Name" class="warn-t"></span></div>
        <div class="f"><label asp-for="Surname"></label><input asp-for="Surname" placeholder="Last name" /><span asp-validation-for="Surname" class="warn-t"></span></div>
    </div>
    <div class="f">
        <div><label asp-for="Email"></label> <span class="tip" tabindex="0" data-tip="Required for user notifications, preferably your work address. User data can't be viewed without the user being notified."></span></div>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="warn-t"></span>
    </div>
    <div class="cols">
        <div class="f"><label asp-for="Password"></label><input asp-for="Password" /><span asp-validation-for="Password" class="warn-t"></span></div>
        <div class="f"><label asp-for="ConfirmPassword">Confirm Password</label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword" class="warn-t"></span></div>
    </div>
    <div class="actions"><button type="submit" class="btn">Create Administrator Account</button></div>
</form>
