@model ProcessorApplication.ViewModels.Account.LoginViewModel
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Log in";
}

<div asp-validation-summary="All" class="msg warn"></div>
<div class="rtabs">
    <input type="radio" id="login-std" name="login-mode" checked>
    <label for="login-std" class="btn sm">Standard</label>
    <div>
        <form asp-area="Main" asp-controller="Account" asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="f"><label asp-for="UserName">Login ID (Hash)</label><input asp-for="UserName" class="mono" /></div>
            <div class="f"><label asp-for="Password"></label><input asp-for="Password" type="password" /></div>
            <div class="actions"><button type="submit" class="btn">Sign in</button></div>
        </form>
    </div>

    <input type="radio" id="login-file" name="login-mode">
    <label for="login-file" class="btn sm">File Login</label>
    <div>
        <form asp-area="Main" asp-controller="Account" asp-action="LoginFromFile" method="post" enctype="multipart/form-data">
            <div class="f"><label>Profile File <span class="tip" tabindex="0" data-tip="Your exported identity file; it is unlocked with your password."></span></label><input type="file" name="profileFile" /></div>
            <div class="f"><label>Password</label><input name="password" type="password" /></div>
            @if (!string.IsNullOrEmpty(Model.ReturnUrl))
            {
                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            }
            <div class="actions"><button type="submit" class="btn">Unlock with File Key</button></div>
        </form>
    </div>
</div>
<div class="aux">No identity yet? <a href="/Main/Account/Register">Create a new secure account</a></div>
