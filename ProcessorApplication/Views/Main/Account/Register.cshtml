@model ProcessorApplication.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "New User Registration";
    Layout = "_LayoutLogin";
}

<div asp-validation-summary="All" class="msg warn"></div>
<div class="rtabs">
    <input type="radio" id="tab-manual" name="register-mode" checked>
    <label for="tab-manual" class="btn sm">Manual Register</label>
    <div>
        <form asp-area="Main" asp-controller="Account" asp-action="Register" method="post">
            <partial name="_RegisterFormPartial" model="Model" />
            <div class="actions"><button type="submit" class="btn">Register Secure Account</button></div>
        </form>
    </div>

    <input type="radio" id="tab-file" name="register-mode">
    <label for="tab-file" class="btn sm">Import from File</label>
    <div>
        <form asp-area="Main" asp-controller="Account" asp-action="RegisterFromFile" method="post" enctype="multipart/form-data">
            <partial name="_FileRegisterFormPartial" model="Model" />
            <div class="actions"><button type="submit" class="btn">Import and Set Password</button></div>
        </form>
    </div>
</div>
