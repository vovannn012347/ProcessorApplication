@model string
@{
    ViewData["Title"] = "Session Timeout";
    Layout = "_LayoutLogin";
}

<div class="msg warn"><i class="fa-solid fa-clock-rotate-left"></i> Your secure decryption session key is no longer available.</div>
<p>Log in again to refresh your session; you will be sent back to the page you were opening.</p>
<div class="actions">
    <a href="@Url.Action("Login", "Account", new { returnUrl = Model })" class="btn"><i class="fa-solid fa-right-to-bracket"></i> Log in</a>
</div>
