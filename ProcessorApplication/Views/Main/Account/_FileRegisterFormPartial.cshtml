@model ProcessorApplication.ViewModels.Account.RegisterViewModel

<div class="f">
    <label for="profileFile">Profile Export File (.json) <span class="tip" tabindex="0" data-tip="Your exported profile file (for example from a medical system). Set a new password below to secure the imported identity here."></span></label>
    <input type="file" id="profileFile" name="profileFile" required />
</div>
<div class="cols">
    <div class="f"><label for="password">Password <span class="tip" tabindex="0" data-tip="The imported signature key is encrypted with this password: don't lose or forget it."></span></label><input type="password" id="password" name="password" required /></div>
    <div class="f"><label for="confirmPassword">Confirm Password</label><input type="password" id="confirmPassword" name="confirmPassword" required /></div>
</div>
