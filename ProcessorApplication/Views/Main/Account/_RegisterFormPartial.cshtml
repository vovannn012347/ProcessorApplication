@model ProcessorApplication.ViewModels.Account.RegisterViewModel

<div class="cols">
    <div class="f"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="warn-t"></span></div>
    <div class="f"><label asp-for="Surname"></label><input asp-for="Surname" /><span asp-validation-for="Surname" class="warn-t"></span></div>
</div>
<div class="f"><label asp-for="DisplayNickname"></label><input asp-for="DisplayNickname" /></div>
<div class="f">
    <div><label asp-for="Email"></label> <span class="tip" tabindex="0" data-tip="Required for notifications, preferably not a throwaway address: you are notified when someone other than you accesses your data. Also used for password recovery."></span></div>
    <input asp-for="Email" type="email" />
    <span asp-validation-for="Email" class="warn-t"></span>
</div>
<div class="cols">
    <div class="f"><label asp-for="Password"></label><input asp-for="Password" type="password" /><span asp-validation-for="Password" class="warn-t"></span></div>
    <div class="f"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" type="password" /><span asp-validation-for="ConfirmPassword" class="warn-t"></span></div>
</div>
