<div class="mm-widget-container mm-p-5 mm-h-full mm-flex mm-flex-col mm-justify-between" id="widget-main-user-stats">
    <div class="mm-flex mm-items-center mm-justify-between mm-mb-4">
        <div class="mm-flex mm-items-center mm-gap-2">
            @* Visual Modem Bling Indicator *@
            <div class="status-bling mm-w-2 mm-h-2 mm-rounded-full mm-bg-slate-200 mm-transition-all mm-duration-500"></div>
            <span class="mm-text-[10px] mm-font-black mm-uppercase mm-tracking-widest mm-text-gray-400">Identity Monitor</span>
        </div>
        <div class="mm-text-[9px] mm-font-mono mm-text-slate-300" id="users-last-sync">--:--:--</div>
    </div>

    <div class="mm-grid mm-grid-cols-2 mm-gap-3">
        <div class="mm-p-3 mm-bg-slate-50 mm-rounded-xl mm-border mm-border-slate-100">
            <span class="mm-block mm-text-[8px] mm-font-black mm-text-slate-400 mm-uppercase mm-mb-1">Registered</span>
            <div class="mm-flex mm-items-baseline mm-gap-1">
                <span class="mm-text-lg mm-font-black mm-text-slate-800" id="user-total-count">0</span>
            </div>
        </div>
        <div class="mm-p-3 mm-bg-indigo-50/30 mm-rounded-xl mm-border mm-border-indigo-100/50">
            <span class="mm-block mm-text-[8px] mm-font-black mm-text-indigo-400 mm-uppercase mm-mb-1">Live Now</span>
            <div class="mm-flex mm-items-baseline mm-gap-1">
                <span class="mm-text-lg mm-font-black mm-text-indigo-600" id="user-active-count">0</span>
            </div>
        </div>
    </div>
</div>