@{
    ViewData["Title"] = "Operational Hub";
    bool isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
}

<div id="dashboard-hub-wrapper" data-script-id="main-dashboard">
    <div id="expanded-grid-container" class="grid">
        @* Active Widgets *@
    </div>

    <div class="side-cap" style="color:var(--aux);padding-left:0"><i class="fa-solid fa-box-archive"></i> Minimized</div>
    <div id="minimized-tray-container" class="actions" style="align-items:flex-start">
        @* Collapsed Widgets *@
    </div>

    <template id="widget-shell-template">
        <div class="widget-shell card" style="margin:0">
            <h2 class="widget-header" style="display:flex;align-items:center;gap:4px">
                <i class="widget-icon"></i>
                <span class="widget-title" style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
                <button class="refresh-btn icon-btn" title="Refresh"><i class="fa-solid fa-arrows-rotate"></i></button>
                <button class="chevron-trigger icon-btn" title="Minimize / expand"><i class="fa-solid fa-chevron-down" id="chevron-icon"></i></button>
            </h2>
            <div class="widget-body"></div>
        </div>
    </template>

    @if (isAjax)
    {
        <script src="/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
        <script src="/js/dashboard/dashboard-manager.js" asp-append-version="true"></script>
    }
</div>

@if (!isAjax)
{
    @section Scripts {
        <script src="/lib/microsoft/signalr/dist/browser/signalr.min.js"></script>
        <script src="/js/dashboard/dashboard-manager.js" asp-append-version="true"></script>
    }
}