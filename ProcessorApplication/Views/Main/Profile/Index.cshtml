@model ProcessorApplication.ViewModels.User.ProfileViewModel
@{
    ViewData["Title"] = Model.IsAuditView ? "Audit View: " + Model.User.UserName : "Your Profile";
}

<form asp-controller="Profile" asp-action="Update" method="post" data-script-id="user-profile">
    <input type="hidden" asp-for="User.Id" />

    <div class="actions">
        @if (Model.IsAuditView)
        {
            <span class="badge warn"><i class="fa-solid fa-user-secret"></i> AUDIT VIEW</span> <span class="aux">viewing data via the master audit key</span>
        }
        else
        {
            <a href="/Main/Profile/Download?userName=@Model.User.UserName" class="btn sm"><i class="fa-solid fa-download"></i> Export Identity</a>
        }
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="msg ok"><i class="fa-solid fa-check-circle"></i> @TempData["StatusMessage"]</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="msg warn"></div>
    }

    <div class="grid">
        <div class="card">
            <h2>Personal & Identity</h2>
            <div class="body">
                <div class="f">
                    <label>Secure Username (Login ID) <span class="tip" tabindex="0" data-tip="Your unique, secure identity string. It can't be changed."></span></label>
                    <span class="mono">@Model.User.UserName</span>
                </div>
                <div class="f"><label asp-for="User.DisplayNickname">Display Nickname</label><input asp-for="User.DisplayNickname" /></div>
                <div class="f">
                    <label asp-for="User.Email">Email Address (optional) <span class="tip" tabindex="0" data-tip="Used for audit notifications; stored encrypted."></span></label>
                    <input asp-for="User.Email" type="email" />
                </div>
                <div class="cols">
                    <div class="f"><label asp-for="User.Name">Name</label><input asp-for="User.Name" /></div>
                    <div class="f"><label asp-for="User.Surname">Surname</label><input asp-for="User.Surname" /></div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Security Credentials <span class="tip" tabindex="0" data-tip="Leave these empty unless you want to change the password."></span></h2>
            <div class="body">
                @if (!Model.IsAuditView)
                {
                    <div class="f"><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="off" /></div>
                }
                <div class="cols">
                    <div class="f"><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /></div>
                    <div class="f"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /></div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>@(Model.CanEditRoles ? "Manage Access (Roles)" : "Assigned Roles")</h2>
            <div class="body">
                @if (Model.CanEditRoles)
                {
                    for (int i = 0; i < Model.RoleSelections.Count; i++)
                    {
                        <div class="f row">
                            <input type="hidden" asp-for="RoleSelections[i].RoleName" />
                            <input asp-for="RoleSelections[i].IsSelected" type="checkbox">
                            <label asp-for="RoleSelections[i].IsSelected">@Model.RoleSelections[i].RoleName</label>
                        </div>
                    }
                }
                else
                {
                    foreach (var role in Model.RoleSelections.Where(r => r.IsSelected))
                    {
                        <span class="badge ok">@role.RoleName</span>
                    }
                    if (!Model.RoleSelections.Any(r => r.IsSelected))
                    {
                        <span class="aux">No roles assigned.</span>
                    }
                }
                @if (!Model.IsAuditView)
                {
                    <div class="actions">
                        <button type="button" id="check-connectivity-btn" class="btn sm"><i class="fa-solid fa-wifi"></i> Check Email Connectivity</button>
                        <span class="tip" tabindex="0" data-tip="Checks that audit emails can be delivered."></span>
                    </div>
                    <div id="connectivity-result" class="is-hidden"></div>
                }
            </div>
        </div>
    </div>

    <div class="actions">
        <button type="submit" class="btn"><i class="fa-solid fa-save"></i> Save Changes</button>
    </div>
</form>

@section Scripts {
    <script src="~/js/pages/profile/index.js" asp-append-version="true"></script>
}
