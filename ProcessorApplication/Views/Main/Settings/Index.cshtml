@model SettingsViewModel
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using ProcessorApplication.Models
@using ProcessorApplication.ViewModels
@{
    ViewData["Title"] = "Main Module Configuration";
    var globalMessage = ViewData["GlobalMessage"] as string;
    var isSuccess = (ViewData["MessageType"] as string) == "Success";
}

<div id="settings-partial-wrapper" data-script-id="main-settings">
    <div id="global-messages">
        @if (!string.IsNullOrEmpty(globalMessage))
        {
            <div class="msg @(isSuccess ? "ok" : "warn")"><i class="fa-solid @(isSuccess ? "fa-check-circle" : "fa-circle-exclamation")"></i> @globalMessage</div>
        }
    </div>

    <div id="validation-messages" style="@(ViewData.ModelState.IsValid ? "display: none;" : "")">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="msg warn">
                <b><i class="fa-solid fa-triangle-exclamation"></i> Please correct the following errors:</b>
                <ul>
                    @foreach (var state in ViewData.ModelState.Values)
                    {
                        @foreach (var error in state.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
            </div>
        }
    </div>

    <form id="masterSettingsForm" asp-area="Main" asp-controller="Settings" asp-action="ProcessAllSettings" method="post">
        <div id="settings-tab-nav" class="actions">
            <button type="button" data-tab="security" class="btn tab-button on"><i class="fa-solid fa-shield-halved"></i> Security</button>
            <button type="button" data-tab="email" class="btn tab-button"><i class="fa-solid fa-square-envelope"></i> Email</button>
            <button type="button" data-tab="registering" class="btn tab-button"><i class="fa-solid fa-cash-register"></i> Registering</button>
        </div>

        <div id="tab-security" class="tab-content">
            <partial name="_SecurityTabPartial" model="Model.Security" view-data='new ViewDataDictionary(ViewData) { { "ModelPrefix", "Security" } }' />
        </div>
        <div id="tab-email" class="tab-content is-hidden">
            <partial name="_EmailTabPartial" model="Model.Email" view-data='new ViewDataDictionary(ViewData) { { "ModelPrefix", "Email" } }' />
        </div>
        <div id="tab-registering" class="tab-content is-hidden">
            <partial name="_RegisteringTabPartial" model="Model.Registering" view-data='new ViewDataDictionary(ViewData) { { "ModelPrefix", "Registering" } }' />
        </div>

        @Html.AntiForgeryToken()

        <div class="actions">
            <button type="submit" id="masterSaveButton" class="btn"><i class="fa-solid fa-save"></i> Save All</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/pages/settings/index.js" asp-append-version="true"></script>
}
