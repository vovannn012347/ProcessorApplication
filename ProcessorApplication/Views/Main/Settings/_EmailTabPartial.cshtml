@model EmailSettings
@using ProcessorApplication.Configuration.Settings
@using ProcessorApplication.Models.Settings
@{
    var prefix = ViewData["ModelPrefix"]?.ToString() ?? "Email";
    string Pfx(string prop) => $"{prefix}.{prop}";
    var modeGroupName = Pfx(nameof(Model.Mode));
}

<div class="card">
    <h2>General Configuration</h2>
    <div class="body grid">
        <div class="f"><label asp-for="Identity.Email"></label><input asp-for="Identity.Email" name="@Pfx("Identity.Email")" placeholder="system@example.com" /></div>
        <div class="f"><label asp-for="Identity.FromName"></label><input asp-for="Identity.FromName" name="@Pfx("Identity.FromName")" placeholder="My System Notifier" /></div>
        <div class="f"><label asp-for="Server.SmtpHost"></label><input asp-for="Server.SmtpHost" name="@Pfx("Server.SmtpHost")" placeholder="smtp.gmail.com" /></div>
        <div class="f"><label asp-for="Server.SmtpPort"></label><input asp-for="Server.SmtpPort" name="@Pfx("Server.SmtpPort")" type="number" /></div>
        <div class="f">
            <label>SSL/TLS Security Mode</label>
            <select name="@Pfx("Server.Security")">
                <option value="Auto" selected="@(Model.Server.Security == "Auto")">Auto</option>
                <option value="SslOnConnect" selected="@(Model.Server.Security == "SslOnConnect")">SSL / TLS (Implicit)</option>
                <option value="StartTls" selected="@(Model.Server.Security == "StartTls")">STARTTLS (Explicit)</option>
                <option value="None" selected="@(Model.Server.Security == "None")">None (Plaintext)</option>
            </select>
        </div>
        <div class="f">
            <div><label asp-for="HealthCheckPeriodMinutes"></label> <span class="tip" tabindex="0" data-tip="How often the mail connection is checked in the background, in minutes."></span></div>
            <input asp-for="HealthCheckPeriodMinutes" name="@Pfx(nameof(Model.HealthCheckPeriodMinutes))" type="number" min="1" />
        </div>
    </div>
</div>

<div class="card">
    <h2>Authentication Strategy <span class="tip" tabindex="0" data-tip="Select how the mail server is signed in to; only the selected method's fields are used."></span></h2>
    <div class="body grid">
        <div class="opt">
            <h3><input type="radio" name="@modeGroupName" value="@EmailAuthMode.PasswordAuth" id="mode_password" @(Model.Mode == EmailAuthMode.PasswordAuth ? "checked" : "") /> <label for="mode_password">Standard Password</label></h3>
            <div class="f"><label>Password</label><input type="password" name="@Pfx("Auth.PasswordAuth.Password")" value="@Model.Auth.PasswordAuth.Password" class="mono" /></div>
        </div>
        <div class="opt">
            <h3><input type="radio" name="@modeGroupName" value="@EmailAuthMode.AppPasswordAuth" id="mode_app_password" @(Model.Mode == EmailAuthMode.AppPasswordAuth ? "checked" : "") /> <label for="mode_app_password">App-Specific Password</label></h3>
            <div class="f"><label>Generated App Password <span class="tip" tabindex="0" data-tip="For Google/Microsoft accounts with 2FA enabled."></span></label><input type="password" name="@Pfx("Auth.AppPasswordAuth.AppPassword")" value="@Model.Auth.AppPasswordAuth.AppPassword" class="mono" /></div>
        </div>
        <div class="opt">
            <h3><input type="radio" name="@modeGroupName" value="@EmailAuthMode.OAuthAuth" id="mode_oauth" @(Model.Mode == EmailAuthMode.OAuthAuth ? "checked" : "") /> <label for="mode_oauth">OAuth 2.0</label></h3>
            <div class="f"><label>Access Token <span class="tip" tabindex="0" data-tip="Tokens change on every successful connection."></span></label><input type="text" name="@Pfx("Auth.OAuthAuth.AccessToken")" value="@Model.Auth.OAuthAuth.AccessToken" class="mono" /></div>
            <div class="f"><label>Refresh Token</label><input type="password" name="@Pfx("Auth.OAuthAuth.RefreshToken")" value="@Model.Auth.OAuthAuth.RefreshToken" class="mono" /></div>
            <div class="cols">
            <div class="f"><label>Expires At</label><input type="text" name="@Pfx("Auth.OAuthAuth.ExpiresAt")" value="@Model.Auth.OAuthAuth.ExpiresAt" class="mono" /></div>
            <div class="f"><label>Token Type</label><input type="text" name="@Pfx("Auth.OAuthAuth.TokenType")" value="@Model.Auth.OAuthAuth.TokenType" class="mono" /></div>
            </div>
        </div>
        <div class="opt">
            <h3><input type="radio" name="@modeGroupName" value="@EmailAuthMode.ApiKeyAuth" id="mode_apikey" @(Model.Mode == EmailAuthMode.ApiKeyAuth ? "checked" : "") /> <label for="mode_apikey">API Key</label></h3>
            <div class="f"><label>API Key / Secret <span class="tip" tabindex="0" data-tip="Often used with SendGrid, Mailgun and similar."></span></label><input type="password" name="@Pfx("Auth.ApiKeyAuth.ApiKey")" value="@Model.Auth.ApiKeyAuth.ApiKey" class="mono" /></div>
        </div>
        <div class="opt">
            <h3><input type="radio" name="@modeGroupName" value="@EmailAuthMode.ServiceAccountAuth" id="mode_service_account" @(Model.Mode == EmailAuthMode.ServiceAccountAuth ? "checked" : "") /> <label for="mode_service_account">Service Account</label></h3>
            <div class="f"><label>Service Account Key (JSON Path)</label><input type="text" name="@Pfx("Auth.ServiceAccountAuth.ServiceAccountKey")" value="@Model.Auth.ServiceAccountAuth.ServiceAccountKey" class="mono" /></div>
            <div class="f"><label>Delegated User Email</label><input type="text" name="@Pfx("Auth.ServiceAccountAuth.DelegatedUser")" value="@Model.Auth.ServiceAccountAuth.DelegatedUser" class="mono" /></div>
        </div>
        <div class="opt">
            <h3><input type="radio" name="@modeGroupName" value="@EmailAuthMode.CertificateAuth" id="mode_certificate" @(Model.Mode == EmailAuthMode.CertificateAuth ? "checked" : "") /> <label for="mode_certificate">Client Certificate</label></h3>
            <div class="f"><label>Certificate Path (.pfx)</label><input type="text" name="@Pfx("Auth.CertificateAuth.CertificatePath")" value="@Model.Auth.CertificateAuth.CertificatePath" class="mono" /></div>
            <div class="f"><label>Certificate Password</label><input type="password" name="@Pfx("Auth.CertificateAuth.CertificatePassword")" value="@Model.Auth.CertificateAuth.CertificatePassword" class="mono" /></div>
        </div>
    </div>
</div>
