@model RegisteringSettingsViewModel
@using System.Linq
@using ProcessorApplication.Configuration.Settings
@using ProcessorApplication.Models.Settings
@using ProcessorApplication.ViewModels
@{
    var prefix = ViewData["ModelPrefix"]?.ToString() ?? string.Empty;
}

<div class="card">
    <h2>Default Roles for New Users <span class="tip" tabindex="0" data-tip="Roles assigned automatically when a new user signs up."></span></h2>
    <div class="body">
        @if (Model.DefaultRolesSelection != null && Model.DefaultRolesSelection.Any())
        {
            for (int i = 0; i < Model.DefaultRolesSelection.Count; i++)
            {
                <div class="f row">
                    @* RoleName posted back so the binding keeps the role's identity; hidden "false" for an unchecked box *@
                    <input type="hidden" name="@(prefix).DefaultRolesSelection[@i].RoleName" value="@Model.DefaultRolesSelection[i].RoleName" />
                    <input type="hidden" name="@(prefix).DefaultRolesSelection[@i].IsSelected" value="false" />
                    <input type="checkbox" id="role_checkbox_@i" name="@(prefix).DefaultRolesSelection[@i].IsSelected" value="true"
                           @(Model.DefaultRolesSelection[i].IsSelected ? "checked" : "") />
                    <label for="role_checkbox_@i">@Model.DefaultRolesSelection[i].RoleName</label>
                </div>
            }
        }
        else
        {
            <div class="msg warn"><i class="fa-solid fa-triangle-exclamation"></i> No roles loaded from the system store. Make sure the database seed roles exist.</div>
        }
        <span asp-validation-for="DefaultRoles" class="warn-t"></span>
    </div>
</div>
