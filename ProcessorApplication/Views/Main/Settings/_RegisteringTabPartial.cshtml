        <div class="mm-flex">
            <div class="mm-flex-shrink-0 mm-text-gray-400">
                <i class="fa-solid fa-code-fork mm-text-lg"></i>
            </div>
            <div class="mm-ml-3">
                <h4 class="mm-text-xs mm-font-semibold mm-text-gray-600 mm-uppercase mm-tracking-wider">Planned Features</h4>
                <p class="mm-text-xs mm-text-gray-500 mm-mt-1">
                    Registration codes, organizational unit mappings, and automated API-token provisioning configurations will be displayed here in upcoming patches.
                </p>
            </div>
        </div>
    </div> *@
</div>