@model SecuritySettings
@using System.Linq
@using ProcessorApplication.Configuration.Settings
@using ProcessorApplication.Models.Settings
@{
    var prefix = ViewData["ModelPrefix"]?.ToString() ?? string.Empty;
}

<div class="card">
    <h2>Security</h2>
    <div class="body grid">
        <div class="f">
            <div><label asp-for="HashStampGenerationPeriod"></label> <span class="tip" tabindex="0" data-tip="How often a new cryptographic hash stamp is generated for data integrity, in hours (minimum 0.01)."></span></div>
            <div class="f row">
                <input type="number" name="@(prefix).HashStampGenerationPeriod" id="HashStampGenerationPeriod"
                       value="@Model.HashStampGenerationPeriod.ToString("0.##")" min="0.01" step="0.01" placeholder="0.00" style="width:90px;text-align:right" />
                <span class="aux">hours</span>
            </div>
            <span asp-validation-for="HashStampGenerationPeriod" class="warn-t"></span>
        </div>
        <div>
            <div class="f row">
                <input type="hidden" name="@(prefix).HashStampBackupEnabled" value="false" />
                <input asp-for="HashStampBackupEnabled" name="@(prefix).HashStampBackupEnabled" type="checkbox" />
                <label asp-for="HashStampBackupEnabled"></label> <span class="tip" tabindex="0" data-tip="Back up the forensic hash stamps to the path below."></span>
            </div>
            <div class="f">
                <div><label asp-for="HashStampBackupFilePath"></label> <span class="tip" tabindex="0" data-tip="Absolute path where integrity hash backups are stored."></span></div>
                <input asp-for="HashStampBackupFilePath" name="@(prefix).HashStampBackupFilePath" type="text" class="mono" />
                <span asp-validation-for="HashStampBackupFilePath" class="warn-t"></span>
            </div>
        </div>
        <div>
            <div class="f row">
                <input type="hidden" name="@(prefix).RecordDecipherLogging" value="false" />
                <input asp-for="RecordDecipherLogging" name="@(prefix).RecordDecipherLogging" type="checkbox" />
                <label asp-for="RecordDecipherLogging"></label> <span class="tip" tabindex="0" data-tip="Log every access to sensitive encrypted data, for audit."></span>
            </div>
            <div class="f">
                <div><label asp-for="RecordDecipherLogPath"></label> <span class="tip" tabindex="0" data-tip="Absolute path where the daily sensitive-access logs are stored."></span></div>
                <input asp-for="RecordDecipherLogPath" name="@(prefix).RecordDecipherLogPath" type="text" class="mono" />
                <span asp-validation-for="RecordDecipherLogPath" class="warn-t"></span>
            </div>
        </div>
    </div>
</div>
