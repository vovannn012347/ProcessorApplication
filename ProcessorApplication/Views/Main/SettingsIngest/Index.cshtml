@model ProcessorApplication.Controllers.SettingsIngestViewModel
@using ProcessorApplication.Configuration.SettingsIngest
@{
    ViewData["Title"] = "Settings Files";
    var preview = Model.Preview;
    // ingest status per setting: a list's status applies to all of its items
    SettingsIngestDifference? DiffOf(StoredSettingRow r) => preview.Differences.FirstOrDefault(d =>
        string.Equals(d.Area, r.Area, StringComparison.OrdinalIgnoreCase)
        && (string.Equals(d.Key, r.Key, StringComparison.OrdinalIgnoreCase) || r.Key.StartsWith(d.Key + ":", StringComparison.OrdinalIgnoreCase)));
    (string Text, string Css) StatusOf(SettingsIngestStatus s) => s switch
    {
        SettingsIngestStatus.ChangedInFile => ("file changed", "info"),
        SettingsIngestStatus.ChangedInApp => ("app changed", "warn-t"),
        _ => ("untracked", "aux")
    };
    string? lastArea = null, lastSection = null;
}

<div id="settings-ingest-wrapper" data-script-id="main-settings-ingest">
    @Html.AntiForgeryToken()
    <div id="st-msg"></div>

    @if (Model.LastApply != null)
    {
        var ok = Model.LastApply.Errors.Count == 0;
        <div class="msg @(ok ? "ok" : "warn")">
            @(Model.LastApply.AppliedCount) setting(s) applied from files (@(Model.LastApply.Mode + (Model.LastApply.AreaFilter != null ? ", " + Model.LastApply.AreaFilter : ""))).
            @foreach (var e in Model.LastApply.Errors) { <div>@e</div> }
        </div>
    }
    @foreach (var e in preview.Errors)
    {
        <div class="msg warn">@e</div>
    }

    <div class="actions">
        <input id="st-filter" type="search" placeholder="Filter: module, key or value" style="width:260px" />
        <form class="ingest-form" method="post" asp-area="Main" asp-controller="SettingsIngest" asp-action="Apply">
            <input type="hidden" name="mode" value="@SettingsIngestMode.Changed" />
            <button type="submit" class="btn"><i class="fa-solid fa-file-import"></i> Apply file changes</button>
        </form>
        <form class="ingest-form" method="post" asp-area="Main" asp-controller="SettingsIngest" asp-action="Apply"
              data-confirm="Replace every stored value that differs from the settings files, in all modules? Values changed in the app are lost.">
            <input type="hidden" name="mode" value="@SettingsIngestMode.Overwrite" />
            <button type="submit" class="btn"><i class="fa-solid fa-arrows-rotate"></i> Overwrite from files</button>
        </form>
        <span class="aux">startup mode: <span class="mono">@(Model.StartupMode?.ToString() ?? "?")</span>
            <span class="tip" tabindex="0" data-tip="What happens with the settings files at startup: Changed applies values edited in a file since the last run, Overwrite applies all differing file values, Off uses files only for keys the database doesn't have yet. Set SettingsIngest:Mode in appsettings.json, or --SettingsIngest:Mode=Overwrite on the command line."></span></span>
    </div>

    <table class="t" id="st-table">
        <thead>
            <tr>
                <th>Setting <span class="tip" tabindex="0" data-tip="Grouped by module, then by section. 'file changed': edited in a file since the last run (Apply file changes takes it). 'app changed': changed in the app, the file still has the old value. 'untracked': differs and no earlier run recorded the file value. Only Overwrite from files replaces the last two."></span></th>
                <th style="width:40%">Stored value <span class="tip" tabindex="0" data-tip="The value the node uses. Edit and press Enter (or Save): it takes effect immediately. Hidden values (passwords, tokens, secrets) are never shown: type a new one to replace it."></span></th>
                <th style="width:28%">File value <span class="tip" tabindex="0" data-tip="Value in the settings files (appsettings.*.json, the node's own files override the shared ones). Used when nothing is stored."></span></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr class="st-add">
                <td>
                    <select name="area">
                        @foreach (var a in Model.Areas) { <option value="@a">@a</option> }
                    </select>
                    <input name="key" class="mono" placeholder="Section:Name" style="width:calc(100% - 110px)" />
                </td>
                <td><input name="value" placeholder="value" /></td>
                <td class="aux">new setting</td>
                <td><button type="button" class="btn sm st-addbtn"><i class="fa-solid fa-plus"></i> Add</button></td>
            </tr>

            @foreach (var r in Model.Rows)
            {
                if (!string.Equals(r.Area, lastArea, StringComparison.OrdinalIgnoreCase))
                {
                    lastArea = r.Area; lastSection = null;
                    <tr class="grp" data-area="@r.Area">
                        <th colspan="4">
                            @r.Area
                            <form class="ingest-form" method="post" asp-area="Main" asp-controller="SettingsIngest" asp-action="Apply" style="display:inline">
                                <input type="hidden" name="mode" value="@SettingsIngestMode.Changed" />
                                <input type="hidden" name="area" value="@r.Area" />
                                <button type="submit" class="btn sm">Apply file changes</button>
                            </form>
                            <form class="ingest-form" method="post" asp-area="Main" asp-controller="SettingsIngest" asp-action="Apply" style="display:inline"
                                  data-confirm="Replace every stored @r.Area value that differs from its settings files?">
                                <input type="hidden" name="mode" value="@SettingsIngestMode.Overwrite" />
                                <input type="hidden" name="area" value="@r.Area" />
                                <button type="submit" class="btn sm">Overwrite from files</button>
                            </form>
                        </th>
                    </tr>
                }
                if (!string.Equals(r.Section, lastSection, StringComparison.OrdinalIgnoreCase))
                {
                    lastSection = r.Section;
                    <tr class="sub" data-area="@r.Area" data-section="@r.Section"><td colspan="4">@r.Section</td></tr>
                }
                var diff = DiffOf(r);
                var name = r.Key.Length > r.Section.Length ? r.Key.Substring(r.Section.Length + 1) : r.Key;
                <tr class="st-row" data-area="@r.Area" data-section="@r.Section" data-key="@r.Key" data-sensitive="@(r.IsSensitive ? "1" : "0")">
                    <td class="mono wrap" style="padding-left:16px">@name
                        @if (diff != null) { var st = StatusOf(diff.Status); <span class="@st.Css" style="font-size:10px">@st.Text</span> }
                    </td>
                    <td>
                        @if (r.IsListMarker)
                        {
                            <span class="aux">list kept in the database</span>
                        }
                        else if (r.IsSensitive)
                        {
                            <input class="st-val mono" type="password" value="" data-orig="" autocomplete="new-password"
                                   placeholder="@(r.IsStored && !string.IsNullOrEmpty(r.StoredValue) ? "•••• hidden, type to replace" : "(not stored)")" />
                        }
                        else
                        {
                            <input class="st-val mono" value="@(r.StoredValue ?? "")" data-orig="@(r.StoredValue ?? "")" placeholder="@(r.IsStored ? "(empty)" : "(not stored)")" />
                        }
                    </td>
                    <td class="mono wrap aux">@(!r.InFile ? "-" : r.IsSensitive ? (string.IsNullOrEmpty(r.FileValue) ? "(empty)" : "•••• hidden") : (r.FileValue == "" ? "(empty)" : r.FileValue))</td>
                    <td class="nowrap">
                        <button type="button" class="btn sm st-save is-hidden" title="Save (Enter)"><i class="fa-solid fa-check"></i></button>
                        @if (r.IsStored)
                        {
                            <button type="button" class="btn sm st-del" title="Delete the stored value (the file value applies again)"><i class="fa-solid fa-xmark"></i></button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/pages/settings-ingest/index.js" asp-append-version="true"></script>
}
