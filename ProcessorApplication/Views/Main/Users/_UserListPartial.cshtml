@using ProcessorApplication.Models.User
@model PagedUserListViewModel
@{
    ViewData["Title"] = "User Administration";
}

<div id="user-list-container">
    <div class="aux">@Model.Users.Count users shown, @Model.TotalCount in total</div>
    <table class="t">
        <thead>
            <tr><th>Name / Nickname</th><th>User ID</th><th>Status</th><th style="text-align:right">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Users)
            {
                <tr>
                    <td>@user.Name.Truncate(20) @user.Surname.Truncate(30) <span class="aux">@user.DisplayNickname</span></td>
                    <td class="mono">@user.UserName</td>
                    <td>@if (user.IsLockedOut) { <span class="badge bad">Locked</span> } else { <span class="badge ok">Active</span> }</td>
                    <td class="nowrap" style="text-align:right">
                        <a href="/Main/Profile/Index?userName=@user.UserName" class="icon-btn ajax-link" title="Profile"><i class="fa-solid fa-user-shield"></i></a>
                        <button data-user-id="@user.UserName" data-action="@(user.IsLockedOut ? "unlock" : "lockout")" class="icon-btn action-btn" title="@(user.IsLockedOut ? "Unlock" : "Lock out")">
                            <i class="fa-solid @(user.IsLockedOut ? "fa-unlock" : "fa-lock")"></i>
                        </button>
                        <button type="button" data-user-id="@user.UserName" class="icon-btn bad action-btn" data-action="delete" title="Delete"><i class="fa-solid fa-trash"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
