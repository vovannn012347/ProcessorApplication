@model EmailSettings
@using ProcessorApplication.Configuration.Settings
@using ProcessorApplication.Models.Settings

@{
    var prefix = ViewData["ModelPrefix"]?.ToString() ?? "Email";
    string Pfx(string prop) => $"{prefix}.{prop}";
    var modeGroupName = Pfx(nameof(Model.Mode));
}

<div class="mm-space-y-8">

    <div class="mm-bg-white mm-rounded-lg mm-border mm-border-gray-200 mm-p-6 mm-shadow-sm">
        <h3 class="mm-text-lg mm-font-medium mm-leading-6 mm-text-gray-900 mm-border-b mm-pb-2 mm-mb-4">General Configuration</h3>

        <div class="mm-grid mm-grid-cols-1 mm-gap-y-6 mm-gap-x-4 sm:mm-grid-cols-6">
            <div class="sm:mm-col-span-3">
                <label asp-for="Identity.Email" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
                <div class="mm-mt-1 mm-relative mm-rounded-md mm-shadow-sm">
                    <div class="mm-absolute mm-inset-y-0 mm-left-0 mm-pl-3 mm-flex mm-items-center mm-pointer-events-none">
                        <svg class="mm-h-5 mm-w-5 mm-text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" /></svg>
                    </div>
                    <input asp-for="Identity.Email" name="@Pfx(nameof(Model.Identity.Email))" class="focus:mm-ring-indigo-500 focus:mm-border-indigo-500 mm-block mm-w-full mm-pl-10 sm:mm-text-sm mm-border-gray-300 mm-rounded-md" placeholder="system@example.com" />
                </div>
            </div>

            <div class="sm:mm-col-span-3">
                <label asp-for="Identity.FromName" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
                <input asp-for="Identity.FromName" name="@Pfx("Identity.FromName")" class="mm-mt-1 focus:mm-ring-indigo-500 focus:mm-border-indigo-500 mm-block mm-w-full sm:mm-text-sm mm-border-gray-300 mm-rounded-md" placeholder="My System Notifier" />
            </div>

            <div class="sm:mm-col-span-4">
                <label asp-for="Server.SmtpHost" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
                <input asp-for="Server.SmtpHost" name="@Pfx("Server.SmtpHost")" class="mm-mt-1 focus:mm-ring-indigo-500 focus:mm-border-indigo-500 mm-block mm-w-full sm:mm-text-sm mm-border-gray-300 mm-rounded-md" placeholder="smtp.gmail.com" />
            </div>

            <div class="sm:mm-col-span-2">
                <label asp-for="Server.SmtpPort" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
                <input asp-for="Server.SmtpPort" name="@Pfx("Server.SmtpPort")" type="number" class="mm-mt-1 focus:mm-ring-indigo-500 focus:mm-border-indigo-500 mm-block mm-w-full sm:mm-text-sm mm-border-gray-300 mm-rounded-md" />
            </div>

            <div class="sm:mm-col-span-3 mm-flex mm-items-center mm-h-full mm-pt-4">
                <input asp-for="Server.UseSsl" name="@Pfx("Server.UseSsl")" type="checkbox" class="mm-h-4 mm-w-4 mm-text-indigo-600 focus:mm-ring-indigo-500 mm-border-gray-300 mm-rounded" />
                <label asp-for="Server.UseSsl" class="mm-ml-2 mm-block mm-text-sm mm-text-gray-900"></label>
            </div>

            <div class="sm:mm-col-span-3">
                <label asp-for="HealthCheckPeriodMinutes" class="mm-block mm-text-sm mm-font-medium mm-text-gray-700"></label>
                <div class="mm-mt-1 mm-relative mm-rounded-md mm-shadow-sm">
                    <input asp-for="HealthCheckPeriodMinutes" name="@Pfx(nameof(Model.HealthCheckPeriodMinutes))" type="number" min="1" class="focus:mm-ring-indigo-500 focus:mm-border-indigo-500 mm-block mm-w-full mm-pr-12 sm:mm-text-sm mm-border-gray-300 mm-rounded-md" />
                    <div class="mm-absolute mm-inset-y-0 mm-right-0 mm-pr-3 mm-flex mm-items-center mm-pointer-events-none">
                        <span class="mm-text-gray-500 sm:mm-text-sm">min</span>
                    </div>
                </div>
                <p class="mm-mt-1 mm-text-xs mm-text-gray-500">Frequency of background connectivity pings.</p>
            </div>
        </div>
    </div>

    <div>
        <h3 class="mm-text-lg mm-font-medium mm-leading-6 mm-text-gray-900 mm-mb-4">Authentication Strategy</h3>
        <div class="mm-space-y-4">

            <div class="mm-relative">
                <input type="radio" name="@modeGroupName" value="@EmailAuthMode.PasswordAuth" id="mode_password" class="mm-hidden-radio-selector" @(Model.Mode == EmailAuthMode.PasswordAuth ? "checked" : "") />
                <div class="settings-card mm-rounded-lg mm-p-4 mm-border mm-transition-all mm-bg-gray-50">
                    <label for="mode_password" class="settings-card-header mm-cursor-pointer mm-flex mm-justify-between mm-items-center mm-select-none">
                        <div class="mm-flex mm-items-center">
                            <span class="mm-font-bold mm-text-gray-800 mm-text-sm mm-uppercase mm-tracking-wide">Standard Password</span>
                        </div>
                        <span class="indicator-icon mm-text-gray-400"><svg class="mm-w-6 mm-h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg></span>
                    </label>
                    <div class="mm-mt-4 mm-border-t mm-pt-3">
                        <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Password</label>
                        <input type="password" name="@Pfx("Auth.PasswordAuth.Password")" value="@Model.Auth.PasswordAuth.Password" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm" />
                    </div>
                </div>
            </div>

            <div class="mm-relative">
                <input type="radio" name="@modeGroupName" value="@EmailAuthMode.AppPasswordAuth" id="mode_app_password" class="mm-hidden-radio-selector" @(Model.Mode == EmailAuthMode.AppPasswordAuth ? "checked" : "") />
                <div class="settings-card mm-rounded-lg mm-p-4 mm-border mm-transition-all mm-bg-gray-50">
                    <label for="mode_app_password" class="settings-card-header mm-cursor-pointer mm-flex mm-justify-between mm-items-center mm-select-none">
                        <span class="mm-font-bold mm-text-gray-800 mm-text-sm mm-uppercase mm-tracking-wide">App-Specific Password</span>
                        <span class="indicator-icon mm-text-gray-400"><svg class="mm-w-6 mm-h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg></span>
                    </label>
                    <div class="mm-mt-4 mm-border-t mm-pt-3">
                        <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Generated App Password</label>
                        <input type="password" name="@Pfx("Auth.AppPasswordAuth.AppPassword")" value="@Model.Auth.AppPasswordAuth.AppPassword" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm" />
                        <p class="mm-mt-1 mm-text-xs mm-text-gray-500">For Google/Microsoft accounts with 2FA enabled.</p>
                    </div>
                </div>
            </div>

            <div class="mm-relative">
                <input type="radio" name="@modeGroupName" value="@EmailAuthMode.OAuthAuth" id="mode_oauth" class="mm-hidden-radio-selector" @(Model.Mode == EmailAuthMode.OAuthAuth ? "checked" : "") />
                <div class="settings-card mm-rounded-lg mm-p-4 mm-border mm-transition-all mm-bg-gray-50">
                    <label for="mode_oauth" class="settings-card-header mm-cursor-pointer mm-flex mm-justify-between mm-items-center mm-select-none">
                        <span class="mm-font-bold mm-text-gray-800 mm-text-sm mm-uppercase mm-tracking-wide">OAuth 2.0</span>
                        <span class="indicator-icon mm-text-gray-400"><svg class="mm-w-6 mm-h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg></span>
                    </label>
                    <div class="mm-mt-4 mm-border-t mm-pt-3 mm-grid mm-grid-cols-1 mm-gap-4">
                        <div>
                            <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Access Token</label>
                            <input type="text" name="@Pfx("Auth.OAuthAuth.AccessToken")" value="@Model.Auth.OAuthAuth.AccessToken" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-font-mono" />
                        </div>
                        <div>
                            <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Refresh Token</label>
                            <input type="password" name="@Pfx("Auth.OAuthAuth.RefreshToken")" value="@Model.Auth.OAuthAuth.RefreshToken" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-font-mono" />
                        </div>
                        <p class="mm-mt-1 mm-text-xs mm-text-gray-500">Tokens do change on successful connection.</p>
                        <div class="mm-flex mm-space-x-4">
                            <div class="mm-w-1/2">
                                <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Expires At</label>
                                <input type="text" name="@Pfx("Auth.OAuthAuth.ExpiresAt")" value="@Model.Auth.OAuthAuth.ExpiresAt" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm" />
                            </div>
                            <div class="mm-w-1/2">
                                <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Token Type</label>
                                <input type="text" name="@Pfx("Auth.OAuthAuth.TokenType")" value="@Model.Auth.OAuthAuth.TokenType" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mm-relative">
                <input type="radio" name="@modeGroupName" value="@EmailAuthMode.ApiKeyAuth" id="mode_apikey" class="mm-hidden-radio-selector" @(Model.Mode == EmailAuthMode.ApiKeyAuth ? "checked" : "") />
                <div class="settings-card mm-rounded-lg mm-p-4 mm-border mm-transition-all mm-bg-gray-50">
                    <label for="mode_apikey" class="settings-card-header mm-cursor-pointer mm-flex mm-justify-between mm-items-center mm-select-none">
                        <span class="mm-font-bold mm-text-gray-800 mm-text-sm mm-uppercase mm-tracking-wide">API Key</span>
                        <span class="indicator-icon mm-text-gray-400"><svg class="mm-w-6 mm-h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg></span>
                    </label>
                    <div class="mm-mt-4 mm-border-t mm-pt-3">
                        <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">API Key / Secret</label>
                        <input type="password" name="@Pfx("Auth.ApiKeyAuth.ApiKey")" value="@Model.Auth.ApiKeyAuth.ApiKey" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-font-mono" />
                        <p class="mm-mt-1 mm-text-xs mm-text-gray-500">Often used with SendGrid, Mailgun, etc.</p>
                    </div>
                </div>
            </div>

            <div class="mm-relative">
                <input type="radio" name="@modeGroupName" value="@EmailAuthMode.ServiceAccountAuth" id="mode_service_account" class="mm-hidden-radio-selector" @(Model.Mode == EmailAuthMode.ServiceAccountAuth ? "checked" : "") />
                <div class="settings-card mm-rounded-lg mm-p-4 mm-border mm-transition-all mm-bg-gray-50">
                    <label for="mode_service_account" class="settings-card-header mm-cursor-pointer mm-flex mm-justify-between mm-items-center mm-select-none">
                        <span class="mm-font-bold mm-text-gray-800 mm-text-sm mm-uppercase mm-tracking-wide">Service Account</span>
                        <span class="indicator-icon mm-text-gray-400"><svg class="mm-w-6 mm-h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg></span>
                    </label>
                    <div class="mm-mt-4 mm-border-t mm-pt-3 mm-grid mm-grid-cols-1 mm-gap-4">
                        <div>
                            <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Service Account Key (JSON Path)</label>
                            <input type="text" name="@Pfx("Auth.ServiceAccountAuth.ServiceAccountKey")" value="@Model.Auth.ServiceAccountAuth.ServiceAccountKey" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-font-mono" />
                        </div>
                        <div>
                            <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Delegated User Email</label>
                            <input type="text" name="@Pfx("Auth.ServiceAccountAuth.DelegatedUser")" value="@Model.Auth.ServiceAccountAuth.DelegatedUser" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="mm-relative">
                <input type="radio" name="@modeGroupName" value="@EmailAuthMode.CertificateAuth" id="mode_certificate" class="mm-hidden-radio-selector" @(Model.Mode == EmailAuthMode.CertificateAuth ? "checked" : "") />
                <div class="settings-card mm-rounded-lg mm-p-4 mm-border mm-transition-all mm-bg-gray-50">
                    <label for="mode_certificate" class="settings-card-header mm-cursor-pointer mm-flex mm-justify-between mm-items-center mm-select-none">
                        <span class="mm-font-bold mm-text-gray-800 mm-text-sm mm-uppercase mm-tracking-wide">Client Certificate</span>
                        <span class="indicator-icon mm-text-gray-400"><svg class="mm-w-6 mm-h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg></span>
                    </label>
                    <div class="mm-mt-4 mm-border-t mm-pt-3 mm-grid mm-grid-cols-1 mm-gap-4">
                        <div>
                            <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Certificate Path (.pfx)</label>
                            <input type="text" name="@Pfx("Auth.CertificateAuth.CertificatePath")" value="@Model.Auth.CertificateAuth.CertificatePath" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm mm-font-mono" />
                        </div>
                        <div>
                            <label class="mm-block mm-text-xs mm-font-medium mm-text-gray-500 mm-uppercase">Certificate Password</label>
                            <input type="password" name="@Pfx("Auth.CertificateAuth.CertificatePassword")" value="@Model.Auth.CertificateAuth.CertificatePassword" class="mm-mt-1 mm-block mm-w-full mm-rounded-md mm-border-gray-300 mm-shadow-sm focus:mm-border-indigo-500 focus:mm-ring-indigo-500 sm:mm-text-sm" />
                        </div>
                    </div>
                </div>
            </div>

            @* 
            <div class="relative">
                <input type="radio" name="@modeGroupName" value="@EmailAuthMode.KeyPairAuth" id="mode_keypair" class="hidden-radio-selector" @(Model.Mode == EmailAuthMode.KeyPairAuth ? "checked" : "") />
                <div class="settings-card rounded-lg p-4 border transition-all bg-gray-50">
                    <label for="mode_keypair" class="settings-card-header cursor-pointer flex justify-between items-center select-none">
                        <span class="font-bold text-gray-800 text-sm uppercase tracking-wide">Custom Key Pair</span>
                        <span class="indicator-icon text-gray-400"><svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg></span>
                    </label>
                    <div class="mt-4 border-t pt-3 grid grid-cols-1 gap-4">
                        <div>
                            <label class="block text-xs font-medium text-gray-500 uppercase">Private Key Path</label>
                            <input type="text" name="@Pfx("Auth.KeyPairAuth.PrivateKeyPath")" value="@Model.Auth.KeyPairAuth.PrivateKeyPath" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm font-mono" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-gray-500 uppercase">Key Password (Optional)</label>
                            <input type="password" name="@Pfx("Auth.KeyPairAuth.PrivateKeyPassword")" value="@Model.Auth.KeyPairAuth.PrivateKeyPassword" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                        </div>
                    </div>
                </div>
            </div> *@
        </div>
    </div>
</div>