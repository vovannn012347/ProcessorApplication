@model ProcessorApplication.Models.View.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="msg warn">An error occurred while processing your request.</div>
@if (Model.ShowRequestId)
{
    <div class="f"><span class="aux">Request ID</span><span class="mono">@Model.RequestId</span></div>
}
<div class="aux">The Development environment shows more detail.</div>
