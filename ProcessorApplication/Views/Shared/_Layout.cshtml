<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t && t.Length > 0 ? t + " - " : "")ProcessorApplication</title>
    <link rel="stylesheet" href="~/css/ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @Html.AntiForgeryToken()

    @* Navigation templates, filled by _layout.js *@
    <template id="tpl-nav-desktop"><a href="#" class="module-nav-link"></a></template>
    <template id="tpl-nav-mobile"><a href="#" class="module-nav-link"><i class="fa-solid fa-cube"></i><span class="label"></span></a></template>

    <div id="app-container" class="app">
        <div id="sidebar-backdrop"></div>

        <aside id="sidebar" class="side sidebar-hidden-mobile">
            @* Current page name: wraps onto new lines instead of widening the sidebar. Pages do not show their own header. *@
            <div class="side-head">
                <span id="page-title">@ViewData["Title"]</span>
                <button id="sidebar-close-btn" class="mob-only" style="background:none;border:0;color:inherit;cursor:pointer"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <nav class="sidebar-nav">
                <div class="mob-only" id="mobile-module-section">
                    <span class="side-cap">Switch Module</span>
                    <div id="mobile-module-nav-container"></div>
                </div>
                <span class="side-cap">Navigation</span>
                <div id="contextual-menu-container"></div>
            </nav>
        </aside>

        <div id="content-wrapper" class="work">
            <header class="topbar main-navbar">
                <div>
                    <button id="sidebar-open-btn" class="mob-only"><i class="fa-solid fa-bars-staggered"></i></button>
                    <button id="sidebar-toggle-btn" class="desk-only"><i id="sidebar-toggle-icon" class="fa-solid fa-angles-left"></i></button>
                    <div class="desk-only" id="desktop-module-nav-container"></div>
                </div>
                <div>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="user-menu" id="user-menu-container">
                            <button type="button" id="user-menu-button">
                                <i class="fa-solid fa-user"></i> @User.Identity.Name <i class="fa-solid fa-chevron-down" id="user-dropdown-arrow" style="font-size:9px"></i>
                            </button>
                            <div id="user-dropdown" class="menu is-hidden">
                                <a href="/Main/Profile/Index"><i class="fa-solid fa-user-gear"></i> Profile</a>
                                <form asp-area="Main" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit"><i class="fa-solid fa-power-off"></i> Logout</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </header>

            <main>
                <div id="content-container">
                    @RenderBody()
                </div>
                <div id="content-loader" class="is-hidden"><div id="mm-content-loader-spinner"></div></div>
            </main>
        </div>
    </div>

    <script src="/js/shared/_layout.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
