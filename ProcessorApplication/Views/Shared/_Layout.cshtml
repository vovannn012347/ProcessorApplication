<!DOCTYPE html>
<html lang="en" class="h-full bg-gray-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProcessorApplication</title>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
</head>
<body class="h-full font-sans text-gray-900">
    @Html.AntiForgeryToken()

    @* Navigation Templates: These keep styles in HTML rather than JS strings *@
    <template id="tpl-nav-desktop">
        <a href="#" class="module-nav-link px-4 py-2 rounded-xl text-[11px] font-black uppercase tracking-tight text-gray-500 hover:bg-gray-100 hover:text-indigo-600 transition-all"></a>
    </template>

    <template id="tpl-nav-mobile">
        <a href="#" class="module-nav-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold text-gray-400 hover:bg-gray-700/50 hover:text-white transition-all">
            <i class="fa-solid fa-cube w-5 text-center"></i>
            <span class="label"></span>
        </a>
    </template>

    <div id="app-container" class="flex h-full overflow-hidden">

        <!-- Sidebar Backdrop (Mobile only) -->
        <div id="sidebar-backdrop"></div>

        <!-- Sidebar -->
        <aside id="sidebar" class="z-50 flex h-full w-64 flex-col bg-gray-800 shadow-xl md:relative md:flex-shrink-0 md:transform-none">
            <div class="flex h-16 shrink-0 items-center justify-between px-5 bg-gray-900 border-b border-white/5">
                <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></div>
                    <span class="text-sm font-black text-white uppercase tracking-widest">Core Engine</span>
                </div>
                <button id="sidebar-close-btn" class="text-gray-400 hover:text-white md:hidden">
                    <i class="fa-solid fa-xmark fa-lg"></i>
                </button>
            </div>

            <nav class="sidebar-nav flex-1 space-y-6 overflow-y-auto p-4">
                <!-- Mobile Modules (Hidden on Desktop) -->
                <div class="md:hidden" id="mobile-module-section">
                    <span class="px-3 text-[10px] font-black uppercase text-gray-500 tracking-widest">Switch Module</span>
                    <div class="mt-3 space-y-1" id="mobile-module-nav-container"></div>
                </div>

                <!-- Contextual Menu -->
                <div class="space-y-1">
                    <span class="px-3 text-[10px] font-black uppercase text-gray-500 tracking-widest">Navigation</span>
                    <div class="mt-3 space-y-1" id="contextual-menu-container">
                        <div class="px-3 py-10 flex flex-col items-center gap-3 opacity-20">
                            <i class="fa-solid fa-layer-group text-2xl text-gray-400"></i>
                            <span class="text-[10px] font-bold text-gray-500 uppercase tracking-widest">Initialize...</span>
                        </div>
                    </div>
                </div>
            </nav>

            <div class="p-4 bg-gray-900/50 border-t border-white/5">
                <div class="flex items-center gap-3 px-2">
                    <div class="w-8 h-8 rounded-lg bg-gray-700 flex items-center justify-center text-xs font-black text-gray-300">ND</div>
                    <div class="flex flex-col">
                        <span class="text-[10px] font-black text-white uppercase truncate w-32">Local Node</span>
                        <span class="text-[8px] font-bold text-indigo-400 uppercase tracking-tighter">Status: Optimal</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Workspace -->
        <div id="content-wrapper" class="flex-1 flex flex-col min-w-0 bg-white">
            <header class="main-navbar sticky top-0 z-40 flex h-16 w-full shrink-0 items-center justify-between border-b border-gray-200 bg-white px-4 md:px-6">
                <div class="flex items-center space-x-4">
                    <button id="sidebar-open-btn" class="p-2 text-gray-500 hover:text-indigo-600 md:hidden">
                        <i class="fa-solid fa-bars-staggered fa-lg"></i>
                    </button>
                    <button id="sidebar-toggle-btn" class="hidden p-2 text-gray-400 hover:text-indigo-600 md:block">
                        <i id="sidebar-toggle-icon" class="fa-solid fa-angles-left"></i>
                    </button>

                    <!-- Desktop Module Nav -->
                    <div class="hidden md:flex md:items-center md:space-x-1" id="desktop-module-nav-container"></div>
                </div>

                <div class="flex items-center space-x-4">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="relative" id="user-menu-container">
                            <button type="button" class="group flex items-center gap-3 p-1 rounded-full hover:bg-gray-50 transition-all" id="user-menu-button">
                                <div class="h-8 w-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-black text-xs shadow-lg shadow-indigo-200">
                                    @User.Identity.Name?[0].ToString().ToUpper()
                                </div>
                                <div class="hidden md:flex flex-col items-start leading-none text-left">
                                    <span class="text-xs font-black text-gray-800 uppercase">@User.Identity.Name</span>
                                    <span class="text-[9px] font-bold text-gray-400 uppercase tracking-tighter">Authorized</span>
                                </div>
                                <i class="fa-solid fa-chevron-down text-[10px] text-gray-300 transition-transform" id="user-dropdown-arrow"></i>
                            </button>
                            <div id="user-dropdown" class="hidden absolute right-0 mt-3 w-56 origin-top-right rounded-2xl bg-white p-2 shadow-2xl ring-1 ring-black/5 z-50">
                                <div class="px-3 py-2 border-b border-gray-50 mb-1">
                                    <p class="text-[10px] font-black text-gray-400 uppercase">Identity</p>
                                    <p class="text-xs font-bold text-indigo-600 truncate">@User.Identity.Name</p>
                                </div>
                                <a href="/Main/Profile/Index" class="flex items-center gap-3 px-3 py-2 text-xs font-bold text-gray-600 hover:bg-indigo-50 hover:text-indigo-700 rounded-xl transition-all">
                                    <i class="fa-solid fa-user-gear"></i> Profile
                                </a>
                                <div class="my-1 border-t border-gray-50"></div>
                                <form asp-area="Main" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="flex w-full items-center gap-3 px-3 py-2 text-xs font-bold text-red-600 hover:bg-red-50 rounded-xl transition-all">
                                        <i class="fa-solid fa-power-off"></i> Logout
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </header>

            <main class="flex-1 overflow-y-auto relative">
                <div id="content-container" class="p-6 md:p-10 max-w-7xl mx-auto">
                    @RenderBody()
                </div>

                <div id="content-loader" class="hidden absolute inset-0 z-50 bg-white/60 backdrop-blur-sm flex items-center justify-center">
                    <div class="flex flex-col items-center gap-4">
                        <div class="relative h-10 w-10">
                            <div class="absolute inset-0 rounded-full border-4 border-indigo-100"></div>
                            <div class="absolute inset-0 rounded-full border-4 border-indigo-600 border-t-transparent animate-spin"></div>
                        </div>
                        <span class="text-[9px] font-black text-indigo-600 uppercase tracking-[0.3em]">Synching...</span>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const container = document.getElementById('app-container');
            const loader = document.getElementById('content-loader');
            const contextualMenu = document.getElementById('contextual-menu-container');

            // --- Behavior: Single Key Class for Mobile Toggle ---
            document.getElementById('sidebar-open-btn').onclick = () => container.classList.add('sidebar-open');
            document.getElementById('sidebar-close-btn').onclick = () => container.classList.remove('sidebar-open');
            document.getElementById('sidebar-backdrop').onclick = () => container.classList.remove('sidebar-open');

            // --- Behavior: Desktop Sidebar Toggle ---
            document.getElementById('sidebar-toggle-btn').onclick = () => {
                const isCol = container.classList.toggle('sidebar-collapsed');
                document.getElementById('sidebar-toggle-icon').className = isCol ? 'fa-solid fa-angles-right' : 'fa-solid fa-angles-left';
            };

            function loadContent(url, target, callback) {
                if (target.id === 'content-container') loader.classList.remove('hidden');
                fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                .then(res => res.status === 401 ? window.location.reload() : res.text())
                .then(html => {
                    if (target.id === 'content-container') loader.classList.add('hidden');
                    target.innerHTML = html;

                    // Re-execute scripts
                    target.querySelectorAll('script').forEach(s => {
                        const ns = document.createElement('script');
                        if (s.src) ns.src = s.src; else ns.textContent = s.textContent;
                        document.head.appendChild(ns);
                        if (!s.src) ns.remove();
                    });

                    if (callback) callback();
                    if (window.innerWidth < 768 && target.id === 'content-container') container.classList.remove('sidebar-open');
                });
            }

            function buildModuleNav(modules) {
                const desk = document.getElementById('desktop-module-nav-container');
                const mob = document.getElementById('mobile-module-nav-container');
                const tplDesk = document.getElementById('tpl-nav-desktop');
                const tplMob = document.getElementById('tpl-nav-mobile');

                // Determine active module from URL to prevent "disappearing" menus on deep link
                const currentPath = window.location.pathname.toLowerCase();
                let activeId = modules[0]?.moduleId || 'main';

                modules.forEach(m => {
                    if (currentPath.includes(m.moduleId.toLowerCase())) activeId = m.moduleId;

                    // Desktop
                    const dNode = tplDesk.content.cloneNode(true).querySelector('a');
                    dNode.textContent = m.name;
                    dNode.dataset.mid = m.moduleId;
                    dNode.onclick = (e) => { e.preventDefault(); switchModule(m.moduleId); };
                    desk.appendChild(dNode);

                    // Mobile
                    const mNode = tplMob.content.cloneNode(true).querySelector('a');
                    mNode.querySelector('.label').textContent = m.name;
                    mNode.dataset.mid = m.moduleId;
                    mNode.onclick = (e) => { e.preventDefault(); switchModule(m.moduleId); };
                    mob.appendChild(mNode);
                });

                switchModule(activeId, true);
            }

            function switchModule(id, isInitial = false) {
                document.querySelectorAll('.module-nav-link').forEach(l => {
                    const isActive = l.dataset.mid === id;
                    const isM = l.closest('#mobile-module-nav-container') !== null;

                    if (isM) {
                        l.classList.toggle('bg-indigo-600', isActive);
                        l.classList.toggle('text-white', isActive);
                    } else {
                        l.classList.toggle('bg-indigo-50', isActive);
                        l.classList.toggle('text-indigo-700', isActive);
                    }
                });

                if (!isInitial) {
                    loadContent(`/Navigation/GetModuleMenu?moduleId=${id}`, contextualMenu);
                } else {
                    // Force load menu if deep linking
                    loadContent(`/Navigation/GetModuleMenu?moduleId=${id}`, contextualMenu);
                }
            }

            // Init App
            fetch('/Navigation/GetModules')
                .then(res => res.json())
                .then(buildModuleNav);

            window.loadContent = (url) => loadContent(url, document.getElementById('content-container'));

            // User Menu
            const uBtn = document.getElementById('user-menu-button');
            const uDrop = document.getElementById('user-dropdown');
            const uArr = document.getElementById('user-dropdown-arrow');
            if (uBtn) uBtn.onclick = (e) => {
                e.stopPropagation();
                const hid = uDrop.classList.toggle('hidden');
                if (uArr) uArr.style.transform = hid ? 'rotate(0deg)' : 'rotate(180deg)';
            };
            window.onclick = () => { uDrop?.classList.add('hidden'); if (uArr) uArr.style.transform = 'rotate(0deg)'; };
        });
    </script>
</body>
</html>