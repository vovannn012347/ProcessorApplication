<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProcessorApplication</title>
    <link rel="stylesheet" href="~/css/ui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />
</head>
<body>
    <div class="topbar"><div style="padding:0 6px;font-weight:700;text-transform:uppercase;letter-spacing:.05em">@ViewData["Title"]</div><div class="aux" style="color:inherit;padding:0 6px">ProcessorApplication</div></div>
    <div class="narrow card">
        <div class="body">
            @RenderBody()
        </div>
    </div>
    <script src="/js/shared/_layout.js" asp-append-version="true"></script>
</body>
</html>
