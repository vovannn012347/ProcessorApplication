@using Common.Interfaces.Menu
@model List<MenuItemViewModel>

@if (Model == null || !Model.Any())
{
    <span class="side-cap">No menu items available.</span>
    return;
}

@foreach (var item in Model)
{
    <a href="@item.Url" class="nav-link-sidebar"><i class="@item.IconClass"></i>@item.Name</a>
}