@using Common.Interfaces.Menu
@model List<MenuItemViewModel>

@if (Model == null || !Model.Any())
{
    <p class="mm-px-3 mm-py-2 mm-text-sm mm-text-gray-400">No menu items available.</p>
    return;
}

@foreach (var item in Model)
{
    <a href="@item.Url"
       class="nav-link-sidebar ajax-link mm-group mm-flex mm-items-center mm-rounded-md mm-px-3 mm-py-2 mm-text-sm mm-font-medium mm-text-gray-300 hover:mm-bg-gray-700 hover:mm-text-white">
        <i class="@item.IconClass mm-mr-3 mm-h-5 mm-w-5 mm-shrink-0"></i>
        @item.Name
    </a>
}