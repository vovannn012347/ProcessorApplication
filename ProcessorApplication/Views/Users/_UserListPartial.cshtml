@using ProcessorApplication.Models.User
@model PagedUserListViewModel

<div id="user-list-container">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">User Administration</h1>

    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
        <div class="p-4 border-b border-gray-200">
            <p class="text-sm text-gray-700">Displaying @Model.Users.Count users (Total: @Model.TotalCount)</p>
        </div>

        <!-- User Table -->
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name / Nickname</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">User Identifier ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-gray-900">@user.Name.Truncate(20) @user.Surname.Truncate(30)</div>
                                <div class="text-xs text-gray-500">@user.DisplayNickname</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-mono text-gray-600">
                                @user.UserName
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm">
                                @if (user.IsLockedOut)
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Locked</span>
                                }
                                else
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Active</span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">

                                <!-- View/Audit Profile -->
                                <a href="/Main/Profile/Index?userName=@user.UserName" class="inline-flex items-center text-indigo-600 hover:text-indigo-900 ajax-link">
                                    <i class="fa-solid fa-user-shield" title="View Profile (Audit Logged)"></i>
                                </a>

                                <!-- Reset Password (Placeholder) -->
                                @* <button type="button" data-user-id="@user.Id" class="text-yellow-600 hover:text-yellow-900 action-btn" data-action="reset">
                                    <i class="fa-solid fa-key" title="Reset Password"></i>
                                </button> *@

                                <!-- Lockout User -->
                                @* @if (!user.IsLockedOut)
                                {
                                    <button type="button" data-user-id="@user.Id" class="text-orange-600 hover:text-orange-900 action-btn" data-action="lockout">
                                        <i class="fa-solid fa-lock" title="Lockout User"></i>
                                    </button>
                                } *@
                                @if (user.IsLockedOut)
                                {
                                    <!-- Currently Locked Out: Offer Unlock -->
                                    <button data-user-id="@user.UserName" data-action="unlock" class="action-btn text-green-600 hover:text-green-800">
                                        <i class="fa-solid fa-unlock" title="Unlock"></i>
                                    </button>
                                }
                                else
                                {
                                    <!-- Currently Active: Offer Lockout -->
                                    <button data-user-id="@user.UserName" data-action="lockout" class="action-btn text-red-600 hover:text-red-800">
                                        <i class="fa-solid fa-lock" title="Lockout"></i>
                                    </button>
                                }

                                <!-- Delete User -->
                                <button type="button" data-user-id="@user.UserName" class="text-red-600 hover:text-red-900 action-btn" data-action="delete">
                                    <i class="fa-solid fa-trash" title="Delete User"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        <div class="p-4 flex items-center justify-between border-t border-gray-200 bg-gray-50">
            <div>
                <p class="text-sm text-gray-700">Page @Model.PageNumber of @Model.TotalPages (Total: @Model.TotalCount)</p>
            </div>
            <div>
                @if (Model.PageNumber > 1)
                {
                    <a href="/Main/Users/Index?pageNumber=@(Model.PageNumber - 1)&pageSize=@Model.PageSize"
                       class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-100 ajax-link">
                        Previous
                    </a>
                }
                @if (Model.PageNumber < Model.TotalPages)
                {
                    <a href="/Main/Users/Index?pageNumber=@(Model.PageNumber + 1)&pageSize=@Model.PageSize"
                       class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-100 ajax-link">
                        Next
                    </a>
                }
            </div>
        </div>
    </div>

    <script>
        function showCustomConfirm(message) {
            if (message.includes('delete')) {
                return window.confirm(message);
            }
            return true;
        }

        function initializeUserActions() {
            console.error('User action script initialized.');

            document.querySelectorAll('.action-btn').forEach(button => {
                button.addEventListener('click', function() {
                    const button = this;
                    const userName = button.dataset.userId;
                    const action = button.dataset.action;

                    let url;
                    let bodyData;

                    if (action === 'delete') {
                        if (!showCustomConfirm('WARNING: Are you sure you want to permanently delete this user? This cannot be undone.')) return;

                        url = '/Main/Users/Delete';
                        bodyData = JSON.stringify({ UserName: userName });
                    } else if (action === 'lockout' || action === 'unlock') {
                        url = '/Main/Users/SetLockout';
                        const isLocked = action === 'lockout';
                        bodyData = JSON.stringify({
                            UserName: userName,
                            IsLocked: isLocked
                        });
                    } else {
                        console.error('Unknown action:', action);
                        return;
                    }

                    // Show loading indicator
                    const originalHtml = button.innerHTML;
                    button.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i>';
                    button.disabled = true;

                    // Perform AJAX action post
                    fetch(url, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                        },
                        body: bodyData
                    })
                    .then(response => {
                        if (!response.ok) {
                            if (response.status === 403) {
                                throw new Error('Session Expired');
                            }
                            throw new Error(response.statusText || 'Network error');
                        }
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {
                            const currentPathAndQuery = window.location.pathname + window.location.search;
                            // Reload the current view content, preserving the page number/filters
                            if (typeof loadContent === 'function') {
                               loadContent(currentPathAndQuery, 'content-container');
                            } else {
                                window.location.reload();
                            }
                        } else {
                            alert(`Action failed: ${data.message}`);
                        }
                    })
                    .catch(error => {
                        console.error('Error during admin action:', error);
                        if (error.message !== 'Session Expired') {
                            alert('An error occurred. Check console.');
                            button.innerHTML = originalHtml;
                            button.disabled = false;
                        }
                    });
                });
            });
        }

        // safe Initialization (The "Stateless Observer")
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeUserActions);
        } else {
            initializeUserActions();
        }
    </script>
</div>