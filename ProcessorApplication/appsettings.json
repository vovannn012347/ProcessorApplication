{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Features": {
    "ForceHttpsRedirection" : false
  },
  // Module settings files -> settings DB at startup.
  // "Off": files only fill keys the DB doesn't have yet (old behaviour).
  // "Changed": also apply values changed in a settings file since the last start; values changed on settings pages are kept.
  // "Overwrite": settings files win for every value they contain.
  // Override per run: --SettingsIngest:Mode=Overwrite (command line) or SettingsIngest__Mode=Overwrite (environment).
  // Admin page: /Main/SettingsIngest/Index
  "SettingsIngest": {
    "Mode": "Changed"
  }
}
